# Nafaa API base, including the /api prefix. Server-side only.
NAFAA_API_URL=http://localhost:4000/api
# Shops live at <slug>.<STORE_ROOT_DOMAIN>. Custom domains resolve through the API.
STORE_ROOT_DOMAIN=stores.nafaa.pk
# Shared secret for POST /api/revalidate (the API calls it when products, prices, stock or the theme change).
REVALIDATE_SECRET=change-me
# 1 = serve the four demo shops from built-in sample data (no API needed).
STOREFRONT_MOCK=0
# Optional: slug used on plain localhost when no ?store= is given.
STORE_DEV_DEFAULT=
