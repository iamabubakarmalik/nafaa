<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Verify your email — Nafaa Bazaar</title>
</head>
<body style="font-family: -apple-system, Segoe UI, sans-serif; background: #f8fafc; margin: 0; padding: 40px 20px; color: #0f172a;">
  <div style="max-width: 560px; margin: 0 auto; background: white; border-radius: 24px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08);">
    <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); padding: 32px; text-align: center; color: white;">
      <div style="font-size: 32px; font-weight: 900; margin-bottom: 8px;">N</div>
      <h1 style="margin: 0; font-size: 24px; font-weight: 900;">Verify your email</h1>
      <p style="margin: 8px 0 0; opacity: 0.9; font-size: 14px;">One-tap verification</p>
    </div>

    <div style="padding: 32px;">
      <p style="font-size: 16px; line-height: 1.6;">Hey <strong>{{name}}</strong>,</p>
      <p style="font-size: 15px; line-height: 1.6; color: #475569;">
        Thanks for joining Nafaa Bazaar 🇵🇰! Please verify your email address to unlock all features.
      </p>

      <div style="text-align: center; margin: 32px 0;">
        <div style="display: inline-block; padding: 20px 40px; background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border: 2px dashed #10b981; border-radius: 16px;">
          <div style="font-size: 12px; font-weight: 700; color: #059669; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px;">Your code</div>
          <div style="font-size: 42px; font-weight: 900; color: #047857; letter-spacing: 8px; font-family: monospace;">{{code}}</div>
        </div>
      </div>

      <p style="text-align: center; margin: 24px 0;">
        <a href="{{verifyUrl}}" style="display: inline-block; padding: 14px 32px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; text-decoration: none; border-radius: 12px; font-weight: 800; font-size: 15px;">
          Verify email now
        </a>
      </p>

      <p style="font-size: 13px; color: #64748b; text-align: center;">
        Code expires in 10 minutes. If you didn't request this, please ignore.
      </p>
    </div>

    <div style="background: #f8fafc; padding: 20px 32px; text-align: center; font-size: 12px; color: #94a3b8;">
      © 2026 Nafaa Bazaar · Made with 💚 in Pakistan
    </div>
  </div>
</body>
</html>
