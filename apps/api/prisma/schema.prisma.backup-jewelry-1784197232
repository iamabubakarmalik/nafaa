// ─────────────────────────────────────────────────────────────
// Individual installment payments
// ─────────────────────────────────────────────────────────────
model GarmentLayawayInstallment {
  id     String @id @default(uuid())
  planId String

  installmentNo Int
  dueDate       DateTime
  amount        Float
  paidAmount    Float    @default(0)

  status        GarmentPaymentStatus @default(UNPAID)
  paidAt        DateTime?
  paymentMethod String?
  reference     String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan GarmentLayawayPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, installmentNo])
  @@index([planId])
  @@index([dueDate])
  @@index([status])
}

