// ─── Agri Product Extension ───
model AgriProductProfile {
  id        String @id @default(uuid())
  tenantId  String
  productId String @unique

  category    AgriCategory
  subCategory String?

  seedType       SeedType?
  fertilizerType FertilizerType?
  feedType       FeedType?

  brand           String?
  manufacturer    String?
  countryOfOrigin String?

  // Composition
  npkRatio         String?
  activeIngredient String?
  ingredients      Json?
  concentration    String?

  // Packaging
  packSize   String?
  packUnit   String?
  bagsPerTon Int?

  // Application
  applicationRate     String?
  applicationMethod   String?
  applicationInterval String?
  targetCrops         String[] @default([])
  targetPests         String[] @default([])
  targetAnimals       String[] @default([])

  // Season & Crop
  season      SeasonType?
  suitableFor String[]    @default([])
  cropStage   String?

  // Safety
  toxicityLevel String?
  ppePeriod     Int?
  reEntryPeriod Int?
  warningLabel  String?
  hazardClass   String?

  // Certifications
  isOrganic         Boolean   @default(false)
  organicCertNumber String?
  govtRegNumber     String?
  govtRegExpiry     DateTime?

  // Storage
  shelfLifeMonths     Int?
  storageTemp         String?
  storageInstructions String?

  // Stock alerts
  reorderLevel  Float?
  minStockAlert Float?

  // Farmer discount (bulk)
  bulkDiscountThreshold Float?
  bulkDiscountPct       Float?

  // Rich content
  imageUrls         String[] @default([])
  descriptionLong   String?  @db.Text
  usageInstructions String?  @db.Text
  precautions       String?  @db.Text
  firstAid          String?  @db.Text
  msdsUrl           String?
  brochureUrl       String?
  videoUrl          String?

  isPopular       Boolean @default(false)
  isFeatured      Boolean @default(false)
  isBestSeller    Boolean @default(false)
  isSeasonal      Boolean @default(false)
  isRestricted    Boolean @default(false)
  requiresLicense Boolean @default(false)

  totalSold    Float @default(0)
  totalRevenue Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, seedType])
  @@index([tenantId, fertilizerType])
}

// ─── Farmer Registration ───
model AgriFarmer {
  id         String  @id @default(uuid())
  tenantId   String
  customerId String? @unique

  farmerNumber String
  fullName     String
  fatherName   String?
  cnic         String?
  phone        String
  altPhone     String?

  // Location
  village  String?
  tehsil   String?
  district String?
  province String?
  address  String? @db.Text
  landmark String?

  // Farm details
  landAreaAcres  Float?
  landAreaKanals Float?
  landOwnership  String?
  soilType       String?
  waterSource    String?
  irrigationType String?

  // Farming type
  farmingType  String[] @default([])
  primaryCrops String[] @default([])
  livestock    Json?

  // Documents
  cnicFrontUrl String?
  cnicBackUrl  String?
  landDocUrl   String?
  photoUrl     String?

  // Financial
  creditLimit    Float @default(0)
  currentBalance Float @default(0)
  creditDays     Int   @default(60)
  interestRate   Float @default(0)

  // Season tracking
  currentSeason SeasonType?
  currentCrop   String?

  // Stats
  totalOrders      Int       @default(0)
  totalPurchases   Float     @default(0)
  totalOutstanding Float     @default(0)
  totalPaid        Float     @default(0)
  lastPurchaseAt   DateTime?

  status           FarmerAccountStatus @default(ACTIVE)
  registeredAt     DateTime            @default(now())
  suspendedAt      DateTime?
  suspensionReason String?

  notes    String? @db.Text
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, farmerNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([cnic])
}

// ─── Farmer Credit / Udhar Book ───
model AgriFarmerLedger {
  id       String @id @default(uuid())
  tenantId String
  farmerId String

  entryNumber String
  entryDate   DateTime @default(now())
  entryType   String

  description String
  reference   String?

  debit   Float @default(0)
  credit  Float @default(0)
  balance Float @default(0)

  saleId    String?
  paymentId String?

  createdById String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
  @@index([farmerId])
  @@index([entryDate])
}

// ─── Bulk Order (for large farmers) ───
model AgriBulkOrder {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  orderNumber   String
  farmerId      String?
  customerId    String?
  customerName  String?
  customerPhone String?

  orderDate    DateTime        @default(now())
  deliveryDate DateTime?
  status       AgriOrderStatus @default(DRAFT)

  season        SeasonType?
  cropTarget    String?
  landAreaAcres Float?

  isDelivery      Boolean @default(false)
  deliveryAddress String? @db.Text
  deliveryCharges Float   @default(0)
  transportType   String?
  vehicleNumber   String?

  subtotal      Float     @default(0)
  bulkDiscount  Float     @default(0)
  taxAmount     Float     @default(0)
  otherCharges  Float     @default(0)
  total         Float     @default(0)
  paidAmount    Float     @default(0)
  paymentStatus String    @default("UNPAID")
  paymentMethod String?
  isCredit      Boolean   @default(false)
  creditDueDate DateTime?

  advisorNotes       String? @db.Text
  farmerNotes        String? @db.Text
  cancellationReason String?

  createdById String?
  deliveredBy String?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items AgriBulkOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([farmerId])
}

model AgriBulkOrderItem {
  id      String @id @default(uuid())
  orderId String

  productId   String?
  productName String
  category    AgriCategory?

  quantity     Float
  unit         String
  pricePerUnit Float
  discount     Float  @default(0)
  total        Float  @default(0)

  batchNumber String?
  expiryDate  DateTime?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  order AgriBulkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── Crop Advisory / Recommendations ───
model AgriCropAdvisory {
  id       String @id @default(uuid())
  tenantId String

  advisoryNumber String
  farmerId       String?
  advisorId      String?
  advisorName    String?

  cropName      String
  cropVariety   String?
  season        SeasonType?
  landAreaAcres Float?
  stage         String?

  sowingDate      DateTime?
  expectedHarvest DateTime?

  currentIssues   String? @db.Text
  soilTestResult  Json?
  waterTestResult Json?

  recommendations    Json?
  productSuggestions Json?

  followUpDate DateTime?
  completed    Boolean   @default(false)

  notes          String?  @db.Text
  attachmentUrls String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, advisoryNumber])
  @@index([tenantId])
  @@index([farmerId])
}

// ─── Seasonal Calendar / Crop Schedule ───
model AgriSeasonalPlan {
  id       String @id @default(uuid())
  tenantId String

  season   SeasonType
  year     Int
  cropName String

  sowingStart  DateTime
  sowingEnd    DateTime
  harvestStart DateTime
  harvestEnd   DateTime

  recommendedProducts Json?
  applicationSchedule Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, season, year, cropName])
  @@index([tenantId, year])
}

// ─── Government Subsidy Tracking ───
model AgriSubsidyClaim {
  id       String @id @default(uuid())
  tenantId String
  farmerId String

  claimNumber String
  schemeName  String
  govtScheme  String?

  productType   String
  quantity      Float
  originalPrice Float
  subsidyAmount Float
  finalPrice    Float

  farmerCnic    String?
  cropTarget    String?
  landAreaAcres Float?

  documentsSubmitted String[]  @default([])
  approvedBy         String?
  approvalDate       DateTime?
  disbursementDate   DateTime?

  status          String  @default("PENDING")
  rejectionReason String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, claimNumber])
  @@index([tenantId])
  @@index([farmerId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// INDUSTRY: DAIRY / MILK SHOP
// Daily delivery, monthly khata, farmers, quality tests
// ═══════════════════════════════════════════════════════════════

enum DairyProductType {
  FRESH_MILK
  BUFFALO_MILK
  COW_MILK
  GOAT_MILK
  MIXED_MILK
  BOILED_MILK
  RAW_MILK
  YOGURT
  DAHI
  LASSI
  BUTTER_MILK
  BUTTER
  MAKHAN
  DESI_GHEE
  CREAM
  MALAI
  KHOA
  MAWA
  PANEER
  CHEESE
  KHEER
  RABRI
  KULFI
  SWEETS
  ICE_CREAM
  MILK_POWDER
  OTHER
}

enum DairyUnit {
  LITER
  KG
  GRAM
  PIECE
  PLATE
  CUP
  BOTTLE
  PACKET
  KATTA
  KILO
  MAAN
  SEER
}

enum DairyMilkQuality {
  A_GRADE
  B_GRADE
  C_GRADE
  REJECTED
}

enum DairyDeliveryFrequency {
  DAILY
  ALTERNATE_DAY
  WEEKLY
  ON_DEMAND
  MORNING_ONLY
  EVENING_ONLY
  MORNING_EVENING
}

enum DairyDeliverySlot {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum DairyRouteStatus {
  ACTIVE
  PAUSED
  DISCONTINUED
}

enum DairyKhataStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  DEFAULTED
}

enum DairyBillingCycle {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum DairyDeliveryStatus {
  SCHEDULED
  DELIVERED
  SKIPPED
  MISSED
  RETURNED
  CANCELLED
}

// ─── Dairy Product Profile ───
model DairyProduct {
  id        String @id @default(uuid())
  tenantId  String
  productId String @unique

  productType DairyProductType @default(FRESH_MILK)
  unit        DairyUnit        @default(LITER)

  // Milk-specific
  fatContent     Float?
  snfContent     Float?
  proteinContent Float?
  waterAdded     Boolean           @default(false)
  quality        DairyMilkQuality?
  isPasteurized  Boolean           @default(false)
  isHomogenized  Boolean           @default(false)
  isRaw          Boolean           @default(false)
  isOrganic      Boolean           @default(false)

  // Freshness
  isFresh               Boolean   @default(true)
  productionDate        DateTime?
  bestBeforeHours       Int?
  shelfLifeHours        Int?
  requiresRefrigeration Boolean   @default(true)
  storageTempMin        Float?
  storageTempMax        Float?

  // Farm source
  farmSource String?
  cattleType String?

  // Pricing tiers
  morningPrice      Float?
  eveningPrice      Float?
  bulkPrice         Float?
  minBulkQty        Float?
  wholesalePrice    Float?
  retailPrice       Float?
  homeDeliveryPrice Float?

  // Delivery
  availableMorning      Boolean @default(true)
  availableEvening      Boolean @default(true)
  homeDeliveryAvailable Boolean @default(true)

  // Marketing
  isFeatured   Boolean @default(false)
  isBestSeller Boolean @default(false)
  displayOrder Int     @default(0)

  totalSold    Float @default(0)
  totalRevenue Float @default(0)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, productType])
}

// ─── Farmers / Milk Suppliers (Dodhi/Gawala) ───
model DairyFarmer {
  id       String @id @default(uuid())
  tenantId String

  farmerNumber String
  name         String
  fatherName   String?
  cnic         String?
  phone        String?
  address      String? @db.Text
  village      String?
  city         String?

  // Farm details
  cattleCount         Int?
  buffaloCount        Int?
  cowCount            Int?
  goatCount           Int?
  totalCapacityLiters Float?

  // Payment
  ratePerLiter Float             @default(0)
  fatBonusRate Float             @default(0)
  paymentCycle DairyBillingCycle @default(WEEKLY)

  // Balances
  currentBalance Float @default(0)
  totalSupplied  Float @default(0)
  totalPaid      Float @default(0)

  // Quality
  avgFatContent Float?
  avgSnfContent Float?
  qualityRating Float?

  // Contact
  lastSupplyDate  DateTime?
  lastPaymentDate DateTime?

  photoUrl     String?
  cnicFrontUrl String?
  cnicBackUrl  String?
  notes        String? @db.Text
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplies DairyFarmerSupply[]

  @@unique([tenantId, farmerNumber])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ─── Daily Farmer Supply Records ───
model DairyFarmerSupply {
  id       String @id @default(uuid())
  tenantId String
  farmerId String

  supplyDate DateTime          @default(now())
  slot       DairyDeliverySlot @default(MORNING)

  quantity Float
  unit     DairyUnit @default(LITER)

  fatContent Float?
  snfContent Float?
  quality    DairyMilkQuality?

  ratePerLiter    Float
  fatBonus        Float @default(0)
  otherAdjustment Float @default(0)
  totalAmount     Float

  isPaid Boolean   @default(false)
  paidAt DateTime?

  receivedByStaffId String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer DairyFarmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([farmerId])
  @@index([supplyDate])
}

// ─── Delivery Routes ───
model DairyRoute {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  routeNumber String
  name        String
  description String?

  assignedStaffId String?
  vehicleType     String?
  vehicleNumber   String?

  slot   DairyDeliverySlot @default(MORNING)
  status DairyRouteStatus  @default(ACTIVE)

  totalCustomers   Int   @default(0)
  totalDailyLiters Float @default(0)

  startTime            String?
  estimatedDurationMin Int?

  areaName String?
  color    String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers DairyCustomer[]

  @@unique([tenantId, routeNumber])
  @@index([tenantId])
}

// ─── Regular Customers (with subscriptions) ───
model DairyCustomer {
  id         String  @id @default(uuid())
  tenantId   String
  customerId String? @unique
  routeId    String?

  customerNumber String
  name           String
  phone          String?
  cnic           String?
  address        String? @db.Text
  city           String?
  area           String?
  landmark       String?
  latitude       Float?
  longitude      Float?

  // Delivery
  deliveryFrequency DairyDeliveryFrequency @default(DAILY)
  morningQuantity   Float                  @default(0)
  eveningQuantity   Float                  @default(0)
  productPreference String?
  containerType     String?

  // Pricing
  customRate   Float?
  billingCycle DairyBillingCycle @default(MONTHLY)

  // Balances
  currentBalance Float @default(0)
  totalPurchases Float @default(0)
  totalPayments  Float @default(0)
  advancePayment Float @default(0)

  // Metrics
  totalDeliveries  Int       @default(0)
  missedDeliveries Int       @default(0)
  lastDeliveryDate DateTime?
  lastPaymentDate  DateTime?

  status     DairyKhataStatus @default(ACTIVE)
  startDate  DateTime         @default(now())
  pausedFrom DateTime?
  pausedTo   DateTime?

  notes    String? @db.Text
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route      DairyRoute?     @relation(fields: [routeId], references: [id])
  deliveries DairyDelivery[]

  @@unique([tenantId, customerNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([routeId])
}

// ─── Daily Delivery Records ───
model DairyDelivery {
  id       String @id @default(uuid())
  tenantId String

  dairyCustomerId String
  routeId         String?

  deliveryDate DateTime          @default(now())
  slot         DairyDeliverySlot @default(MORNING)

  scheduledQty Float
  deliveredQty Float
  returnedQty  Float     @default(0)
  unit         DairyUnit @default(LITER)

  status     DairyDeliveryStatus @default(SCHEDULED)
  skipReason String?

  ratePerLiter Float
  totalAmount  Float

  isPaid     Boolean @default(false)
  paidAmount Float   @default(0)

  deliveredByStaffId String?
  containerReturned  Boolean @default(false)

  deliveredAt       DateTime?
  notes             String?
  customerSignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer DairyCustomer @relation(fields: [dairyCustomerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dairyCustomerId])
  @@index([deliveryDate])
  @@index([tenantId, status])
}

// ─── Monthly Bills / Khata ───
model DairyMonthlyBill {
  id              String @id @default(uuid())
  tenantId        String
  dairyCustomerId String

  billNumber     String
  month          Int
  year           Int
  cycleStartDate DateTime
  cycleEndDate   DateTime

  totalLiters     Float @default(0)
  totalDeliveries Int   @default(0)
  totalAmount     Float @default(0)
  discount        Float @default(0)
  paidAmount      Float @default(0)
  remainingAmount Float @default(0)

  openingBalance Float @default(0)
  closingBalance Float @default(0)

  isPaid           Boolean   @default(false)
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?

  isPrinted      Boolean   @default(false)
  sentToCustomer Boolean   @default(false)
  sentAt         DateTime?

  notes       String?
  handledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, billNumber])
  @@unique([dairyCustomerId, month, year])
  @@index([tenantId])
  @@index([dairyCustomerId])
}

// ─── Quality Tests ───
model DairyQualityTest {
  id       String @id @default(uuid())
  tenantId String

  testNumber String
  testedAt   DateTime @default(now())

  sourceType String
  sourceId   String?
  sourceName String?

  fatContent           Float?
  snfContent           Float?
  proteinContent       Float?
  lactoseContent       Float?
  waterContent         Float?
  phLevel              Float?
  temperature          Float?
  adulterationDetected Boolean  @default(false)
  adulterationTypes    String[] @default([])

  quality     DairyMilkQuality?
  passed      Boolean           @default(true)
  actionTaken String?

  testedByStaffId String?
  testMethod      String?
  notes           String?  @db.Text
  imageUrls       String[] @default([])

  createdAt DateTime @default(now())

  @@unique([tenantId, testNumber])
  @@index([tenantId])
  @@index([testedAt])
}
