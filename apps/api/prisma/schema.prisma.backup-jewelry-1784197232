// ═══════════════════════════════════════════════════════════════
// INDUSTRY: RESTAURANT / FOOD & BAKERY / CAFE
// Full feature set — Menu, Modifiers, Tables, KOT, Delivery, Recipes
// ═══════════════════════════════════════════════════════════════

enum RestaurantOrderMode {
  DINE_IN
  TAKEAWAY
  DELIVERY
  DRIVE_THRU
  ROOM_SERVICE
  PICKUP
}

enum RestaurantOrderStatus {
  DRAFT // Order being built
  PLACED // Sent to kitchen
  CONFIRMED // Kitchen accepted
  COOKING // In preparation
  READY // Ready to serve/pickup
  SERVED // Delivered to table
  OUT_FOR_DELIVERY // Rider picked up
  DELIVERED // Customer received
  COMPLETED // Paid + closed
  CANCELLED
  ON_HOLD
}

enum RestaurantTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

enum DietaryTag {
  VEGETARIAN
  VEGAN
  HALAL
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  SPICY
  CONTAINS_EGG
  CONTAINS_SEAFOOD
  BEEF
  CHICKEN
  MUTTON
}

enum ModifierType {
  ADDON // Extra cheese, add bacon
  VARIATION // Size: small/medium/large
  REMOVAL // No onion, no garlic
  SPICE_LEVEL // Mild/medium/hot
  COOKING_STYLE // Well done, medium rare
  NOTE // Free-text customer note
}

enum RiderStatus {
  ACTIVE
  BUSY
  OFFLINE
  ON_BREAK
  INACTIVE
}

enum RiderDeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  ARRIVED
  DELIVERED
  FAILED
  RETURNED
}

enum KotStatus {
  PENDING
  PRINTED
  ACKNOWLEDGED
  COOKING
  READY
  SERVED
  CANCELLED
}

// ─── Menu Item Extension (adds restaurant fields to Product) ───
model RestaurantMenuItem {
  id        String @id @default(uuid())
  tenantId  String
  productId String @unique

  prepTimeMinutes     Int? // Kitchen prep time
  cookingInstructions String?      @db.Text
  chefSpecial         Boolean      @default(false)
  bestSeller          Boolean      @default(false)
  isSpicy             Boolean      @default(false)
  spiceLevel          SpiceLevel?
  calories            Int?
  servingSize         String? // "1 plate", "500ml", "6 pieces"
  servesPeople        Int?         @default(1)
  dietaryTags         DietaryTag[] @default([])
  allergenInfo        String?      @db.Text
  displayOrder        Int          @default(0)
  isAvailable         Boolean      @default(true)
  availableFrom       String? // "07:00" HH:mm - breakfast only
  availableTo         String? // "11:00"
  availableDays       Int[]        @default([]) // 0=Sun, 1=Mon...

  // Marketing
  imageUrl       String?
  videoUrl       String?
  highlightColor String? // For UI badge
  tagLine        String? // "Chef's Choice", "New!"

  // Stats
  totalOrdered Int    @default(0)
  avgRating    Float?
  totalReviews Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers MenuItemModifier[]
  recipe    Recipe?

  @@index([tenantId])
  @@index([tenantId, isAvailable])
  @@index([tenantId, bestSeller])
  @@index([tenantId, chefSpecial])
}

// ─── Modifier Groups (e.g. "Choose Size", "Extra Toppings") ───
model ModifierGroup {
  id       String @id @default(uuid())
  tenantId String

  name          String // "Size", "Toppings", "Spice Level"
  description   String?
  type          ModifierType @default(ADDON)
  isRequired    Boolean      @default(false)
  minSelections Int          @default(0)
  maxSelections Int          @default(1)
  displayOrder  Int          @default(0)
  isActive      Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options   ModifierOption[]
  menuItems MenuItemModifier[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ─── Individual modifier options ───
model ModifierOption {
  id              String @id @default(uuid())
  tenantId        String
  modifierGroupId String

  name            String // "Small", "Extra Cheese", "No Onion"
  priceAdjustment Float   @default(0) // Can be negative (discount)
  isDefault       Boolean @default(false)
  displayOrder    Int     @default(0)
  isActive        Boolean @default(true)
  emoji           String? // 🧀 🌶️ 🥩

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modifierGroup  ModifierGroup                 @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderModifiers RestaurantOrderItemModifier[]

  @@index([tenantId])
  @@index([modifierGroupId])
}

// ─── Link: which modifiers apply to which menu items ───
model MenuItemModifier {
  id              String  @id @default(uuid())
  menuItemId      String
  modifierGroupId String
  isRequired      Boolean @default(false) // Override group's isRequired
  displayOrder    Int     @default(0)

  menuItem      RestaurantMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup      @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId])
  @@index([modifierGroupId])
}

// ─── Recipes / BOM — for auto stock deduction ───
model Recipe {
  id         String @id @default(uuid())
  tenantId   String
  menuItemId String @unique

  yieldQuantity    Float   @default(1) // 1 recipe produces X portions
  yieldUnit        String  @default("portion")
  totalCost        Float   @default(0) // Auto-calculated from ingredients
  preparationSteps String? @db.Text
  cookingTime      Int? // minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItem    RestaurantMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([tenantId])
}

model RecipeIngredient {
  id                  String @id @default(uuid())
  recipeId            String
  ingredientProductId String // The raw material product

  quantity     Float
  unit         String // "kg", "g", "ml", "piece"
  costPerUnit  Float   @default(0)
  totalCost    Float   @default(0)
  isOptional   Boolean @default(false)
  notes        String?
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())

  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Product @relation("IngredientProduct", fields: [ingredientProductId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientProductId])
}

// ─── Tables (enhance existing RestaurantTable model with more fields) ───
// If model already exists in schema, we'll add these fields via migration
model RestaurantTableV2 {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  tableNumber String
  tableName   String? // "Table 1", "Corner Booth", "VIP Room"
  capacity    Int     @default(4)
  minCapacity Int     @default(1)
  maxCapacity Int     @default(8)

  section   String? // "Ground Floor", "Rooftop", "Family Area", "Smoking"
  floor     String? // "GF", "1st Floor"
  location  String? // Coordinates or description
  shape     String? // "round", "square", "rectangle"
  positionX Float? // For floor plan visualization
  positionY Float?

  status           RestaurantTableStatus @default(AVAILABLE)
  isReservable     Boolean               @default(true)
  isSmokingAllowed Boolean               @default(false)
  isAcRoom         Boolean               @default(true)
  isFamilyArea     Boolean               @default(false)
  isVip            Boolean               @default(false)
  minOrderAmount   Float?

  // Current session
  currentOrderId  String?
  occupiedAt      DateTime?
  reservedAt      DateTime?
  reservedFor     DateTime?
  reservedByName  String?
  reservedByPhone String?
  reservationNote String?

  // Stats
  totalOrders        Int    @default(0)
  totalRevenue       Float  @default(0)
  avgTurnoverMinutes Float?

  qrCodeUrl String? // Customer scans to view menu
  notes     String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders RestaurantOrder[]

  @@unique([tenantId, tableNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, section])
  @@index([shopId])
}

// ─── Restaurant Orders (dining orders — separate from POS sales) ───
model RestaurantOrder {
  id         String  @id @default(uuid())
  tenantId   String
  shopId     String?
  tableId    String?
  customerId String?
  riderId    String?
  waiterId   String?

  orderNumber String // ORD-2026-0001
  mode        RestaurantOrderMode
  status      RestaurantOrderStatus @default(DRAFT)

  // Customer info (walk-in / phone order)
  customerName    String?
  customerPhone   String?
  customerAddress String?
  numberOfGuests  Int?
  specialRequests String? @db.Text

  // Amounts
  subtotal         Float @default(0)
  serviceCharge    Float @default(0)
  serviceChargePct Float @default(0)
  taxAmount        Float @default(0)
  taxPct           Float @default(0)
  discount         Float @default(0)
  deliveryFee      Float @default(0)
  packagingFee     Float @default(0)
  tip              Float @default(0)
  total            Float @default(0)
  paidAmount       Float @default(0)

  // Timing
  placedAt           DateTime?
  confirmedAt        DateTime?
  cookingStartedAt   DateTime?
  readyAt            DateTime?
  servedAt           DateTime?
  outForDeliveryAt   DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  estimatedPrepTime     Int? // minutes
  estimatedDeliveryTime DateTime?

  // Delivery-specific
  deliveryAddress  String?
  deliveryLat      Float?
  deliveryLng      Float?
  deliveryDistance Float?
  deliveryNotes    String?
  deliveryStatus   RiderDeliveryStatus?

  // KOT tracking
  kotPrintedAt  DateTime?
  kotPrintCount Int       @default(0)

  // Split bill
  isSplitBill   Boolean @default(false)
  parentOrderId String?

  saleId String? // Once paid, links to main Sale record

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table    RestaurantTableV2?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items    RestaurantOrderItem[]
  kots     Kot[]
  delivery DeliveryTracking?
  payments RestaurantOrderPayment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, mode])
  @@index([tableId])
  @@index([customerId])
  @@index([riderId])
  @@index([createdAt])
}

// ─── Order line items ───
model RestaurantOrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  variantId String?

  quantity      Float
  unit          String @default("piece")
  basePrice     Float
  modifierTotal Float  @default(0)
  itemDiscount  Float  @default(0)
  total         Float
  costPrice     Float  @default(0)

  // Kitchen instructions
  specialInstructions String?     @db.Text
  spiceLevel          SpiceLevel?
  cookingNote         String?

  // Status
  status          RestaurantOrderStatus @default(PLACED)
  courseNumber    Int? // 1st course, 2nd course
  isComplimentary Boolean               @default(false)
  isReturned      Boolean               @default(false)
  returnReason    String?

  // Kitchen tracking
  sentToKitchenAt  DateTime?
  cookingStartedAt DateTime?
  readyAt          DateTime?
  servedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     RestaurantOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product                       @relation("RestaurantOrderProduct", fields: [productId], references: [id], onDelete: Restrict)
  modifiers RestaurantOrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@index([status])
}

// ─── Modifier selections per order item ───
model RestaurantOrderItemModifier {
  id               String @id @default(uuid())
  orderItemId      String
  modifierOptionId String

  quantity        Int     @default(1)
  priceAdjustment Float   @default(0)
  notes           String?

  createdAt DateTime @default(now())

  orderItem      RestaurantOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption      @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([modifierOptionId])
}

// ─── KOT (Kitchen Order Ticket) ───
model Kot {
  id       String @id @default(uuid())
  tenantId String
  orderId  String

  kotNumber String // KOT-2026-0001
  station   String? // "Grill", "Tandoor", "Bar", "Dessert"
  status    KotStatus @default(PENDING)

  itemIds       String[] // Which order items are on this KOT
  itemsSnapshot Json // Snapshot at time of print

  printedAt        DateTime?
  printedBy        String?
  acknowledgedAt   DateTime?
  cookingStartedAt DateTime?
  readyAt          DateTime?
  servedAt         DateTime?
  cancelledAt      DateTime?

  notes    String?
  priority String? // "HIGH", "NORMAL", "LOW"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kotNumber])
  @@index([tenantId])
  @@index([orderId])
  @@index([status])
  @@index([station])
}

// ─── Split bill / Multiple payments per order ───
model RestaurantOrderPayment {
  id      String @id @default(uuid())
  orderId String

  amount        Float
  paymentMethod String
  paidBy        String? // Customer name (for split bills)
  reference     String?
  notes         String?
  paidAt        DateTime @default(now())

  createdAt DateTime @default(now())

  order RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── Riders / Delivery Staff ───
model Rider {
  id       String @id @default(uuid())
  tenantId String

  name      String
  phone     String
  cnic      String?
  email     String?
  avatarUrl String?

  vehicleType   String? // "Bike", "Car", "Bicycle", "On foot"
  vehicleNumber String?
  licenseNumber String?

  status             RiderStatus @default(ACTIVE)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?

  // Employment
  isEmployee      Boolean @default(true)
  commissionType  String? // "PER_DELIVERY", "PERCENTAGE", "FIXED"
  commissionValue Float   @default(0)
  baseSalary      Float   @default(0)

  // Stats
  totalDeliveries Int    @default(0)
  totalDistance   Float  @default(0)
  avgRating       Float?
  totalTips       Float  @default(0)

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries DeliveryTracking[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, isActive])
}

// ─── Delivery tracking ───
model DeliveryTracking {
  id      String  @id @default(uuid())
  orderId String  @unique
  riderId String?

  status      RiderDeliveryStatus @default(PENDING)
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  onTheWayAt  DateTime?
  arrivedAt   DateTime?
  deliveredAt DateTime?

  pickupLat        Float?
  pickupLng        Float?
  dropoffLat       Float?
  dropoffLng       Float?
  distanceKm       Float?
  estimatedMinutes Int?
  actualMinutes    Int?

  deliveryFee     Float @default(0)
  riderCommission Float @default(0)
  customerTip     Float @default(0)

  customerRating   Int?
  customerFeedback String?
  proofPhotoUrl    String?
  signatureUrl     String?
  failureReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider Rider?          @relation(fields: [riderId], references: [id], onDelete: SetNull)

  @@index([riderId])
  @@index([status])
}

// ─── Kitchen Stations (for KOT routing) ───
model KitchenStation {
  id       String @id @default(uuid())
  tenantId String

  name         String // "Grill", "Tandoor", "Cold Kitchen", "Bar", "Dessert"
  code         String? // Short code for KOT
  printerName  String? // Which printer prints for this station
  categoryIds  String[] @default([]) // Auto-route these categories here
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ─── Waiter / Server assignments ───
model WaiterAssignment {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String // Staff member
  tableIds   String[]  @default([])
  section    String?
  shiftStart DateTime?
  shiftEnd   DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ─── Happy Hour / Time-based pricing ───
model HappyHourRule {
  id       String @id @default(uuid())
  tenantId String

  name          String
  description   String?
  discountType  String  @default("PERCENTAGE") // PERCENTAGE, FIXED, BUY_ONE_GET_ONE
  discountValue Float

  // Time windows
  startTime  String // "17:00"
  endTime    String // "19:00"
  daysOfWeek Int[]     @default([]) // 0=Sun..6=Sat
  validFrom  DateTime?
  validTo    DateTime?

  // Scope
  categoryIds    String[]              @default([])
  productIds     String[]              @default([])
  minOrderAmount Float?
  maxDiscount    Float?
  orderModes     RestaurantOrderMode[] @default([])

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  // Stats
  totalUsage Int   @default(0)
  totalSaved Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ═══════════════════════════════════════════════════════════════
// INDUSTRY: PHARMACY / MEDICAL STORE
// Full feature set — DRAP compliant, prescriptions, salts, doctors
// ═══════════════════════════════════════════════════════════════

enum PrescriptionStatus {
  PENDING // Received, not verified
  VERIFIED // Pharmacist verified
  PARTIALLY_DISPENSED
  DISPENSED // Fully dispensed
  REJECTED // Invalid/expired
  CANCELLED
}

enum PrescriptionType {
  WALK_IN
  ONLINE
  REFILL
  HOSPITAL
  INSURANCE
  EMERGENCY
}

enum DrugScheduleClass {
  OTC // Over the counter
  SCHEDULE_G // Prescription only
  SCHEDULE_H // Restricted
  SCHEDULE_X // Highly controlled (narcotics)
  CONTROLLED
  NARCOTIC
  PSYCHOTROPIC
}

enum StorageCondition {
  ROOM_TEMPERATURE // 15-30°C
  COOL // 8-15°C
  REFRIGERATED // 2-8°C
  FROZEN // -18°C or below
  CONTROLLED_ROOM // 20-25°C
  PROTECT_FROM_LIGHT
  PROTECT_FROM_MOISTURE
}

enum RefillFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  AS_NEEDED
}

// ─── Drug/Salt Master (generic ingredients) ───
model Salt {
  id       String @id @default(uuid())
  tenantId String

  name        String // "Paracetamol", "Amoxicillin"
  genericName String?
  code        String? // ATC classification code
  category    String? // "Analgesic", "Antibiotic"
  description String? @db.Text

  // Dosage info
  standardDose String? // "500mg 3x daily"
  maxDailyDose String?
  routeOfAdmin String? // "Oral", "IV", "Topical"

  // Safety
  isPregnancySafe   Boolean @default(true)
  isLactationSafe   Boolean @default(true)
  isPediatricSafe   Boolean @default(true)
  minAgeYears       Int?
  contraindications String? @db.Text
  sideEffects       String? @db.Text
  warnings          String? @db.Text

  // Regulatory
  scheduleClass        DrugScheduleClass @default(OTC)
  requiresPrescription Boolean           @default(false)
  isNarcotic           Boolean           @default(false)
  isBanned             Boolean           @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productSalts      ProductSalt[]
  drugInteractionsA DrugInteraction[] @relation("SaltA")
  drugInteractionsB DrugInteraction[] @relation("SaltB")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, scheduleClass])
  @@index([name])
}

// ─── Product ↔ Salt mapping (many-to-many with strength) ───
model ProductSalt {
  id        String @id @default(uuid())
  productId String
  saltId    String

  strength      String // "500mg", "250mg/5ml"
  strengthValue Float? // Numeric for sorting/filtering
  strengthUnit  String? // "mg", "ml", "IU"
  isMainSalt    Boolean @default(true)

  createdAt DateTime @default(now())

  product Product @relation("ProductSalt", fields: [productId], references: [id], onDelete: Cascade)
  salt    Salt    @relation(fields: [saltId], references: [id], onDelete: Cascade)

  @@unique([productId, saltId])
  @@index([productId])
  @@index([saltId])
}

// ─── Drug Interactions ───
model DrugInteraction {
  id       String @id @default(uuid())
  tenantId String

  saltAId        String
  saltBId        String
  severity       String // "MINOR", "MODERATE", "MAJOR", "CONTRAINDICATED"
  description    String  @db.Text
  clinicalEffect String? @db.Text
  management     String? @db.Text

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  saltA Salt @relation("SaltA", fields: [saltAId], references: [id], onDelete: Cascade)
  saltB Salt @relation("SaltB", fields: [saltBId], references: [id], onDelete: Cascade)

  @@unique([saltAId, saltBId])
  @@index([tenantId])
  @@index([severity])
}

// ─── Pharmacy Product Extension ───
model PharmacyMedicine {
  id        String @id @default(uuid())
  tenantId  String
  productId String @unique

  // Identification
  registrationNumber String? // DRAP registration
  approvalDate       DateTime?

  // Dosage form
  dosageForm String? // "Tablet", "Syrup", "Injection", "Cream", "Drops"
  packSize   String? // "10 tablets", "60 ml"
  packUnit   String? // Blister, bottle, tube, vial

  // Manufacturer
  manufacturer    String?
  countryOfOrigin String?
  importedBy      String?

  // Clinical info
  indication        String? @db.Text // What it's used for
  mechanismOfAction String? @db.Text
  pharmacokinetics  String? @db.Text

  // Storage
  storageCondition    StorageCondition @default(ROOM_TEMPERATURE)
  storageInstructions String?          @db.Text
  requiresColdChain   Boolean          @default(false)
  minTemperature      Float?
  maxTemperature      Float?

  // Regulatory
  scheduleClass        DrugScheduleClass @default(OTC)
  requiresPrescription Boolean           @default(false)
  isNarcotic           Boolean           @default(false)
  isRefrigerated       Boolean           @default(false)

  // Display
  color    String?
  shape    String?
  markings String? // "M / 500" on the tablet

  // Substitutes
  isGeneric Boolean @default(false)
  brandTier String? // "PREMIUM", "STANDARD", "GENERIC"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product              @relation("PharmacyMedicine", fields: [productId], references: [id], onDelete: Cascade)
  substitutes  MedicineSubstitute[] @relation("MainMedicine")
  substituteOf MedicineSubstitute[] @relation("SubstituteMedicine")

  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, scheduleClass])
  @@index([registrationNumber])
}

// ─── Medicine Substitutes ───
model MedicineSubstitute {
  id                   String  @id @default(uuid())
  mainMedicineId       String
  substituteMedicineId String
  similarity           Float   @default(1.0) // 0-1, how similar
  priceDifference      Float? // + means substitute is more expensive
  notes                String?

  createdAt DateTime @default(now())

  main       PharmacyMedicine @relation("MainMedicine", fields: [mainMedicineId], references: [id], onDelete: Cascade)
  substitute PharmacyMedicine @relation("SubstituteMedicine", fields: [substituteMedicineId], references: [id], onDelete: Cascade)

  @@unique([mainMedicineId, substituteMedicineId])
  @@index([mainMedicineId])
  @@index([substituteMedicineId])
}

// ─── Doctors ───
model Doctor {
  id       String @id @default(uuid())
  tenantId String

  name  String
  phone String?
  email String?
  cnic  String?

  // Professional
  registrationNumber String // PMDC number
  qualification      String? // "MBBS, FCPS"
  specialization     String? // "Cardiology", "Pediatrics"
  yearsOfExperience  Int?

  // Practice
  clinicName          String?
  clinicAddress       String?
  hospitalAffiliation String?
  consultationFee     Float?

  // Prescription/commission
  commissionType  String? @default("NONE") // NONE, PER_PRESCRIPTION, PERCENTAGE
  commissionValue Float   @default(0)

  // Stats
  totalPrescriptions Int   @default(0)
  totalBusiness      Float @default(0)
  totalCommission    Float @default(0)

  notes      String?
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptions Prescription[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([specialization])
}

// ─── Patients (extends Customer with medical info) ───
model PatientProfile {
  id         String @id @default(uuid())
  tenantId   String
  customerId String @unique

  // Medical basics
  dateOfBirth DateTime?
  bloodGroup  String?
  height      Float? // cm
  weight      Float? // kg
  gender      String?

  // Medical history
  chronicConditions  String[] @default([])
  allergies          String[] @default([])
  currentMedications String[] @default([])
  pastSurgeries      String?  @db.Text

  // Emergency
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelation     String?

  // Insurance
  hasInsurance      Boolean   @default(false)
  insuranceProvider String?
  insuranceNumber   String?
  insuranceExpiry   DateTime?

  // Notes
  medicalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
}

// ─── Prescriptions ───
model Prescription {
  id         String  @id @default(uuid())
  tenantId   String
  shopId     String?
  customerId String?
  doctorId   String?
  saleId     String?

  prescriptionNumber String // Rx-2026-0001
  type               PrescriptionType   @default(WALK_IN)
  status             PrescriptionStatus @default(PENDING)

  // Doctor info (snapshot — if manual entry)
  doctorName       String?
  doctorRegNumber  String?
  doctorSpeciality String?
  hospitalName     String?

  // Patient info
  patientName   String?
  patientAge    Int?
  patientGender String?
  patientPhone  String?
  patientCnic   String?
  patientWeight Float?

  // Prescription details
  prescriptionDate DateTime?
  diagnosis        String?   @db.Text
  chiefComplaint   String?
  vitals           Json? // BP, temp, pulse etc.

  // Images
  imageUrls   String[] @default([])
  scannedText String?  @db.Text // OCR extraction

  // Refill
  isRefillable    Boolean          @default(false)
  refillsAllowed  Int              @default(0)
  refillsUsed     Int              @default(0)
  refillFrequency RefillFrequency?
  nextRefillDate  DateTime?

  // Insurance
  isInsuranceClaim      Boolean @default(false)
  insuranceProvider     String?
  insuranceApprovalCode String?
  insuranceAmount       Float   @default(0)

  // Verification
  verifiedById      String?
  verifiedAt        DateTime?
  verificationNotes String?

  // Dispensing
  dispensedById String?
  dispensedAt   DateTime?

  // Rejection
  rejectionReason String?

  totalAmount Float   @default(0)
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  items  PrescriptionItem[]

  @@unique([tenantId, prescriptionNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([doctorId])
  @@index([prescriptionDate])
}

// ─── Prescription Items ───
model PrescriptionItem {
  id             String  @id @default(uuid())
  prescriptionId String
  productId      String?
  batchId        String?

  // What doctor wrote
  medicineName String
  saltName     String?
  strength     String?

  // Dosage
  dose         String? // "500mg"
  frequency    String? // "1-0-1" or "TID"
  duration     String? // "7 days"
  route        String? // "Oral"
  instructions String? @db.Text // "After meals"

  // Quantity
  prescribedQty Float
  dispensedQty  Float  @default(0)
  unit          String @default("tablet")

  // Pricing
  unitPrice  Float @default(0)
  totalPrice Float @default(0)

  // Status
  isDispensed   Boolean @default(false)
  isSubstituted Boolean @default(false)
  substituteFor String? // Original medicine name if substituted
  isOutOfStock  Boolean @default(false)

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([productId])
}

// ─── Controlled Substance Log (Narcotic Register — govt required) ───
model ControlledSubstanceLog {
  id             String  @id @default(uuid())
  tenantId       String
  productId      String
  batchId        String?
  saleId         String?
  prescriptionId String?

  logNumber String // Sequential
  logDate   DateTime @default(now())
  logType   String // "SALE", "PURCHASE", "ADJUSTMENT", "DAMAGE"

  quantity       Float
  unit           String
  openingBalance Float
  closingBalance Float

  // Patient info (mandatory for sales)
  patientName    String?
  patientCnic    String?
  patientPhone   String?
  patientAddress String?

  // Doctor info
  doctorName         String?
  doctorRegNumber    String?
  prescriptionNumber String?

  // Handled by
  dispensedBy  String? // Staff member
  supervisedBy String? // Pharmacist name/reg

  notes          String?
  attachmentUrls String[] @default([])

  isReversed     Boolean @default(false)
  reversalReason String?

  createdAt DateTime @default(now())

  @@unique([tenantId, logNumber])
  @@index([tenantId])
  @@index([tenantId, logDate])
  @@index([productId])
}

// ─── Refill Reminders ───
model RefillReminder {
  id             String  @id @default(uuid())
  tenantId       String
  customerId     String
  productId      String?
  prescriptionId String?

  medicineName String
  scheduledFor DateTime
  reminderType String   @default("SMS") // SMS, EMAIL, WHATSAPP, CALL
  status       String   @default("PENDING") // PENDING, SENT, ACKNOWLEDGED, MISSED

  sentAt         DateTime?
  acknowledgedAt DateTime?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([scheduledFor])
}

// ─── Cold Chain / Temperature Log ───
model TemperatureLog {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  logDate       DateTime @default(now())
  temperature   Float
  humidity      Float?
  unit          String   @default("celsius")
  location      String? // "Fridge 1", "Freezer", "Storage Room"
  isWithinRange Boolean  @default(true)
  minLimit      Float?
  maxLimit      Float?

  recordedBy String?
  automated  Boolean @default(false) // From IoT sensor
  notes      String?
  alertSent  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, logDate])
  @@index([shopId])
}

