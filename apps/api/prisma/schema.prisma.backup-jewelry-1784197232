// ─────────────────────────────────────────────────────────────
// Custom tailoring / stitching order
// ─────────────────────────────────────────────────────────────
model GarmentTailoringOrder {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  orderNumber          String
  customerId           String?
  measurementProfileId String?

  customerName  String?
  customerPhone String?
  customerNotes String? @db.Text

  orderStatus   GarmentOrderStatus   @default(DRAFT)
  priority      GarmentPriority      @default(NORMAL)
  paymentStatus GarmentPaymentStatus @default(UNPAID)

  collectionId String?
  tailorId     String?
  designerId   String?

  orderDate          DateTime  @default(now())
  promisedDate       DateTime?
  readyDate          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  subtotal          Float @default(0)
  stitchingCharges  Float @default(0)
  embroideryCharges Float @default(0)
  alterationCharges Float @default(0)
  fabricCharges     Float @default(0)
  accessoryCharges  Float @default(0)
  discount          Float @default(0)
  taxAmount         Float @default(0)
  total             Float @default(0)
  paidAmount        Float @default(0)

  designReferenceUrls String[] @default([])
  designInstructions  String?  @db.Text
  internalNotes       String?  @db.Text

  qualityCheckNotes  String?   @db.Text
  qualityCheckedById String?
  qualityCheckedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

