// ─────────────────────────────────────────────────────────────
// Vehicle Make (Toyota, Honda, Suzuki etc.)
// ─────────────────────────────────────────────────────────────
model VehicleMake {
  id       String @id @default(uuid())
  tenantId String

  name         String
  country      String?
  logoUrl      String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models VehicleModel[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Vehicle Model (Corolla, Civic, Mehran, City etc.)
// ─────────────────────────────────────────────────────────────
model VehicleModel {
  id       String @id @default(uuid())
  tenantId String
  makeId   String

  name          String
  vehicleType   VehicleType @default(CAR)
  yearFrom      Int?
  yearTo        Int?
  engineOptions String[]    @default([])
  imageUrl      String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  make VehicleMake @relation(fields: [makeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, makeId, name])
  @@index([tenantId])
  @@index([makeId])
}

// ─────────────────────────────────────────────────────────────
// Customer's Vehicle Registration
// ─────────────────────────────────────────────────────────────
model CustomerVehicle {
  id         String @id @default(uuid())
  tenantId   String
  customerId String

  // Registration
  registrationNumber String
  chassisNumber      String?
  engineNumber       String?

  // Vehicle info
  makeId      String?
  modelId     String?
  makeName    String?
  modelName   String?
  vehicleType VehicleType @default(CAR)
  year        Int?
  color       String?

  // Technical
  fuelType     FuelType         @default(PETROL)
  transmission TransmissionType @default(MANUAL)
  engineCC     Int?
  odometerKm   Int?

  // Ownership
  ownerName  String?
  ownerPhone String?
  ownerCnic  String?

  // Insurance
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?

  // Registration/token
  tokenTaxExpiry DateTime?
  fitnessExpiry  DateTime?

  // Documents
  documentUrls String[] @default([])
  photoUrls    String[] @default([])

  // Service preferences
  preferredMechanicId String?
  notes               String? @db.Text

  // Stats
  totalServices  Int       @default(0)
  totalSpent     Float     @default(0)
  lastServiceAt  DateTime?
  lastOdometerKm Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, insuranceExpiry])
  @@index([tenantId, tokenTaxExpiry])
  @@index([tenantId, fitnessExpiry])
}

// ─────────────────────────────────────────────────────────────
// Part Master (extends Product for auto parts)
// ─────────────────────────────────────────────────────────────
model AutoPartProfile {
  id        String @id @default(uuid())
  tenantId  String
  productId String @unique

  // Part identification
  partNumber       String?
  oemNumber        String?
  alternateNumbers String[]     @default([])
  category         PartCategory @default(OTHER)
  subCategory      String?

  // Part details
  condition       PartCondition @default(NEW)
  brand           String?
  countryOfOrigin String?
  manufacturer    String?

  // Physical
  weightGrams Float?
  dimensions  String?
  color       String?
  material    String?

  // Warranty
  warrantyMonths Int     @default(0)
  warrantyKm     Int?
  warrantyNotes  String?

  // Installation
  installationMinutes    Int?
  requiresSpecialTool    Boolean @default(false)
  installationDifficulty String? // EASY | MEDIUM | HARD | EXPERT

  // Compatibility (JSON: [{makeId, modelId, yearFrom, yearTo, engineCC, fuelType}])
  compatibility Json?

  // Business
  minStockAlert Int     @default(0)
  isFastMoving  Boolean @default(false)
  isCritical    Boolean @default(false)

  // Stats
  totalSold      Int @default(0)
  totalInstalled Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, partNumber])
  @@index([tenantId, oemNumber])
}

// ─────────────────────────────────────────────────────────────
// Service Job (Workshop repair/service ticket)
// ─────────────────────────────────────────────────────────────
model WorkshopJob {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  jobNumber String
  status    JobStatus   @default(DRAFT)
  priority  JobPriority @default(NORMAL)
  jobType   JobType     @default(GENERAL_SERVICE)

  // Vehicle
  vehicleId          String?
  registrationNumber String?
  makeName           String?
  modelName          String?
  year               Int?
  odometerKm         Int?

  // Customer
  customerId    String?
  customerName  String?
  customerPhone String?

  // Complaint & diagnosis
  customerComplaint String? @db.Text
  diagnosis         String? @db.Text
  workDescription   String? @db.Text
  recommendations   String? @db.Text

  // Assignment
  primaryMechanicId    String?
  assistantMechanicIds String[] @default([])
  bayNumber            String?

  // Dates
  receivedAt         DateTime  @default(now())
  promisedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // Vehicle inspection
  fuelLevel           String?
  hasSpareTire        Boolean  @default(false)
  hasToolkit          Boolean  @default(false)
  externalDamages     String?  @db.Text
  inspectionImageUrls String[] @default([])

  // Test drive
  testDriveRequired     Boolean   @default(false)
  testDriveNotes        String?   @db.Text
  testDriveDoneAt       DateTime?
  testDriveByMechanicId String?

  // Financial
  laborTotal    Float  @default(0)
  partsTotal    Float  @default(0)
  externalTotal Float  @default(0)
  subtotal      Float  @default(0)
  discount      Float  @default(0)
  taxAmount     Float  @default(0)
  total         Float  @default(0)
  paidAmount    Float  @default(0)
  paymentStatus String @default("UNPAID")

  // Warranty
  warrantyStatus WarrantyStatus @default(NONE)
  warrantyMonths Int            @default(0)
  warrantyKm     Int?
  warrantyExpiry DateTime?
  warrantyNotes  String?

  // Insurance claim
  isInsuranceClaim     Boolean @default(false)
  insuranceProvider    String?
  insuranceClaimNumber String?
  insuranceApproved    Boolean @default(false)
  insuranceAmount      Float   @default(0)

  // Feedback
  customerRating   Int?
  customerFeedback String? @db.Text

  // Notes
  internalNotes String?  @db.Text
  imageUrls     String[] @default([])
  documentUrls  String[] @default([])

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  laborItems   WorkshopJobLabor[]
  partsUsed    WorkshopJobPart[]
  externalWork WorkshopJobExternal[]
  payments     WorkshopJobPayment[]
  statusLogs   WorkshopJobStatusLog[]

  @@unique([tenantId, jobNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([vehicleId])
  @@index([customerId])
  @@index([primaryMechanicId])
  @@index([promisedAt])
}

// ─────────────────────────────────────────────────────────────
// Labor line items in a job
// ─────────────────────────────────────────────────────────────
model WorkshopJobLabor {
  id    String @id @default(uuid())
  jobId String

  description  String
  jobType      JobType?
  mechanicId   String?
  mechanicName String?

  hours       Float @default(1)
  ratePerHour Float @default(0)
  total       Float @default(0)

  commissionAmount Float     @default(0)
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  notes            String?

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  job WorkshopJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([mechanicId])
}

// ─────────────────────────────────────────────────────────────
// Parts used in a job
// ─────────────────────────────────────────────────────────────
model WorkshopJobPart {
  id    String @id @default(uuid())
  jobId String

  productId  String?
  variantId  String?
  partName   String
  partNumber String?

  quantity  Float @default(1)
  unitPrice Float @default(0)
  discount  Float @default(0)
  total     Float @default(0)

  condition          PartCondition @default(NEW)
  isCustomerSupplied Boolean       @default(false)

  warrantyMonths Int  @default(0)
  warrantyKm     Int?

  installedByMechanicId String?
  installedAt           DateTime?
  notes                 String?

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  job WorkshopJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// External work (sent to another shop for painting, machining etc.)
// ─────────────────────────────────────────────────────────────
model WorkshopJobExternal {
  id    String @id @default(uuid())
  jobId String

  description String
  vendorName  String?
  vendorPhone String?

  cost   Float @default(0)
  markup Float @default(0)
  total  Float @default(0)

  sentAt     DateTime?
  receivedAt DateTime?

  status String  @default("PENDING")
  notes  String?

  createdAt DateTime @default(now())

  job WorkshopJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────
// Job payments
// ─────────────────────────────────────────────────────────────
model WorkshopJobPayment {
  id    String @id @default(uuid())
  jobId String

  amount        Float
  paymentMethod String
  reference     String?
  notes         String?
  receivedById  String?
  paidAt        DateTime @default(now())

  createdAt DateTime @default(now())

  job WorkshopJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────
// Status change log
// ─────────────────────────────────────────────────────────────
model WorkshopJobStatusLog {
  id    String @id @default(uuid())
  jobId String

  fromStatus  JobStatus?
  toStatus    JobStatus
  notes       String?
  changedById String?

  createdAt DateTime @default(now())

  job WorkshopJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────
// Mechanic profile (extends Staff)
// ─────────────────────────────────────────────────────────────
model MechanicProfile {
  id       String @id @default(uuid())
  tenantId String
  staffId  String @unique

  // Skills & certification
  specialization    String[] @default([])
  certifications    String[] @default([])
  yearsOfExperience Int?
  bio               String?  @db.Text
  photoUrl          String?

  // Rates
  hourlyRate    Float @default(0)
  commissionPct Float @default(0)

  // Availability
  workingDays   Int[]  @default([1, 2, 3, 4, 5, 6])
  workStartTime String @default("09:00")
  workEndTime   String @default("18:00")

  isAvailable  Boolean @default(true)
  currentJobId String?

  // Stats
