  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([expiryDate])
}

// ─── Prepaid service packages ───
model SalonPackage {
  id       String @id @default(uuid())
  tenantId String

  name        String
  description String? @db.Text

  price         Float
  originalPrice Float?

  // What's included
