  @@index([tenantId])
  @@index([tenantId, role])
}

// ─── Which services can a staff perform ───
model SalonStaffService {
  id                  String  @id @default(uuid())
  staffProfileId      String
  serviceId           String
  customPrice         Float?
  customDuration      Int?
  customCommissionPct Float?
  isPrimary           Boolean @default(false)

  createdAt DateTime @default(now())

  staffProfile SalonStaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, serviceId])
  @@index([staffProfileId])
  @@index([serviceId])
}

// ─── Appointments ───
model SalonAppointment {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  appointmentNumber String
  customerId        String?
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  customerNotes     String? @db.Text

  status SalonAppointmentStatus @default(DRAFT)

  // Scheduling
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?

  arrivedAt          DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // Reminders
  reminderSent   Boolean   @default(false)
  reminderSentAt DateTime?

  // Financial
  subtotal      Float  @default(0)
  serviceCharge Float  @default(0)
  taxAmount     Float  @default(0)
  discount      Float  @default(0)
  tip           Float  @default(0)
  total         Float  @default(0)
  paidAmount    Float  @default(0)
