  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Service reminders (next service due)
// ─────────────────────────────────────────────────────────────
model VehicleServiceReminder {
  id        String @id @default(uuid())
  tenantId  String
  vehicleId String

  reminderType String // OIL_CHANGE | FILTER | TIMING_BELT | INSURANCE | TOKEN_TAX | FITNESS | GENERAL
  title        String
  description  String?

  dueDate       DateTime?
