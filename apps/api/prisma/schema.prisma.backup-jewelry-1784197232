// ═══════════════════════════════════════════════════════════════
// INDUSTRY: RETAIL — Multi-Unit, Combos, Damage, Quick Keys, Bulk Import
// FULL BEST — Kiryana, General Stores, Super Marts
// ═══════════════════════════════════════════════════════════════

enum UnitConversionType {
  BASE // The base sellable unit (piece, kg, meter)
  PACK // e.g. 1 pack = 6 pieces
  BOX // e.g. 1 box = 12 pieces
  DOZEN // 1 dozen = 12 pieces
  CARTON // 1 carton = 10 dozens = 120 pieces
  KG_TO_GRAM // 1 kg = 1000 grams (for fractional)
  L_TO_ML // 1 liter = 1000 ml
  CUSTOM
}

enum DamageStatus {
  REPORTED // Damage logged, awaiting review
  APPROVED // Manager approved, stock adjusted
  REJECTED // Not damaged / false report
  WRITTEN_OFF // Fully written off, cost booked
}

enum DamageReasonCode {
  EXPIRY
  BREAKAGE
  SPOILAGE
  PEST_DAMAGE
  WATER_DAMAGE
  THEFT
  MISHANDLING
  MANUFACTURING_DEFECT
  OTHER
}

enum ComboStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DRAFT
}

enum BulkJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum BulkJobType {
  PRODUCTS
  CUSTOMERS
  SUPPLIERS
  STOCK_ADJUSTMENT
  PRICE_UPDATE
}

// ─── Multi-Unit System ────────────────────────────────────────
// Ek product multiple units mein bech sakte ho:
// Colgate piece = Rs 150 (base)
// Colgate dozen = Rs 1650 (12 pieces)
// Colgate carton = Rs 15000 (10 dozens)
model ProductUnit {
  id        String  @id @default(uuid())
  tenantId  String
  productId String
  variantId String?

  unitName       String // "piece", "dozen", "carton", "kg"
  unitLabel      String? // Display: "Dozen (12 pcs)"
  conversionType UnitConversionType @default(BASE)
  conversionRate Float              @default(1) // How many BASE units this = 
  isBase         Boolean            @default(false)
  isDefault      Boolean            @default(false) // Default at POS

  // Pricing
  price          Float  @default(0)
  costPrice      Float  @default(0)
  wholesalePrice Float?
  mrpPrice       Float? // Maximum Retail Price

  // Per-unit barcode/SKU
  barcode String?
  sku     String?

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productComboItems ProductComboItem[]

  @@unique([productId, variantId, unitName])
  @@index([tenantId])
  @@index([productId])
  @@index([variantId])
  @@index([barcode])
  @@index([tenantId, isActive])
}

// ─── Combo / Bundle Products ──────────────────────────────────
// "Chai Combo" = 1kg cheeni + 500g patti + 1 pack rusk = Rs 900 (save Rs 100)
model ProductCombo {
  id         String  @id @default(uuid())
  tenantId   String
  shopId     String?
  categoryId String?

  name        String
  slug        String?
  sku         String?
  barcode     String?
  description String? @db.Text
  imageUrl    String?

  // Pricing
  comboPrice        Float @default(0)
  originalTotal     Float @default(0)
  savingsAmount     Float @default(0)
  savingsPercentage Float @default(0)

  // Availability
  status    ComboStatus @default(ACTIVE)
  validFrom DateTime?
  validTo   DateTime?

  // Limits
  maxPurchasePerCustomer Int?
  stockAvailable         Int? // If null = unlimited (until component stock runs out)

  // Stats
  soldCount    Int   @default(0)
  totalRevenue Float @default(0)

  // Display
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)
  tagLine    String? // "Best Deal!", "Limited Time"

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items    ProductComboItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, isFeatured])
  @@index([barcode])
  @@index([categoryId])
}

model ProductComboItem {
  id        String  @id @default(uuid())
  comboId   String
  productId String
  variantId String?
  unitId    String? // Which unit: piece/dozen/carton

  quantity      Float   @default(1)
  unitName      String? // "piece", "dozen", "kg"
  originalPrice Float   @default(0)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())

  combo   ProductCombo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  unit    ProductUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([comboId])
  @@index([productId])
  @@index([variantId])
}

// ─── Damage / Wastage / Loss Tracking ─────────────────────────
model DamageLog {
  id           String  @id @default(uuid())
  tenantId     String
  shopId       String?
  productId    String
  variantId    String?
  batchId      String?
  unitId       String?
  reportedById String
  approvedById String?

  damageNumber String // DMG-2026-0001
  quantity     Float
  unitCost     Float  @default(0)
  costImpact   Float  @default(0) // Total loss = quantity × unitCost
  salvageValue Float  @default(0) // Recoverable amount (e.g. sold at discount)
  netLoss      Float  @default(0) // costImpact - salvageValue

  reason        String
  reasonCode    DamageReasonCode @default(OTHER)
  photos        String[]         @default([])
  notes         String?          @db.Text
  supplierClaim Boolean          @default(false) // Can claim from supplier?
  claimStatus   String? // "PENDING", "APPROVED", "REJECTED"
  claimAmount   Float            @default(0)

  status          DamageStatus @default(REPORTED)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  batch   ProductBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, damageNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, reasonCode])
  @@index([productId])
  @@index([shopId])
  @@index([createdAt])
}

// ─── Quick-Access Favorites (POS shortcut grid) ───────────────
model RetailQuickKey {
  id        String  @id @default(uuid())
  tenantId  String
  userId    String? // Per-user or shared (null = shared)
  shopId    String? // Shop-specific
  productId String?
  comboId   String?
  variantId String?
  unitId    String?

