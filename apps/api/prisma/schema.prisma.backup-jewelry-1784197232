// ─── Salon Service Master ───
model SalonService {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  name        String
  code        String?
  category    SalonServiceCategory @default(OTHER)
  description String?              @db.Text

  // Pricing
  price         Float  @default(0)
  discountPrice Float?
  costPrice     Float?

  // Duration
  durationMinutes Int @default(30)
  bufferBefore    Int @default(0)
  bufferAfter     Int @default(0)

  // Gender
  forMen   Boolean @default(true)
  forWomen Boolean @default(true)
  forKids  Boolean @default(false)

  // Commission
  commissionPct   Float @default(0)
  commissionFixed Float @default(0)

  imageUrl     String?
  displayOrder Int     @default(0)

  isPopular  Boolean @default(false)
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  totalBookings Int    @default(0)
  totalRevenue  Float  @default(0)
  avgRating     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
}

// ─── Salon Staff (extends existing Staff/User) ───
model SalonStaffProfile {
  id       String @id @default(uuid())
  tenantId String
  staffId  String @unique

  role            SalonStaffRole @default(STYLIST)
  specialization  String[]       @default([])
  experienceYears Int?
  bio             String?        @db.Text
  photoUrl        String?

  // Commission setup
  commissionType  SalonCommissionType @default(NONE)
  commissionPct   Float               @default(0)
  commissionFixed Float               @default(0)

  // Availability
  workingDays    Int[]   @default([1, 2, 3, 4, 5, 6])
  workStartTime  String  @default("09:00")
  workEndTime    String  @default("21:00")
  breakStartTime String?
  breakEndTime   String?

  // Booking rules
  isBookable       Boolean @default(true)
  maxDailyBookings Int?
  bookingBuffer    Int     @default(0)

