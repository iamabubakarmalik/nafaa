  shopName        String?
  legalName       String?
  shopAddress     String?
  shopCity        String?
  shopProvince    String?
  shopPostalCode  String?
  shopPhone       String?
  shopWhatsapp    String?
  shopEmail       String?
  shopWebsite     String?
  logoUrl         String?
  bannerUrl       String?
  businessType    String?
  establishedDate DateTime?

  // ===== 2. LOCALIZATION =====
  language       String   @default("roman_ur") // ur, en, roman_ur
