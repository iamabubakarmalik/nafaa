// ─── Booking / Reservation ───
model HotelBooking {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  bookingNumber    String
  confirmationCode String?

  // Guest
  primaryGuestId String?
  guestName      String
  guestPhone     String
  guestEmail     String?
  totalAdults    Int     @default(1)
  totalChildren  Int     @default(0)

  // Dates
  checkInDate    DateTime
  checkOutDate   DateTime
  nights         Int       @default(1)
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  earlyCheckIn   Boolean   @default(false)
  lateCheckOut   Boolean   @default(false)

  // Source
  source          BookingSource @default(DIRECT)
  sourceRef       String?
  bookedBy        String?
  agentName       String?
  agentCommission Float         @default(0)

  // Meal plan
  mealPlan MealPlan @default(ROOM_ONLY)

  // Status
  status HotelBookingStatus @default(CONFIRMED)

  // Pricing
  roomTotal     Float  @default(0)
  taxAmount     Float  @default(0)
  serviceCharge Float  @default(0)
  discount      Float  @default(0)
  extraCharges  Float  @default(0)
  grandTotal    Float  @default(0)
  advancePaid   Float  @default(0)
  paidAmount    Float  @default(0)
  balanceAmount Float  @default(0)
  paymentStatus String @default("UNPAID")

  // Special requests
  specialRequests String? @db.Text
  arrivalTime     String?
  purposeOfVisit  String?

  // Cancellation
  cancelledAt        DateTime?
  cancellationReason String?
  refundAmount       Float     @default(0)

  createdById  String?
  checkedInBy  String?
  checkedOutBy String?
  cancelledBy  String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookedRooms  HotelBookedRoom[]
  folioCharges HotelFolioCharge[]

  @@unique([tenantId, bookingNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([primaryGuestId])
  @@index([checkInDate])
  @@index([checkOutDate])
}

// ─── Rooms in Booking ───
model HotelBookedRoom {
  id        String @id @default(uuid())
  bookingId String

  roomId     String?
  roomTypeId String
  roomNumber String?

  // Pricing per night
  ratePerNight Float
  totalNights  Int
  totalAmount  Float

  // Occupants
  adults    Int @default(1)
  children  Int @default(0)
  extraBeds Int @default(0)

  // Special
  isComplimentary Boolean @default(false)
  discount        Float   @default(0)

  notes String?

  createdAt DateTime @default(now())

