  voidReason String?

  notes String?

  createdAt DateTime @default(now())

  booking HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([chargeDate])
}

// ─── Housekeeping Task ───
model HotelHousekeepingTask {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  taskNumber String
  roomId     String?
  roomNumber String

  taskType String
  priority String @default("NORMAL")

