// ▓▓▓  INTEGRATION FRAMEWORK  ▓▓▓
// ═══════════════════════════════════════════════════════════════

enum IntegrationType {
  CUSTOM_WEBSITE
  FOODPANDA
  DARAZ
  SHOPIFY
  WOOCOMMERCE
  TCS_COURIER
  LEOPARDS_COURIER
  CALLCOURIER
  NAYAPAY
  RAAST
}

enum IntegrationCategory {
  SALES_CHANNEL
  COURIER
  PAYMENT
  ACCOUNTING
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
  SUSPENDED
}

enum SyncDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

enum SyncStatus {
  PENDING
  SYNCING
  SUCCESS
  FAILED
  SKIPPED
}

model Integration {
  id          String              @id @default(cuid())
  tenantId    String
  shopId      String?
  type        IntegrationType
  category    IntegrationCategory
  displayName String
  status      IntegrationStatus   @default(PENDING)

  // Credentials
  credentials   Json?
  apiKey        String? @unique
  apiSecret     String?
  webhookSecret String?

  // Config
  config          Json?
  syncDirection   SyncDirection @default(BIDIRECTIONAL)
  autoSyncEnabled Boolean       @default(true)
  syncIntervalMin Int           @default(15)

  // Stats
  lastSyncAt          DateTime?
  lastSyncStatus      SyncStatus?
  totalOrdersSynced   Int         @default(0)
  totalProductsSynced Int         @default(0)
  totalErrors         Int         @default(0)

  // Webhook
  webhookUrl      String?
  webhookVerified Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncLogs        SyncLog[]
  channelOrders   ChannelOrder[]
  webhookLogs     WebhookLog[]
  productMappings ProductChannelMapping[]

  @@unique([tenantId, type])
  @@index([tenantId, status])
  @@index([type, status])
  @@map("integrations")
}

model ChannelOrder {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenantId      String
  shopId        String?

  externalOrderId     String
  externalOrderNumber String?

  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  customerCity    String?
  customerLat     Float?
  customerLng     Float?

  items       Json
  subtotal    Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(12, 2)

  paymentMethod String?
  paymentStatus String  @default("PENDING")
  orderStatus   String  @default("PENDING")

  nafaaSaleId  String?
  nafaaOrderId String?

  notes    String?
  metadata Json?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([integrationId, externalOrderId])
  @@index([tenantId, orderStatus])
  @@index([integrationId, receivedAt])
  @@map("channel_orders")
}

model SyncLog {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenantId      String

  operation        String
  direction        SyncDirection
  status           SyncStatus
  recordsProcessed Int           @default(0)
  recordsSuccess   Int           @default(0)
  recordsFailed    Int           @default(0)
  errorMessage     String?
  details          Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([integrationId, startedAt])
  @@map("sync_logs")
}

model WebhookLog {
  id            String       @id @default(cuid())
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id])
  tenantId      String?

  source         String
  event          String
  method         String
  url            String?
  headers        Json?
  body           Json?
  responseStatus Int?
  processed      Boolean  @default(false)
  errorMessage   String?
  receivedAt     DateTime @default(now())

  @@index([integrationId, receivedAt])
  @@index([source, event])
  @@map("webhook_logs")
}

model ProductChannelMapping {
  id                String      @id @default(cuid())
  integrationId     String
  integration       Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalProductId String?
  externalVariantId String?
  externalSku       String?
  externalUrl       String?
  syncStatus        SyncStatus  @default(PENDING)
  lastSyncedAt      DateTime?
  externalData      Json?

  @@unique([integrationId, productId])
  @@index([integrationId, syncStatus])
  @@index([productId])
  @@map("product_channel_mappings")
}

