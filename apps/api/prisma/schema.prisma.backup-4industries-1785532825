  isCustomerSupplied Boolean       @default(false)

  warrantyMonths Int  @default(0)
  warrantyKm     Int?

  installedByMechanicId String?
  installedAt           DateTime?
  notes                 String?

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  job WorkshopJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
