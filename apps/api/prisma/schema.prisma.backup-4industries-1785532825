enum PromoType {
  COUPON
  FLASH_SALE
  BUNDLE
  HAPPY_HOUR
  BANNER
  BOGO
}

enum PromoStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum PromoDiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum PromoScope {
  MARKETPLACE_WIDE
  SHOP
  CATEGORY
  PRODUCT
  FIRST_ORDER
  RETURNING_CUSTOMER
}

model Promotion {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  shopId   String?
  shop     Shop?   @relation(fields: [shopId], references: [id])

  type        PromoType
  status      PromoStatus @default(DRAFT)
  scope       PromoScope  @default(SHOP)
  title       String
  description String?     @db.Text
