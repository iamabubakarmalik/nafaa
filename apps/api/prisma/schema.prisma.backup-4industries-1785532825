// ─── Bulk pricing tiers (min qty → price) ───
model HardwareBulkPricing {
  id        String @id @default(uuid())
  tenantId  String
  productId String

  minQuantity Float
  maxQuantity Float?
  price       Float
  discount    Float?
  discountPct Float?
  label       String?

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([productId])
}

// ─── Construction project tracking ───
model HardwareProject {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  projectNumber String
  name          String
  description   String? @db.Text

  customerId      String?
  customerName    String
  customerPhone   String?
  contractorName  String?
  contractorPhone String?
  architectName   String?

  // Location
  siteAddress      String  @db.Text
  city             String?
  area             String?
  latitude         Float?
  longitude        Float?
  siteContactPhone String?

  // Type
  projectType String?
  builtUpArea Float?
  floors      Int?

  // Timeline
  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?

  status HardwareProjectStatus @default(PLANNING)

  // Financial
  estimatedBudget Float?
  totalQuoted     Float  @default(0)
  totalOrdered    Float  @default(0)
  totalDelivered  Float  @default(0)
  totalPaid       Float  @default(0)
  totalPending    Float  @default(0)

  // Credit
  creditLimit Float @default(0)
  creditDays  Int   @default(0)

  // Additional
  imageUrls    String[] @default([])
  documentUrls String[] @default([])
  notes        String?  @db.Text

  isActive Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotations HardwareQuotation[]
  deliveries HardwareDelivery[]

  @@unique([tenantId, projectNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
}

// ─── Quotation / estimate ───
model HardwareQuotation {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  quotationNumber String
  projectId       String?
  customerId      String?

  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String? @db.Text

  status HardwareQuotationStatus @default(DRAFT)

  quotationDate   DateTime  @default(now())
  validUntil      DateTime
  sentAt          DateTime?
  viewedAt        DateTime?
  respondedAt     DateTime?
  convertedAt     DateTime?
  convertedSaleId String?

  // Financial
  subtotal        Float @default(0)
  discount        Float @default(0)
  discountPct     Float @default(0)
  taxAmount       Float @default(0)
  taxPct          Float @default(0)
  deliveryCharges Float @default(0)
  laborCharges    Float @default(0)
  otherCharges    Float @default(0)
  total           Float @default(0)

  // Terms
  paymentTerms  String? @db.Text
  deliveryTerms String? @db.Text
  warrantyTerms String? @db.Text
  specialTerms  String? @db.Text
  validityDays  Int     @default(15)

  // Additional
  attachmentUrls String[] @default([])
  internalNotes  String?  @db.Text
  customerNotes  String?  @db.Text
  revisionNumber Int      @default(1)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project HardwareProject?        @relation(fields: [projectId], references: [id])
  items   HardwareQuotationItem[]

  @@unique([tenantId, quotationNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([projectId])
  @@index([customerId])
}

model HardwareQuotationItem {
  id          String @id @default(uuid())
  quotationId String

  productId       String?
  variantId       String?
  itemName        String
  itemDescription String?
  brand           String?
  specifications  String? @db.Text

  quantity    Float
  unit        HardwareUnit @default(PIECE)
  unitPrice   Float
  discount    Float        @default(0)
  discountPct Float        @default(0)
  total       Float

  imageUrl     String?
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation HardwareQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// ─── Delivery / dispatch tracking ───
model HardwareDelivery {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  deliveryNumber String
  saleId         String?
  projectId      String?
  quotationId    String?
  customerId     String?

  customerName  String
  customerPhone String?

  // Delivery address
  deliveryAddress  String  @db.Text
  city             String?
  area             String?
  latitude         Float?
  longitude        Float?
  landmark         String?
  siteContactName  String?
  siteContactPhone String?

  status HardwareDeliveryStatus @default(PENDING)

  // Vehicle
  vehicleType   HardwareDeliveryVehicleType @default(TRUCK)
  vehicleNumber String?
  driverName    String?
  driverPhone   String?
  driverCnic    String?
  helperName    String?

  // Timing
  scheduledDate      DateTime?
  scheduledTime      String?
  loadedAt           DateTime?
  dispatchedAt       DateTime?
  arrivedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // Distance & charges
  distanceKm      Float?
  deliveryCharge  Float  @default(0)
  loadingCharge   Float  @default(0)
  unloadingCharge Float  @default(0)
  laborCharge     Float  @default(0)
  tollCharge      Float  @default(0)
  totalCharges    Float  @default(0)

  // Proof of delivery
  receivedByName       String?
  receivedByPhone      String?
  receivedByCnic       String?
  receiverSignatureUrl String?
  deliveryProofUrls    String[] @default([])
  gateEntryNumber      String?

  // Notes
  loadingInstructions String? @db.Text
  driverInstructions  String? @db.Text
  customerNotes       String? @db.Text
  internalNotes       String? @db.Text
  issueReported       String? @db.Text

  createdById    String?
  dispatchedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project HardwareProject?       @relation(fields: [projectId], references: [id])
  items   HardwareDeliveryItem[]

  @@unique([tenantId, deliveryNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([scheduledDate])
  @@index([projectId])
  @@index([customerId])
}

model HardwareDeliveryItem {
  id         String @id @default(uuid())
  deliveryId String

  productId String?
  variantId String?
  itemName  String
  brand     String?

  orderedQty   Float
  loadedQty    Float        @default(0)
  deliveredQty Float        @default(0)
  returnedQty  Float        @default(0)
  damagedQty   Float        @default(0)
  unit         HardwareUnit @default(PIECE)

  unitPrice Float @default(0)
  total     Float @default(0)

  notes        String?
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())

  delivery HardwareDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

// ─── Credit / khata account ───
model HardwareCreditAccount {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  accountNumber   String
  customerId      String? @unique
  customerName    String
  customerPhone   String?
  customerCnic    String?
  businessName    String?
  businessAddress String? @db.Text

  status HardwareCreditAccountStatus @default(ACTIVE)

  // Limits
  creditLimit         Float @default(0)
  creditDays          Int   @default(30)
  interestRateMonthly Float @default(0)

  // Current balances
  currentBalance Float @default(0)
  totalPurchases Float @default(0)
  totalPayments  Float @default(0)
  totalWriteOffs Float @default(0)
  totalInterest  Float @default(0)

  // Age analysis
  age0To30Days  Float @default(0)
  age31To60Days Float @default(0)
  age61To90Days Float @default(0)
  ageOver90Days Float @default(0)

  // Guarantee
  guarantorName     String?
  guarantorPhone    String?
  guarantorCnic     String?
  guarantorRelation String?
  chequeSecurity    String?
  postDatedCheques  String[] @default([])

  // Reference
  referredBy      String?
  openedByStaffId String?
  openingDate     DateTime  @default(now())
  closedAt        DateTime?

  // Contact
  lastPurchaseDate DateTime?
  lastPaymentDate  DateTime?
  lastReminderDate DateTime?

  notes         String?  @db.Text
  documentsUrls String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions HardwareCreditTransaction[]

  @@unique([tenantId, accountNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
}

// ─── Credit ledger entries ───
model HardwareCreditTransaction {
  id        String @id @default(uuid())
  tenantId  String
  accountId String

  transactionNumber String
  transactionType   HardwareCreditTransactionType
  transactionDate   DateTime                      @default(now())

  // Amount (positive for debit/sale, negative for credit/payment)
  amount         Float
  runningBalance Float

  // References
  saleId           String?
  deliveryId       String?
  paymentMethod    String?
  paymentReference String?

  // Description
  description String
  notes       String?

  handledById    String?
  attachmentUrls String[] @default([])

  createdAt DateTime @default(now())

  account HardwareCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, transactionNumber])
  @@index([tenantId])
  @@index([accountId])
  @@index([transactionDate])
}

// ─── Reorder alerts config ───
model HardwareReorderRule {
  id        String @id @default(uuid())
  tenantId  String
  productId String @unique

  minStock     Float
  reorderPoint Float
  reorderQty   Float
  maxStock     Float?

  preferredSupplier String?
  leadTimeDays      Int?
  emergencyContact  String?

  autoAlert   Boolean   @default(true)
  lastAlertAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════
// INDUSTRY: MEAT / BUTCHERY / HALAL SHOP
// Weight-based pricing, cuts, halal certification, live/fresh/frozen
// ═══════════════════════════════════════════════════════════════

enum MeatAnimalType {
  BEEF
  MUTTON
  GOAT
  LAMB
  CHICKEN
  DUCK
  TURKEY
  QUAIL
  CAMEL
  BUFFALO
  FISH
  PRAWN
  OTHER
}

enum MeatCutCategory {
  WHOLE_ANIMAL
  HALF_ANIMAL
  QUARTER
  PRIMAL_CUT
  RETAIL_CUT
  BONELESS
  WITH_BONE
  MINCE
  UNDERCUT
  RIBS
  CHOPS
  BREAST
  LEG
  THIGH
  WING
  DRUMSTICK
  LIVER
  KIDNEY
  HEART
  BRAIN
  TONGUE
  TROTTERS
  HEAD
  TAIL
  OFFAL
  BONES
  FAT
  SKIN
  OTHER
}

enum MeatFreshnessType {
  LIVE
  FRESH_SLAUGHTERED
  FRESH_CHILLED
  FROZEN
  PREPARED
  PROCESSED
  MARINATED
  SMOKED
  DRIED
  CURED
}

enum MeatSlaughterMethod {
  HALAL_HAND
  HALAL_MACHINE
  KOSHER
  STANDARD
  ORGANIC
  FREE_RANGE
  OTHER
}

enum MeatQualityGrade {
  PREMIUM
  GRADE_A
  GRADE_B
  GRADE_C
  STANDARD
  ECONOMY
}

enum MeatSaleUnit {
  KG
  GRAM
  POUND
  PIECE
  DOZEN
  WHOLE
  HALF
  QUARTER
  KILO_PACK
}

enum MeatOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  CUTTING
  PACKED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum MeatSubscriptionFreq {
  DAILY
  ALTERNATE_DAY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum MeatSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  COMPLETED
}

// ─── Master: Meat Product Extension ───
model MeatProductProfile {
  id        String @id @default(uuid())
  tenantId  String
  productId String @unique

  animalType      MeatAnimalType
  cutCategory     MeatCutCategory
  freshnessType   MeatFreshnessType   @default(FRESH_CHILLED)
  slaughterMethod MeatSlaughterMethod @default(HALAL_HAND)
  qualityGrade    MeatQualityGrade    @default(GRADE_A)

  // Weight
  saleUnit          MeatSaleUnit @default(KG)
  pricePerKg        Float        @default(0)
  pricePerPiece     Float?
  minOrderKg        Float?
  maxOrderKg        Float?
  weightVariancePct Float        @default(5)

  // Attributes
  isBoneless     Boolean @default(false)
  isBoneIn       Boolean @default(false)
  isSkinless     Boolean @default(true)
  isMarinated    Boolean @default(false)
  marinationType String?
  isOrganic      Boolean @default(false)
  isFreeRange    Boolean @default(false)
  isGrainFed     Boolean @default(false)
  isGrassFed     Boolean @default(false)
  isFrozen       Boolean @default(false)

  // Certifications
  halalCertNumber  String?
  halalCertBy      String?
  halalCertExpiry  DateTime?
  isHalalCertified Boolean   @default(true)
  otherCerts       String[]  @default([])

  // Source
  farmName           String?
  farmLocation       String?
  slaughterhouseName String?
  slaughterhouseLic  String?
  countryOfOrigin    String?
  breed              String?

  // Storage/Handling
  storageTempMin Float?
  storageTempMax Float?
  shelfLifeDays  Int?
  packagingType  String?
  batchNumber    String?

  // Age/Sex (mainly for beef/mutton)
  animalAge String?
  animalSex String?

  // Preparation
  cuttingStyle    String?
  cleaningLevel   String?
  packagingWeight Float?

  // Display
  imageUrls          String[] @default([])
  descriptionLong    String?  @db.Text
  cookingSuggestions String?  @db.Text
  nutritionInfo      Json?

  isPopular    Boolean @default(false)
  isFeatured   Boolean @default(false)
  isNewArrival Boolean @default(false)
  isOnSale     Boolean @default(false)

  totalSoldKg  Float @default(0)
  totalRevenue Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, animalType])
  @@index([tenantId, cutCategory])
  @@index([tenantId, freshnessType])
}

// ─── Live Animal Inventory ───
model MeatLiveAnimal {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  tagNumber  String
  animalType MeatAnimalType
  breed      String?
  color      String?

  sex       String?
  ageMonths Int?
  weightKg  Float

  purchasePrice Float    @default(0)
  purchaseDate  DateTime @default(now())
  vendorId      String?
  vendorName    String?
  sourceName    String?

  // Health
  vaccinationStatus String?
  healthCertUrl     String?
  isHealthy         Boolean   @default(true)
  healthNotes       String?   @db.Text
  vetCheckedAt      DateTime?

  // Feeding
  feedingType   String?
  dailyFeedCost Float   @default(0)
  daysHeld      Int     @default(0)
  totalFeedCost Float   @default(0)

  // Status
  isSlaughtered     Boolean              @default(false)
  slaughteredAt     DateTime?
  slaughterMethod   MeatSlaughterMethod?
  slaughterCertBy   String?
  slaughterWeightKg Float?
  meatYieldKg       Float?
  yieldPct          Float?

  isSold         Boolean   @default(false)
  soldPrice      Float?
  soldAt         DateTime?
  soldToCustomer String?

  photoUrls String[] @default([])
  notes     String?  @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, tagNumber])
  @@index([tenantId])
  @@index([tenantId, animalType])
  @@index([tenantId, isSlaughtered])
}

// ─── Slaughter Log (Halal compliance) ───
model MeatSlaughterLog {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  slaughterNumber String
  liveAnimalId    String?

  animalType    MeatAnimalType
  animalTag     String?
  slaughterDate DateTime       @default(now())
  slaughterTime String?

  slaughterMethod       MeatSlaughterMethod
  slaughteredBy         String?
  slaughtererId         String?
  slaughtererCertNumber String?
  witnessedBy           String?

  liveWeightKg    Float
  dressedWeightKg Float?
  yieldPct        Float?

  facilityName    String?
  facilityLicense String?
  facilityAddress String?

  isHalal            Boolean @default(true)
  halalCertNumber    String?
  religiousAuthority String?

  vetInspection    Boolean           @default(false)
  vetInspectorName String?
  vetCertNumber    String?
  postMortemNotes  String?           @db.Text
  qualityGrade     MeatQualityGrade?

  temperature     Float?
  storageLocation String?

  photoUrls    String[] @default([])
  documentUrls String[] @default([])

  notes       String? @db.Text
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slaughterNumber])
  @@index([tenantId])
  @@index([tenantId, slaughterDate])
  @@index([liveAnimalId])
}

// ─── Cutting Job (from carcass to retail cuts) ───
model MeatCuttingJob {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  jobNumber      String
  slaughterLogId String?
  butcherId      String?
  butcherName    String?

  inputWeightKg  Float
  outputWeightKg Float?
  wasteWeightKg  Float?
  yieldPct       Float?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMin Int?

  status String @default("IN_PROGRESS")

  // Track individual cuts produced
  cutsProduced Json?
  notes        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, jobNumber])
  @@index([tenantId])
  @@index([slaughterLogId])
}

// ─── Weight-based Order (for large/bulk purchases) ───
model MeatWeightOrder {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  orderNumber   String
  customerId    String?
  customerName  String?
  customerPhone String?

  orderDate         DateTime  @default(now())
  neededBy          DateTime?
  scheduledDelivery DateTime?

  status MeatOrderStatus @default(DRAFT)

  // Delivery
  isDelivery       Boolean   @default(false)
  deliveryAddress  String?   @db.Text
  deliveryCharges  Float     @default(0)
  deliveryPersonId String?
  deliveredAt      DateTime?

  // Occasion (Eid ul Adha, Aqeeqa, Walima)
  occasion            String?
  specialInstructions String? @db.Text

  // Financial
  subtotal      Float  @default(0)
  taxAmount     Float  @default(0)
  discount      Float  @default(0)
  total         Float  @default(0)
  paidAmount    Float  @default(0)
  paymentStatus String @default("UNPAID")

  // Preparation
  cuttingStyle    String?
  packagingPref   String?
  numberOfPackets Int?

  createdById        String?
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MeatWeightOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
}

model MeatWeightOrderItem {
  id      String @id @default(uuid())
  orderId String

  productId   String?
  productName String
  cutCategory MeatCutCategory?

  requestedKg Float
  actualKg    Float?
  pricePerKg  Float
  total       Float  @default(0)

  cuttingInstructions String?
  packagingNotes      String?
  displayOrder        Int     @default(0)

  createdAt DateTime @default(now())

  order MeatWeightOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── Meat Delivery / Subscription ───
model MeatSubscription {
  id         String @id @default(uuid())
  tenantId   String
  customerId String

  subscriptionNumber String
  status             MeatSubscriptionStatus @default(ACTIVE)

  frequency  MeatSubscriptionFreq @default(WEEKLY)
  customDays Int[]                @default([])

  startDate        DateTime  @default(now())
  endDate          DateTime?
  nextDeliveryDate DateTime?
  lastDeliveryDate DateTime?

  // Regular order
  standardItems  Json
  totalMonthlyKg Float @default(0)
  discountPct    Float @default(0)

  // Delivery
  deliveryAddress  String  @db.Text
  deliveryTimeSlot String?
  contactPerson    String?
  contactPhone     String?

  // Payment
  billingCycle    String  @default("MONTHLY")
  monthlyEstimate Float   @default(0)
  autoRenew       Boolean @default(true)

  pausedAt           DateTime?
  pauseReason        String?
  cancelledAt        DateTime?
  cancellationReason String?

  totalDeliveries Int   @default(0)
  totalRevenue    Float @default(0)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, subscriptionNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([nextDeliveryDate])
}

