// ─── Room Types (Master) ───
model HotelRoomType {
  id       String @id @default(uuid())
  tenantId String

  code        String
  name        String
  type        RoomType @default(DOUBLE)
  description String?  @db.Text

  // Capacity
  maxAdults    Int @default(2)
  maxChildren  Int @default(0)
  maxOccupancy Int @default(2)

  // Bed
  bedType         BedType @default(DOUBLE_BED)
  bedCount        Int     @default(1)
  extraBedAllowed Boolean @default(false)
  extraBedPrice   Float   @default(0)

  // Size
  sizeSqft Float?
  sizeSqm  Float?

  // Pricing
  basePrice      Float  @default(0)
  weekendPrice   Float?
  peakPrice      Float?
  offSeasonPrice Float?
  hourlyPrice    Float?

  // Amenities
  hasAC         Boolean @default(true)
  hasHeater     Boolean @default(false)
  hasTV         Boolean @default(true)
  hasWifi       Boolean @default(true)
  hasBalcony    Boolean @default(false)
  hasKitchen    Boolean @default(false)
  hasBathtub    Boolean @default(false)
  hasSafe       Boolean @default(false)
  hasMinibar    Boolean @default(false)
  isPetFriendly Boolean @default(false)
  isSmoking     Boolean @default(false)

  amenities String[] @default([])
  imageUrls String[] @default([])

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms HotelRoom[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ─── Individual Rooms ───
model HotelRoom {
  id         String @id @default(uuid())
  tenantId   String
  roomTypeId String

  roomNumber String
  floor      String?
  building   String?
  wing       String?

  status             RoomStatus         @default(AVAILABLE)
  housekeepingStatus HousekeepingStatus @default(CLEAN)

  // Overrides
  customPrice Float?
  customNotes String?

  // Maintenance
  lastCleanedAt    DateTime?
  lastInspectedAt  DateTime?
  maintenanceUntil DateTime?
  maintenanceNotes String?

  // View
  viewType String?
  facing   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomType HotelRoomType @relation(fields: [roomTypeId], references: [id])

  @@unique([tenantId, roomNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([roomTypeId])
}

// ─── Guest Master ───
model HotelGuest {
  id       String @id @default(uuid())
  tenantId String

  guestNumber String
  customerId  String?

  // Personal
  title     String?
  firstName String
  lastName  String?
  fullName  String

  // Contact
  email    String?
  phone    String
  altPhone String?

  // ID
  idType       GuestIdType?
  idNumber     String?
  idExpiryDate DateTime?
  idFrontUrl   String?
  idBackUrl    String?

  // Personal info
  dateOfBirth DateTime?
  gender      String?
  nationality String?
  language    String?

  // Address
  address String? @db.Text
  city    String?
  state   String?
  country String?
  zipCode String?

  // Company (for business guests)
  companyName String?
  designation String?
  gstNumber   String?

  // VIP / Preferences
  isVIP         Boolean @default(false)
  vipLevel      String?
  loyaltyNumber String?
  loyaltyPoints Int     @default(0)

  preferences         Json?
  allergies           String[] @default([])
  dietaryRestrictions String[] @default([])
  specialRequests     String?  @db.Text

  // Blacklist
  isBlacklisted   Boolean @default(false)
  blacklistReason String?

