// ─── CUSTOMER ────────────────────────────────────────────────

model MarketplaceCustomer {
  id              String                  @id @default(cuid())
  phone           String                  @unique
  phoneVerified   Boolean                 @default(false)
  phoneVerifiedAt DateTime?
  email           String?                 @unique
  emailVerified   Boolean                 @default(false)
  isEmailVerified Boolean                 @default(false)
  emailVerifiedAt DateTime?
  passwordHash    String?
  fullName        String
  displayName     String?
  avatarUrl       String?
  dateOfBirth     DateTime?
  gender          CustomerGender?
  authProvider    MarketplaceAuthProvider @default(PHONE_OTP)
  googleId        String?                 @unique
  facebookId      String?                 @unique
  appleId         String?                 @unique

  language String @default("ur")
  timezone String @default("Asia/Karachi")
  currency String @default("PKR")

  loyaltyPoints Int                   @default(0)
  walletBalance Decimal               @default(0) @db.Decimal(12, 2)
  referralCode  String                @unique
  referredById  String?
  referredBy    MarketplaceCustomer?  @relation("CustomerReferrals", fields: [referredById], references: [id])
  referrals     MarketplaceCustomer[] @relation("CustomerReferrals")

  defaultAddressId String?
  lastKnownLat     Float?
  lastKnownLng     Float?
  lastKnownCity    String?

  marketingEmails   Boolean @default(true)
  marketingSms      Boolean @default(true)
  marketingPush     Boolean @default(true)
  marketingWhatsapp Boolean @default(true)

  isActive  Boolean   @default(true)
  isBanned  Boolean   @default(false)
  banReason String?
  bannedAt  DateTime?

  passwordResetToken   String?
  passwordResetExpires DateTime?

  lastLoginAt  DateTime?
  lastActiveAt DateTime?
  registeredIp String?
  deviceInfo   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses        CustomerAddress[]
  savedCards       CustomerSavedCard[]
  otpCodes         CustomerOtpCode[]
  sessions         CustomerSession[]
  loginHistory     CustomerLoginHistory[]
  orders           MarketplaceOrder[]
  cart             MarketplaceCart?
  wishlistItems    WishlistItem[]
  reviews          MarketplaceReview[]
  reviewVotes      ReviewVote[]
  supportTickets   SupportTicket[]
  supportMessages  SupportMessage[]
  bargains         Bargain[]
  bargainMessages  BargainMessage[]
  groupBuyJoins    GroupBuyParticipant[]
  auctionBids      AuctionBid[]
  liveShopViewers  LiveShopViewer[]
  liveShopMessages LiveShopMessage[]
  notifications    CustomerNotification[]
  walletTxns       CustomerWalletTxn[]
  pushTokens       CustomerPushToken[]
  followingShops   CustomerFollowsShop[]
  productViews     ProductView[]
  searchHistory    CustomerSearchHistory[]

