  markup Float @default(0)
  total  Float @default(0)

  sentAt     DateTime?
  receivedAt DateTime?

  status String  @default("PENDING")
  notes  String?

  createdAt DateTime @default(now())

  job WorkshopJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────
// Job payments
// ─────────────────────────────────────────────────────────────
model WorkshopJobPayment {
  id    String @id @default(uuid())
  jobId String

  amount        Float
  paymentMethod String
  reference     String?
  notes         String?
  receivedById  String?
  paidAt        DateTime @default(now())

  createdAt DateTime @default(now())

  job WorkshopJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────
// Status change log
// ─────────────────────────────────────────────────────────────
model WorkshopJobStatusLog {
  id    String @id @default(uuid())
