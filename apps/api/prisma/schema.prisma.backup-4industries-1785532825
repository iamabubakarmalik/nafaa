// ═══════════════════════════════════════════════════════════════
// INDUSTRY: AGRI / FEED / SEEDS / FERTILIZER STORE
// Seeds, fertilizers, pesticides, animal feed, farmer accounts
// ═══════════════════════════════════════════════════════════════

enum AgriCategory {
  SEEDS
  FERTILIZER
  PESTICIDE
  HERBICIDE
  FUNGICIDE
  INSECTICIDE
