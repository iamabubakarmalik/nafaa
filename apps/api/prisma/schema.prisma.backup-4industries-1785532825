// ─── Doctor Profile (extends Staff) ───
model ClinicDoctorProfile {
  id       String @id @default(uuid())
  tenantId String
  staffId  String @unique

  // Identity
  title             String?
  fullName          String
  qualifications    String[]          @default([])
  specialties       ClinicSpecialty[]
  subSpecialty      String?
  yearsOfExperience Int?
  bio               String?           @db.Text
  photoUrl          String?
  signatureUrl      String?

  // Licensing
  pmcNumber      String?
  licenseNumber  String?
  licenseExpiry  DateTime?
  registeredWith String?

  // Consultation
  consultationFee Float  @default(0)
  followUpFee     Float  @default(0)
  followUpDays    Int    @default(7)
  telemedicineFee Float?
  homeVisitFee    Float?
  emergencyFee    Float?

  // Timing
  slotDurationMin  Int  @default(15)
  bufferMin        Int  @default(0)
  maxDailyPatients Int?

  // Availability
  workingDays    Int[]   @default([1, 2, 3, 4, 5, 6])
  workStartTime  String  @default("09:00")
  workEndTime    String  @default("21:00")
  breakStartTime String?
  breakEndTime   String?

  // Business
  commissionPct  Float  @default(0)
  commissionType String @default("PERCENTAGE")

  // Services
  languages           String[] @default(["English", "Urdu"])
  services            String[] @default([])
  proceduresOffered   String[] @default([])
  acceptsTelemedicine Boolean  @default(false)
  acceptsHomeVisit    Boolean  @default(false)
  acceptsEmergency    Boolean  @default(false)

  // Stats
  totalPatients     Int    @default(0)
  totalAppointments Int    @default(0)
  totalRevenue      Float  @default(0)
  avgRating         Float?
  totalReviews      Int    @default(0)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

