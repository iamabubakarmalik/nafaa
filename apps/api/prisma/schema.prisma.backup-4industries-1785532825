  notes      String? @db.Text
  issueFound String? @db.Text

  photoUrls String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, taskNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([roomId])
}

// ─── Rate / Season Plans ───
model HotelRatePlan {
  id       String @id @default(uuid())
  tenantId String

  code        String
  name        String
  description String?

  startDate DateTime
  endDate   DateTime

  // Type
  planType String
  mealPlan MealPlan @default(ROOM_ONLY)

  // Adjustments
  isPercentage Boolean @default(false)
  adjustment   Float   @default(0)

  // Restrictions
  minNights          Int?
  maxNights          Int?
  applicableDays     Int[] @default([])
  advanceBookingDays Int?
  cancellationHours  Int?

  // Room types
  applicableRoomTypeIds String[] @default([])

  // Booking sources
  applicableSources String[] @default([])

