// ─── Service Catalog (what services this business offers) ───
model ServiceCatalog {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  name         String
  code         String?
  description  String?              @db.Text
  category     ServiceCategory      @default(REPAIR)
  businessType ServiceBusinessType?

  // Pricing
  chargeType      ServiceChargeType @default(FIXED)
  baseCharge      Float             @default(0)
  hourlyRate      Float             @default(0)
  visitCharge     Float             @default(0)
  minCharge       Float             @default(0)
  maxCharge       Float?
  emergencyCharge Float             @default(0)
  weekendCharge   Float             @default(0)
  nightCharge     Float             @default(0)
  outOfCityCharge Float             @default(0)

  // Duration
  estimatedDurationMin Int  @default(60)
  minDurationMin       Int?
  maxDurationMin       Int?

  // Required skill/tools
  requiredSkillLevel TechnicianLevel @default(JUNIOR)
  requiredTools      String[]        @default([])
  requiredParts      String[]        @default([])
  requiresLicense    Boolean         @default(false)
  licenseType        String?

  // Warranty on this service
  warrantyDays  Int          @default(0)
  warrantyType  WarrantyType @default(NONE)
  warrantyTerms String?      @db.Text

  // Attributes
  isEmergency       Boolean @default(false)
  isRemoteAvailable Boolean @default(false)
  requiresQuote     Boolean @default(false)
  requiresAdvance   Boolean @default(false)
  advancePct        Float   @default(0)

  // Display
  imageUrl     String?
  imageUrls    String[] @default([])
  videoUrl     String?
  displayOrder Int      @default(0)
  isPopular    Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)

  // Stats
  totalJobs      Int    @default(0)
  totalRevenue   Float  @default(0)
  avgRating      Float?
  avgDurationMin Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, businessType])
}

// ─── Technician Profile (extends existing Staff) ───
model ServiceTechnicianProfile {
  id       String @id @default(uuid())
  tenantId String
  staffId  String @unique

  employeeCode String?
  level        TechnicianLevel  @default(JUNIOR)
  status       TechnicianStatus @default(AVAILABLE)

  // Specialization
  primarySkill    ServiceBusinessType?
  secondarySkills ServiceBusinessType[] @default([])
  certifications  Json?
  experienceYears Int                   @default(0)
  bio             String?               @db.Text
  photoUrl        String?

  // License / CNIC / Docs
  cnicNumber        String?
  licenseNumber     String?
  licenseExpiryDate DateTime?
  drivingLicense    String?
  vehicleAssigned   String?
  vehicleNumber     String?

  // Emergency contact
  emergencyContactName  String?
  emergencyContactPhone String?

  // Service area
  serviceAreas   String[]  @default([])
  homeCity       String?
  currentLat     Float?
  currentLng     Float?
  lastLocationAt DateTime?
  maxTravelKm    Int?

  // Working schedule
  workingDays             Int[]   @default([1, 2, 3, 4, 5, 6])
  workStartTime           String  @default("08:00")
  workEndTime             String  @default("20:00")
  breakStartTime          String?
  breakEndTime            String?
  isAvailableForEmergency Boolean @default(false)
  isAvailableWeekends     Boolean @default(true)
  isAvailableNights       Boolean @default(false)

  // Commission / Salary
  commissionType   String @default("PERCENTAGE")
  commissionPct    Float  @default(0)
  fixedPerJob      Float  @default(0)
  monthlySalary    Float  @default(0)
  performanceBonus Float  @default(0)

  // Rules
  maxDailyJobs     Int?
  maxOngoingJobs   Int  @default(3)
  bookingBufferMin Int  @default(30)

  // Stats
  totalJobs       Int    @default(0)
  completedJobs   Int    @default(0)
  cancelledJobs   Int    @default(0)
  totalRevenue    Float  @default(0)
  totalCommission Float  @default(0)
  avgRating       Float?
  totalReviews    Int    @default(0)
  onTimePct       Float  @default(100)
  completionPct   Float  @default(100)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services ServiceTechnicianSkill[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, primarySkill])
}

// ─── Which services can this technician perform ───
model ServiceTechnicianSkill {
  id           String @id @default(uuid())
  technicianId String
  serviceId    String

  skillLevel     TechnicianLevel @default(JUNIOR)
  isPrimary      Boolean         @default(false)
  customRate     Float?
  customDuration Int?
  certifiedAt    DateTime?
  certifiedBy    String?

  totalJobs Int    @default(0)
  avgRating Float?

  createdAt DateTime @default(now())

  technician ServiceTechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, serviceId])
  @@index([technicianId])
  @@index([serviceId])
}

// ─── Service Job / Ticket (main workflow) ───
model ServiceJob {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  jobNumber    String
  ticketNumber String?

  // Customer
  customerId       String?
  customerName     String?
  customerPhone    String?
  customerAltPhone String?
  customerEmail    String?
  customerType     String  @default("INDIVIDUAL")

  // Job core
  serviceId    String?
  serviceName  String
  category     ServiceCategory      @default(REPAIR)
  businessType ServiceBusinessType?
  priority     ServicePriority      @default(NORMAL)
  status       ServiceJobStatus     @default(ENQUIRY)

  // Problem details
  problemDescription    String        @db.Text
  customerReportedIssue String?       @db.Text
  urgencyReason         String?
  brand                 String?
  modelNumber           String?
  serialNumber          String?
  yearPurchased         Int?
  purchasedFrom         String?
  underWarranty         Boolean       @default(false)
  warrantyType          WarrantyType?
  warrantyExpiryDate    DateTime?
  amcId                 String?

  // Location
  locationType      ServiceLocationType @default(CUSTOMER_HOME)
  serviceAddress    String?             @db.Text
  city              String?
  area              String?
  landmark          String?
  latitude          Float?
  longitude         Float?
  entryInstructions String?

  // Scheduling
  requestedDate     DateTime?
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  preferredTimeSlot String?

  // Actual times
  assignedAt   DateTime?
  dispatchedAt DateTime?
  enRouteAt    DateTime?
  arrivedAt    DateTime?
  startedAt    DateTime?
  pausedAt     DateTime?
  resumedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  // Technician
  primaryTechnicianId    String?
  assistantTechnicianIds String[] @default([])
  supervisorId           String?

  // Charges breakdown
  visitCharge     Float  @default(0)
  labourCharge    Float  @default(0)
  partsCharge     Float  @default(0)
  transportCharge Float  @default(0)
  emergencyCharge Float  @default(0)
  discountAmount  Float  @default(0)
  taxAmount       Float  @default(0)
  totalCharge     Float  @default(0)
  paidAmount      Float  @default(0)
  paymentStatus   String @default("UNPAID")

  // Advance
  advanceRequired  Boolean @default(false)
  advanceAmount    Float   @default(0)
  advanceCollected Float   @default(0)

  // Warranty on THIS job
  jobWarrantyDays       Int       @default(0)
  jobWarrantyExpiryDate DateTime?
  jobWarrantyTerms      String?   @db.Text

  // Return visit
  needsReturnVisit  Boolean   @default(false)
  returnVisitReason String?
  returnVisitDate   DateTime?
  parentJobId       String?

  // Customer signoff
  workCompletionSignatureUrl String?
  customerSatisfaction       String?
  customerRating             Int?
  customerFeedback           String?  @db.Text
  wouldRecommend             Boolean?

  // Photos / Documents
  beforePhotoUrls String[] @default([])
  duringPhotoUrls String[] @default([])
  afterPhotoUrls  String[] @default([])
  documentUrls    String[] @default([])

  // Internal
  technicianNotes    String? @db.Text
  internalNotes      String? @db.Text
  quotedBy           String?
  createdById        String?
  cancellationReason String?

  // Follow-up
  followUpDate  DateTime?
  followUpDone  Boolean   @default(false)
  followUpNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts         ServiceJobPart[]
  timeLog       ServiceJobTimeLog[]
  statusHistory ServiceJobStatusHistory[]

  @@unique([tenantId, jobNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([customerId])
  @@index([primaryTechnicianId])
  @@index([scheduledStart])
}

// ─── Parts used in a job ───
model ServiceJobPart {
  id    String @id @default(uuid())
  jobId String

  productId  String?
  partName   String
  partNumber String?
  brand      String?
  quantity   Float   @default(1)
  unitPrice  Float   @default(0)
  costPrice  Float   @default(0)
  total      Float   @default(0)

  isCustomerSupplied Boolean @default(false)
  isUnderWarranty    Boolean @default(false)
  warrantyDays       Int     @default(0)
  serialNumber       String?
  notes              String?
  displayOrder       Int     @default(0)

  createdAt DateTime @default(now())

  job ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─── Time log (start/pause/resume/finish) ───
model ServiceJobTimeLog {
  id           String   @id @default(uuid())
  jobId        String
  technicianId String?
  action       String
  timestamp    DateTime @default(now())
  latitude     Float?
  longitude    Float?
  notes        String?

  job ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([technicianId])
}

// ─── Status change history ───
model ServiceJobStatusHistory {
  id    String @id @default(uuid())
  jobId String

  fromStatus ServiceJobStatus?
  toStatus   ServiceJobStatus
  changedBy  String?
  changedAt  DateTime          @default(now())
  reason     String?
  notes      String?

  job ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// ─── Quote / Estimate ───
model ServiceQuote {
  id       String @id @default(uuid())
  tenantId String

  quoteNumber   String
  customerId    String?
  customerName  String
  customerPhone String
  customerEmail String?

  serviceId          String?
  serviceName        String
  problemDescription String  @db.Text
  siteVisitRequired  Boolean @default(false)
  siteVisitCompleted Boolean @default(false)

  status QuoteStatus @default(DRAFT)

  // Financial
  labourCharge Float @default(0)
  partsCharge  Float @default(0)
  visitCharge  Float @default(0)
  otherCharges Float @default(0)
  discount     Float @default(0)
  taxAmount    Float @default(0)
  totalAmount  Float @default(0)

  // Line items
  lineItems Json?

  // Validity
  validUntil      DateTime?
  termsConditions String?   @db.Text

  // Response
  sentAt          DateTime?
  respondedAt     DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  convertedJobId  String?

  createdById String?
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
}

// ─── AMC (Annual Maintenance Contract) ───
model ServiceAmc {
  id       String @id @default(uuid())
  tenantId String

  amcNumber     String
  customerId    String?
  customerName  String
  customerPhone String
  customerEmail String?

  type   AmcType   @default(STANDARD)
  status AmcStatus @default(ACTIVE)

  // Coverage
  coveredItems         Json
  coveredServiceTypes  ServiceBusinessType[] @default([])
  numberOfVisits       Int                   @default(4)
  visitsUsed           Int                   @default(0)
  visitsRemaining      Int                   @default(4)
  includesParts        Boolean               @default(false)
  includesLabour       Boolean               @default(true)
  partsCapAmount       Float?
  emergencyIncluded    Boolean               @default(false)
  emergencyDiscountPct Float                 @default(0)

  // Financial
  contractValue       Float
  amountPaid          Float   @default(0)
  paymentMode         String?
  paymentInstallments Int     @default(1)

  // Duration
  startDate          DateTime
  endDate            DateTime
  autoRenew          Boolean  @default(false)
  reminderDaysBefore Int      @default(30)

  // Site
  serviceAddress String  @db.Text
  city           String?
  numberOfSites  Int     @default(1)

  // Contract
  contractDocUrl    String?
  termsConditions   String? @db.Text
  specialConditions String? @db.Text

  // Cancellation
  cancelledAt        DateTime?
  cancellationReason String?
  refundAmount       Float?

  createdById String?
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits ServiceAmcVisit[]

  @@unique([tenantId, amcNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([endDate])
}

// ─── AMC scheduled/completed visits ───
model ServiceAmcVisit {
  id    String @id @default(uuid())
  amcId String

  visitNumber   Int
  scheduledDate DateTime
  completedAt   DateTime?
  technicianId  String?
  serviceJobId  String?

  status             String  @default("SCHEDULED")
  visitType          String  @default("MAINTENANCE")
  checklistCompleted Json?
  workDone           String? @db.Text
  partsReplaced      Json?
  recommendations    String? @db.Text
  customerRating     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amc ServiceAmc @relation(fields: [amcId], references: [id], onDelete: Cascade)

  @@index([amcId])
  @@index([scheduledDate])
}

// ─── Warranty Claims ───
model ServiceWarrantyClaim {
  id       String @id @default(uuid())
  tenantId String

  claimNumber   String
  originalJobId String?
  customerId    String?
  customerName  String
  customerPhone String

  claimType           WarrantyType @default(SERVICE_PROVIDER)
  claimDate           DateTime     @default(now())
  issueDescription    String       @db.Text
  originalServiceDate DateTime?
  warrantyExpiryDate  DateTime?

  status          String    @default("SUBMITTED")
  reviewedBy      String?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  newJobId        String?
  resolutionType  String?
  resolutionNotes String? @db.Text
  costToCompany   Float   @default(0)
  refundAmount    Float   @default(0)

  photoUrls    String[] @default([])
  documentUrls String[] @default([])

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, claimNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

// ─── Customer Service History Profile ───
model ServiceCustomerProfile {
  id         String @id @default(uuid())
  tenantId   String
  customerId String @unique

  // Property details
  propertyType  String?
  propertySize  String?
  ownershipType String?

  // Preferences
  preferredTechnicianId String?
  preferredTimeSlot     String?
  paymentPreference     String?

  // Assets owned (AC, TV, etc.)
  assetsOwned Json?

  // Emergency access
  emergencyAccessInstructions String? @db.Text
  hasSecurityGuard            Boolean @default(false)
  hasPets                     Boolean @default(false)
  petDetails                  String?

  // Access
  gateCode     String?
  buildingName String?
  floorNumber  String?
  flatNumber   String?

  // Contact preference
  preferredContact String  @default("PHONE")
  bestTimeToCall   String?

  // Stats
  totalJobs     Int       @default(0)
  totalSpent    Float     @default(0)
  lastServiceAt DateTime?
  avgRating     Float?
  isVip         Boolean   @default(false)
  hasActiveAmc  Boolean   @default(false)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
}

// ─── Emergency Service Zones (for pricing/dispatch) ───
model ServiceZone {
  id       String @id @default(uuid())
  tenantId String

  name      String
  city      String
  areas     String[] @default([])
  centerLat Float?
  centerLng Float?
  radiusKm  Float?

  travelCharge                Float  @default(0)
  emergencyChargeExtra        Float  @default(0)
  minEmergencyChargeThreshold Float?
  defaultTravelTimeMin        Int    @default(30)

  activeHours       String  @default("24x7")
  isEmergencyServed Boolean @default(true)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

