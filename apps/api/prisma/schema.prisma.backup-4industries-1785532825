model PetProductProfile {
  id        String @id @default(uuid())
  tenantId  String
  productId String @unique

  categoryType PetCategoryType?
  species      PetSpeciesType?
  lifeStage    PetLifeStage     @default(ALL_STAGES)

  brand         String?
  breedSpecific String?

  // Food specific
  weightGrams      Float?
  weightKg         Float?
  packSize         String?
  flavor           String?
  proteinSource    String?
  proteinPct       Float?
  fatPct           Float?
  fiberPct         Float?
  moisturePct      Float?
  ingredients      String? @db.Text
  isGrainFree      Boolean @default(false)
  isOrganic        Boolean @default(false)
  isHypoallergenic Boolean @default(false)

  // Nutritional benefits
  benefits            String[] @default([])
  suitedForBreedSizes String[] @default([])
  suitedForAges       String?

  // Product size (accessories)
  size       String?
  dimensions String?
  color      String?
  material   String?

  // Aquarium specific
  tankCapacityLiters Float?
  tankShape          String?
  filterCapacity     String?
  wattage            String?

  // Medicine specific
  isPrescriptionOnly  Boolean   @default(false)
  activeIngredient    String?
  dosageForm          String?
  dosageStrength      String?
  administrationRoute String?
  storageInstructions String?
  expiryDate          DateTime?
  batchNumber         String?

  // Pricing
  mrp             Float?
  costPrice       Float?
  retailPrice     Float?
  discountedPrice Float?

  // Marketing
  isFeatured   Boolean @default(false)
  isBestSeller Boolean @default(false)
  isNewArrival Boolean @default(false)
  isOnSale     Boolean @default(false)

  totalSold    Int   @default(0)
  totalRevenue Float @default(0)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, categoryType])
  @@index([tenantId, species])
}

model PetLiveAnimal {
  id       String @id @default(uuid())
  tenantId String

  animalNumber String
  species      PetSpeciesType
  breed        String?
  subBreed     String?

  name      String?
  gender    String?
  ageMonths Int?
  color     String?
  weightKg  Float?

  birthDate    DateTime?
  acquiredDate DateTime?
  sourceType   String?
  sourceName   String?

  // Health
  isVaccinated         Boolean @default(false)
  vaccinationDetails   String? @db.Text
  isDewormed           Boolean @default(false)
  dewormingDetails     String?
  hasHealthCertificate Boolean @default(false)
  healthNotes          String? @db.Text
  medicalHistory       Json?

  // Sale info
  status             PetSaleStatus @default(AVAILABLE)
  costPrice          Float?
  askingPrice        Float
  soldPrice          Float?
  soldAt             DateTime?
  soldToCustomerId   String?
  soldToCustomerName String?

  // Care
  currentCage     String?
  feedingSchedule String?
  specialNeeds    String?

  imageUrls String[] @default([])
  videoUrl  String?

  notes      String? @db.Text
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, animalNumber])
  @@index([tenantId])
  @@index([tenantId, species])
  @@index([tenantId, status])
}

model PetGroomingAppointment {
  id       String @id @default(uuid())
  tenantId String

  appointmentNumber String
  customerId        String?
  customerName      String
  customerPhone     String

  petName                String
  petSpecies             PetSpeciesType
  petBreed               String?
  petAgeMonths           Int?
  petWeightKg            Float?
  petTemperament         String?
  petAllergies           String?
  petSpecialInstructions String?        @db.Text

  scheduledDate DateTime
  scheduledSlot String?

  serviceType        PetGroomingServiceType
  additionalServices PetGroomingServiceType[] @default([])
  serviceDescription String?                  @db.Text

  status PetGroomingStatus @default(SCHEDULED)

  groomerId   String?
  groomerName String?

  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  pickedUpAt  DateTime?

  serviceFee        Float
  additionalCharges Float   @default(0)
  discount          Float   @default(0)
  totalFee          Float
  paidAmount        Float   @default(0)
  paymentMethod     String?

  photosBeforeUrls String[] @default([])
  photosAfterUrls  String[] @default([])
  customerRating   Int?
  customerFeedback String?  @db.Text
  groomerNotes     String?  @db.Text

  reminderSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, appointmentNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([groomerId])
  @@index([scheduledDate])
}

model PetGroomer {
  id       String @id @default(uuid())
  tenantId String

  employeeCode String
  name         String
  phone        String
  cnic         String?

  specializations PetSpeciesType[]         @default([])
  serviceTypes    PetGroomingServiceType[] @default([])
  experienceYears Int?
  certifications  String[]                 @default([])

  workingDays   Int[]  @default([1, 2, 3, 4, 5, 6])
  workStartTime String @default("10:00")
  workEndTime   String @default("19:00")

  perServiceRate Float @default(0)
  commissionPct  Float @default(0)

  totalAppointments     Int    @default(0)
  completedAppointments Int    @default(0)
  totalRevenue          Float  @default(0)
  avgRating             Float?

  isActive Boolean @default(true)
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
}

