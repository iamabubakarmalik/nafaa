  @@index([tenantId, status])
  @@index([status, scheduledAt])
  @@map("message_campaigns")
}

model MessageLog {
  id           String           @id @default(cuid())
  campaignId   String?
  campaign     MessageCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenantId     String
  channel      MessageChannel
  toPhone      String?
  toEmail      String?
  customerId   String?
  templateSlug String?
  subject      String?
  body         String?          @db.Text
  status       String
  providerRef  String?
  errorMessage String?
  sentAt       DateTime         @default(now())
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?

  @@index([tenantId, sentAt])
  @@index([customerId])
  @@index([campaignId])
  @@map("message_logs")
}

model Conversation {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shopId             String?
  customerId         String?
