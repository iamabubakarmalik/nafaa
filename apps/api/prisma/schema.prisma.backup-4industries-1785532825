enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
  EMERGENCY
  MATERNITY
  OTHER
}

