// ─── Appointment ───
model ClinicAppointment {
  id       String  @id @default(uuid())
  tenantId String
  shopId   String?

  appointmentNumber String
  tokenNumber       Int?

  patientId String
  doctorId  String

  status         ClinicAppointmentStatus @default(SCHEDULED)
  visitType      ClinicVisitType         @default(FIRST_VISIT)
