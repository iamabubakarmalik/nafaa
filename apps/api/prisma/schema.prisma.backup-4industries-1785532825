  @@index([tenantId])
  @@index([tenantId, date])
  @@index([staffId, date])
}

model StaffLeave {
  id             String      @id @default(uuid())
  tenantId       String
  staffId        String
  type           LeaveType   @default(CASUAL)
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
