# apps/site environment (ARCH section 2). Copy to .env.local for local work.
# Production values: docs/marketing-site/LAUNCH.md.
CMS_API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
SITE_URL=http://localhost:3100
# false on staging: robots.txt disallows everything and X-Robots-Tag: noindex is sent.
SITE_INDEXABLE=false
# Same value as SITE_REVALIDATE_SECRET on the API.
SITE_REVALIDATE_SECRET=
CLOUDINARY_CLOUD_NAME=
# Must equal settings seo.indexNowKey (served at /<key>.txt).
INDEXNOW_KEY=
# Serve the internal /_dev galleries in a production build (staging only).
SITE_DEV_PAGES=false

# Names kept from apps/marketing so the Vercel project variables carry over.
# Settings `analytics` in the CMS wins for GTM and Clarity when it is set.
# NEXT_PUBLIC_SITE_URL is a fallback for SITE_URL.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONV_SIGNUP=
NEXT_PUBLIC_GOOGLE_ADS_CONV_LEAD=
NEXT_PUBLIC_GOOGLE_ADS_CONV_DEMO=
NEXT_PUBLIC_GOOGLE_ADS_CONV_PURCHASE=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=
# Fallback when settings `site.whatsapp` is empty.
NEXT_PUBLIC_WHATSAPP=
