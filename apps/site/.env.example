# apps/site environment (ARCH section 2). Copy to .env.local for local work.
CMS_API_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
SITE_URL=http://localhost:3100
# false on staging: robots.txt disallows everything and X-Robots-Tag: noindex is sent.
SITE_INDEXABLE=false
SITE_REVALIDATE_SECRET=
CLOUDINARY_CLOUD_NAME=
# Serve the internal /_dev galleries in a production build (staging only).
SITE_DEV_PAGES=false
