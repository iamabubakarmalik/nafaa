  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "typescript": "~5.9.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      },
      "nativeModuleVersionMismatchCheck": {
        "enabled": false
      }
    }
  },
  "packageManager": "pnpm@11.0.8"
}
