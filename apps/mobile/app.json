{
  "expo": {
    "name": "Nafaa POS",
    "slug": "nafaa",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": ["nafaa", "com.nafaa.app"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#16a34a",
    "description": "Pakistan's smart POS \u2014 Sales, inventory, khata, and reports in one app.",
    "updates": {
      "url": "https://u.expo.dev/378f6d14-5716-469e-9275-0af06ec03668",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nafaa.app",
      "usesAppleSignIn": true,
      "buildNumber": "6",
      "infoPlist": {
        "NSCameraUsageDescription": "Nafaa uses the camera to scan product barcodes and to take product photos.",
        "NSPhotoLibraryUsageDescription": "Nafaa needs access to your photos so you can choose pictures for products and your shop logo.",
        "NSFaceIDUsageDescription": "Nafaa uses Face ID to unlock the app quickly and securely.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Nafaa uses your location only when an order booker checks in at a customer's shop visit."
      },
      "associatedDomains": [
        "applinks:nafaa.pk"
      ],
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.nafaa.app",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "USE_BIOMETRIC",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_FINGERPRINT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nafaa.pk"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16a34a",
          "dark": {
            "backgroundColor": "#16a34a"
          },
          "imageWidth": 1,
          "image": "./assets/splash-blank.png"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Nafaa uses the camera to scan product barcodes and to take product photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Nafaa uses Face ID to unlock the app quickly and securely."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#16a34a",
          "icon": "./assets/notification-icon.png",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/cash.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/alert.wav"
          ]
        }
      ],
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBCrashlytics"
            ]
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nafaa uses your location only when an order booker checks in at a customer's shop visit.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nafaa needs access to your photos so you can choose pictures for products and your shop logo.",
          "cameraPermission": "Nafaa uses the camera to scan product barcodes and to take product photos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "378f6d14-5716-469e-9275-0af06ec03668"
      },
      "googleIosClientId": "109272166338-4fic8s75hh9e7otuvjgtaj1q02s8vp26.apps.googleusercontent.com",
      "googleAndroidClientId": "109272166338-j3miqlc4kn1441l24dgd8tv1fphkid1k.apps.googleusercontent.com",
      "googleWebClientId": "109272166338-vnd7gh3vnjds2m3gt5i2psnsanav06ep.apps.googleusercontent.com"
    },
    "owner": "abubakamalik"
  }
}
