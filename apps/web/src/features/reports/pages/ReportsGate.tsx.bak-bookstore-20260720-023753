import { lazy, Suspense } from 'react';
import { useCurrentIndustry } from '@/features/industries/_shared/registry/useCurrentIndustry';
import ReportsPage from './ReportsPage';

const RestaurantReports = lazy(() => import('@/features/industries/restaurant/pages/RestaurantReportsV2'));
const MobileReports = lazy(() => import('@/features/industries/mobile/pages/MobileReportsV2'));
const CarpetReports = lazy(() => import('@/features/industries/carpet/pages/CarpetReportsV2'));
const RetailReports = lazy(() => import('@/features/industries/retail/pages/RetailReportsV2'));
const MeatReports = lazy(() => import('@/features/industries/meat/pages/MeatReportsV2'));

function Loader() {
  return (
    <div className="flex items-center justify-center py-24">
      <div className="h-12 w-12 rounded-full border-4 border-violet-200 border-t-violet-600 animate-spin" />
    </div>
  );
}

export default function ReportsGate() {
  const industry = useCurrentIndustry();

  if (industry?.id === 'restaurant') return <Suspense fallback={<Loader />}><RestaurantReports /></Suspense>;
  if (industry?.id === 'mobile') return <Suspense fallback={<Loader />}><MobileReports /></Suspense>;
  if (industry?.id === 'carpet') return <Suspense fallback={<Loader />}><CarpetReports /></Suspense>;
  if (industry?.id === 'retail') return <Suspense fallback={<Loader />}><RetailReports /></Suspense>;
  if (industry?.id === 'meat') return <Suspense fallback={<Loader />}><MeatReports /></Suspense>;
  return <ReportsPage />;
}
