import { Navigate, useParams } from 'react-router-dom';
import { useCurrentIndustry } from '@/features/industries/_shared/registry/useCurrentIndustry';

/**
 * ProductViewGate — when a user hits /products/:id, route them to the
 * industry-appropriate view page.
 *
 *   • Carpet → /carpet-products/:id (detail view)
 *   • Mobile → /mobile-products/:id/edit (wizard edit) — detail page TBD
 *   • Others → /products/:id/edit (standard edit form)
 */
export default function ProductViewGate() {
  const industry = useCurrentIndustry();
  const { id } = useParams();

  if (!id) return <Navigate to="/products" replace />;

  if (industry?.id === 'carpet') {
    return <Navigate to={`/carpet-products/${id}`} replace />;
  }

  if (industry?.id === 'mobile') {
    return <Navigate to={`/mobile-products/${id}/edit`} replace />;
  }

  return <Navigate to={`/products/${id}/edit`} replace />;
}
