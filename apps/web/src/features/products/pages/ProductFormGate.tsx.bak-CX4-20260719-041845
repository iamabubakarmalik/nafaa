import { Navigate, useParams } from 'react-router-dom';
import { useCurrentIndustry } from '@/features/industries/_shared/registry/useCurrentIndustry';
import ProductFormPage from './ProductFormPage';

/**
 * ProductFormGate — decides whether to render the generic ProductFormPage
 * or route the user into an industry-specific wizard.
 *
 * Carpet tenants get redirected to /carpet-products/new (or /:id/edit)
 * so they use the friendly wizard instead of the raw multi-tab form.
 *
 * Other industries fall through to the standard form for now — until
 * their own wizards ship.
 */
export default function ProductFormGate() {
  const industry = useCurrentIndustry();
  const { id } = useParams();

  if (industry?.id === 'carpet') {
    return (
      <Navigate
        to={id ? `/carpet-products/${id}/edit` : '/carpet-products/new'}
        replace
      />
    );
  }

  return <ProductFormPage />;
}
