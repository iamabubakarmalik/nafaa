import { lazy, Suspense } from 'react';
import { useCurrentIndustry } from '@/features/industries/_shared/registry/useCurrentIndustry';
import DashboardPage from './DashboardPage';

const RestaurantDashboard = lazy(() => import('@/features/industries/restaurant/pages/RestaurantDashboardV2'));
const MobileDashboard = lazy(() => import('@/features/industries/mobile/pages/MobileDashboardV2'));
const CarpetDashboard = lazy(() => import('@/features/industries/carpet/pages/CarpetDashboardV2'));
const RetailDashboard = lazy(() => import('@/features/industries/retail/pages/RetailDashboardV2'));

function Loader() {
  return (
    <div className="flex items-center justify-center py-24">
      <div className="h-12 w-12 rounded-full border-4 border-emerald-200 border-t-emerald-600 animate-spin" />
    </div>
  );
}

/**
 * DashboardGate — routes / (dashboard) to the industry-specific dashboard.
 *
 *   • Restaurant → RestaurantDashboardV2 (tables, KOT, orders-by-mode)
 *   • Mobile     → MobileDashboardV2 (IMEI stats, EMI, repairs)
 *   • Carpet     → CarpetDashboardV2 (rolls, cut pieces, sqft)
 *   • Retail     → RetailDashboardV2 (combos, quick keys, damage)
 *   • Others     → generic DashboardPage (existing)
 */
export default function DashboardGate() {
  const industry = useCurrentIndustry();

  if (industry?.id === 'restaurant') {
    return <Suspense fallback={<Loader />}><RestaurantDashboard /></Suspense>;
  }
  if (industry?.id === 'mobile') {
    return <Suspense fallback={<Loader />}><MobileDashboard /></Suspense>;
  }
  if (industry?.id === 'carpet') {
    return <Suspense fallback={<Loader />}><CarpetDashboard /></Suspense>;
  }
  if (industry?.id === 'retail') {
    return <Suspense fallback={<Loader />}><RetailDashboard /></Suspense>;
  }
  return <DashboardPage />;
}
