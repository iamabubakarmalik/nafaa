import { lazy, Suspense } from 'react';
import { useCurrentIndustry } from '@/features/industries/_shared/registry/useCurrentIndustry';
import PosPage from './PosPage';

const RestaurantPosPage = lazy(() => import('@/features/industries/restaurant/pages/RestaurantPosPage'));
const MobilePosPage = lazy(() => import('@/features/industries/mobile/pages/MobilePosPage'));
const CarpetPosPage = lazy(() => import('@/features/industries/carpet/pages/CarpetPosPage'));
const AgriPosPage = lazy(() => import('@/features/industries/agri/pages/AgriPosPage'));

function Loader() {
  return (
    <div className="flex items-center justify-center py-24">
      <div className="h-12 w-12 rounded-full border-4 border-emerald-200 border-t-emerald-600 animate-spin" />
    </div>
  );
}

export default function PosGate() {
  const industry = useCurrentIndustry();

  if (industry?.id === 'restaurant') return <Suspense fallback={<Loader />}><RestaurantPosPage /></Suspense>;
  if (industry?.id === 'mobile') return <Suspense fallback={<Loader />}><MobilePosPage /></Suspense>;
  if (industry?.id === 'carpet') return <Suspense fallback={<Loader />}><CarpetPosPage /></Suspense>;
  if (industry?.id === 'agri') return <Suspense fallback={<Loader />}><AgriPosPage /></Suspense>;

  return <PosPage />;
}
