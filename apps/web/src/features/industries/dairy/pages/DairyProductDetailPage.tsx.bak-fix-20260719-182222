import { useMemo } from 'react';
import { Link, useNavigate, useParams } from 'react-router-dom';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import {
  ArrowLeft, Edit3, Milk, Beaker, Truck, TrendingUp, Award,
  Sunrise, Sunset, Home, Package, Hash, Tag, Star, Snowflake,
  DollarSign, Receipt, ShoppingCart, ChevronRight, ExternalLink,
  Trash2, Eye, Image as ImageIcon, Calendar, Clock, Thermometer,
  Leaf, ShieldCheck, Droplets, Warehouse,
} from 'lucide-react';
import { toast } from 'sonner';
import { formatPKR, formatPKRFull } from '@/lib/format';
import { productsApi } from '@/api/products.api';
import { productImagesApi } from '@/api/product-images.api';
import { salesApi } from '@/api/sales.api';
import { dairyProductsApi } from '../api/products.api';

const QUALITY_COLORS: Record<string, string> = {
  A_GRADE: 'bg-emerald-100 text-emerald-700 border-emerald-300',
  B_GRADE: 'bg-blue-100 text-blue-700 border-blue-300',
  C_GRADE: 'bg-amber-100 text-amber-700 border-amber-300',
  REJECTED: 'bg-red-100 text-red-700 border-red-300',
};

export default function DairyProductDetailPage() {
  const { id } = useParams();
  const navigate = useNavigate();
  const queryClient = useQueryClient();

  const { data: product, isLoading } = useQuery({
    queryKey: ['product', id],
    queryFn: () => productsApi.getOne(id!),
    enabled: !!id,
  });

  const { data: images = [] } = useQuery({
    queryKey: ['product-images', id],
    queryFn: () => productImagesApi.list(id!),
    enabled: !!id,
  });

  const { data: dairyProfile } = useQuery({
    queryKey: ['dairy-profile', id],
    queryFn: () => dairyProductsApi.byProduct(id!),
    enabled: !!id,
  });

  const { data: allSales = [] } = useQuery({
    queryKey: ['sales-list-for-product'],
    queryFn: () => salesApi.list(),
    enabled: !!id,
  });

  const salesForProduct = useMemo(() => {
    if (!id) return [];
    return allSales.filter((s) => s.items.some((it) => it.productId === id)).slice(0, 20);
  }, [allSales, id]);

  const removeMutation = useMutation({
    mutationFn: () => productsApi.remove(id!),
    onSuccess: (data: any) => {
      toast.success(data?.softDeleted ? 'Product deactivated' : 'Product deleted');
      queryClient.invalidateQueries({ queryKey: ['products'] });
      navigate('/dairy/products');
    },
    onError: (e: any) => toast.error(e?.response?.data?.message || 'Delete failed'),
  });

  const stats = useMemo(() => {
    const soldItems = allSales.flatMap((s) =>
      s.items.filter((it) => it.productId === id).map((it) => ({ ...it, sale: s })),
    );
    const totalSold = soldItems.reduce((a, it) => a + Number(it.quantity || 0), 0);
    const totalRevenue = soldItems.reduce((a, it) => a + Number(it.total || 0), 0);
    const totalOrders = new Set(soldItems.map((it) => it.sale.id)).size;
    return { totalSold, totalRevenue, totalOrders };
  }, [allSales, id]);

  if (isLoading || !product) {
    return (
      <div className="flex items-center justify-center py-24">
        <div className="h-12 w-12 rounded-full border-4 border-fuchsia-200 border-t-fuchsia-600 animate-spin" />
      </div>
    );
  }

  const qualityBadges: Array<{ label: string; color: string; icon: any }> = [];
  if (dairyProfile?.isPasteurized) qualityBadges.push({ label: 'Pasteurized', color: 'bg-blue-100 text-blue-700', icon: ShieldCheck });
  if (dairyProfile?.isHomogenized) qualityBadges.push({ label: 'Homogenized', color: 'bg-cyan-100 text-cyan-700', icon: Snowflake });
  if (dairyProfile?.isRaw) qualityBadges.push({ label: 'Raw', color: 'bg-amber-100 text-amber-700', icon: Droplets });
  if (dairyProfile?.isOrganic) qualityBadges.push({ label: 'Organic', color: 'bg-green-100 text-green-700', icon: Leaf });
  if (dairyProfile?.isFresh) qualityBadges.push({ label: 'Fresh', color: 'bg-sky-100 text-sky-700', icon: Snowflake });

  return (
    <div className="space-y-5 pb-8">
      <div className="flex items-center justify-between gap-3 flex-wrap">
        <button
          onClick={() => navigate('/dairy/products')}
          className="inline-flex items-center gap-2 text-sm text-slate-600 hover:text-fuchsia-600 font-bold transition"
        >
          <ArrowLeft className="h-4 w-4" /> Back to Catalog
        </button>
        <div className="flex items-center gap-2 flex-wrap">
          <Link
            to={`/dairy-products/${id}/edit`}
            className="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-fuchsia-50 border-2 border-fuchsia-200 hover:bg-fuchsia-100 text-fuchsia-700 text-sm font-extrabold transition"
          >
            <Edit3 className="h-4 w-4" /> Edit
          </Link>
          <Link
            to="/catalog"
            target="_blank"
            className="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-emerald-50 border-2 border-emerald-200 hover:bg-emerald-100 text-emerald-700 text-sm font-extrabold transition"
          >
            <ExternalLink className="h-4 w-4" /> Catalog
          </Link>
          <button
            onClick={() => { if (confirm(`Delete "${product.name}"?`)) removeMutation.mutate(); }}
            className="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-rose-50 border-2 border-rose-200 hover:bg-rose-100 text-rose-700 text-sm font-extrabold transition"
          >
            <Trash2 className="h-4 w-4" /> Delete
          </button>
        </div>
      </div>

      {/* HERO */}
      <section className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-fuchsia-900 to-pink-700 text-white shadow-2xl">
        <div className="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-fuchsia-400/20 blur-3xl" />
        <div className="absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-pink-400/15 blur-3xl" />

        <div className="relative grid lg:grid-cols-[280px_1fr] gap-6 p-6">
          <div className="relative aspect-square rounded-2xl overflow-hidden bg-white/10 backdrop-blur border-2 border-white/20 shrink-0">
            {images[0]?.url ? (
              <img src={images[0].url} alt={product.name} className="w-full h-full object-cover" />
            ) : (
              <div className="w-full h-full flex items-center justify-center text-white/50">
                <Milk className="h-16 w-16" />
              </div>
            )}
            {dairyProfile?.isBestSeller && (
              <div className="absolute top-3 right-3 px-2 py-1 rounded-lg bg-emerald-500 text-white text-[10px] font-extrabold shadow-lg inline-flex items-center gap-1">
                <TrendingUp className="h-3 w-3" /> BEST SELLER
              </div>
            )}
            {product.isFeatured && (
              <div className="absolute top-12 right-3 px-2 py-1 rounded-lg bg-amber-500 text-white text-[10px] font-extrabold shadow-lg inline-flex items-center gap-1">
                <Star className="h-3 w-3 fill-white" /> FEATURED
              </div>
            )}
            {!product.isActive && (
              <div className="absolute inset-x-0 bottom-0 py-1.5 bg-rose-600 text-white text-center text-xs font-extrabold">
                INACTIVE
              </div>
            )}
          </div>

          <div className="min-w-0">
            <div className="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur px-3 py-1 text-xs font-extrabold border border-white/20">
              <Milk className="h-3.5 w-3.5 text-amber-300" />
              Dairy Product
              {dairyProfile?.productType && (
                <>
                  <span className="text-white/40">•</span>
                  <span>{dairyProfile.productType.replace('_', ' ')}</span>
                </>
              )}
            </div>
            <h1 className="mt-3 text-3xl sm:text-4xl font-extrabold leading-tight">{product.name}</h1>
            {product.description && (
              <p className="mt-2 text-sm text-white/85 max-w-2xl">{product.description}</p>
            )}

            <div className="mt-3 flex items-center gap-3 flex-wrap text-xs">
              {product.sku && (
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white/10 backdrop-blur font-mono">
                  <Hash className="h-3 w-3" /> {product.sku}
                </span>
              )}
              {dairyProfile?.cattleType && (
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-500/30 border border-amber-300/40 font-bold">
                  {dairyProfile.cattleType === 'Buffalo' ? '🐃' : dairyProfile.cattleType === 'Cow' ? '🐄' : '🐐'} {dairyProfile.cattleType}
                </span>
              )}
              {dairyProfile?.quality && (
                <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-md border font-bold ${QUALITY_COLORS[dairyProfile.quality] || ''}`}>
                  <Award className="h-3 w-3" /> {dairyProfile.quality.replace('_', ' ')}
                </span>
              )}
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-5">
              <HeroStat icon={Package} label="Stock" value={product.stock} sub={product.unit} tone="cyan" />
              <HeroStat icon={Beaker} label="Fat" value={dairyProfile?.fatContent ? `${dairyProfile.fatContent}%` : '—'} tone="amber" />
              <HeroStat icon={Receipt} label="Sold" value={stats.totalSold} sub={`${stats.totalOrders} orders`} tone="violet" />
              <HeroStat icon={TrendingUp} label="Revenue" value={formatPKR(stats.totalRevenue)} tone="emerald" />
            </div>

            <div className="mt-5 flex items-center gap-4 flex-wrap">
              <div>
                <div className="text-[10px] uppercase font-extrabold text-white/70 tracking-wider">Sale Price</div>
                <div className="text-3xl font-extrabold tabular-nums leading-none mt-1">
                  {formatPKRFull(product.price)}
                  <span className="text-sm font-bold text-white/70 ml-1">/ {product.unit}</span>
                </div>
              </div>
              {product.costPrice > 0 && (
                <div>
                  <div className="text-[10px] uppercase font-extrabold text-white/70 tracking-wider">Cost</div>
                  <div className="text-xl font-extrabold tabular-nums text-white/80 leading-none mt-1">
                    {formatPKRFull(product.costPrice)}
                  </div>
                </div>
              )}
              {dairyProfile?.homeDeliveryPrice && (
                <div>
                  <div className="text-[10px] uppercase font-extrabold text-white/70 tracking-wider">Home Delivery</div>
                  <div className="text-xl font-extrabold tabular-nums text-fuchsia-300 leading-none mt-1">
                    {formatPKRFull(dairyProfile.homeDeliveryPrice)}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>

      {/* Quality Badges */}
      {qualityBadges.length > 0 && (
        <section className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm p-5">
          <div className="flex items-center gap-3 mb-3">
            <div className="h-10 w-10 rounded-xl bg-gradient-to-br from-emerald-500 to-green-700 text-white flex items-center justify-center shadow-md">
              <Award className="h-5 w-5" />
            </div>
            <div>
              <h3 className="font-extrabold text-slate-900 text-lg leading-tight">Quality Certifications</h3>
              <p className="text-xs text-slate-500 font-semibold">{qualityBadges.length} attributes</p>
            </div>
          </div>
          <div className="flex flex-wrap gap-2">
            {qualityBadges.map((b) => {
              const Icon = b.icon;
              return (
                <span key={b.label} className={`inline-flex items-center gap-2 px-3 py-2 rounded-xl border-2 border-transparent text-sm font-extrabold ${b.color}`}>
                  <Icon className="h-4 w-4" />
                  {b.label}
                </span>
              );
            })}
          </div>
        </section>
      )}

      {/* Composition */}
      {dairyProfile && (dairyProfile.fatContent || dairyProfile.snfContent || dairyProfile.proteinContent) && (
        <section className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm p-5">
          <div className="flex items-center gap-3 mb-4">
            <div className="h-10 w-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-700 text-white flex items-center justify-center shadow-md">
              <Beaker className="h-5 w-5" />
            </div>
            <div>
              <h3 className="font-extrabold text-slate-900 text-lg leading-tight">Composition Analysis</h3>
              <p className="text-xs text-slate-500 font-semibold">Nutritional content</p>
            </div>
          </div>

          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {dairyProfile.fatContent && (
              <div className="rounded-xl bg-amber-50 border-2 border-amber-200 p-4 text-center">
                <div className="text-[10px] uppercase font-extrabold text-amber-700">Fat</div>
                <div className="text-3xl font-extrabold text-amber-900 tabular-nums">{dairyProfile.fatContent}%</div>
              </div>
            )}
            {dairyProfile.snfContent && (
              <div className="rounded-xl bg-blue-50 border-2 border-blue-200 p-4 text-center">
                <div className="text-[10px] uppercase font-extrabold text-blue-700">SNF</div>
                <div className="text-3xl font-extrabold text-blue-900 tabular-nums">{dairyProfile.snfContent}%</div>
              </div>
            )}
            {dairyProfile.proteinContent && (
              <div className="rounded-xl bg-emerald-50 border-2 border-emerald-200 p-4 text-center">
                <div className="text-[10px] uppercase font-extrabold text-emerald-700">Protein</div>
                <div className="text-3xl font-extrabold text-emerald-900 tabular-nums">{dairyProfile.proteinContent}%</div>
              </div>
            )}
            {dairyProfile.waterAdded && (
              <div className="rounded-xl bg-red-50 border-2 border-red-200 p-4 text-center">
                <div className="text-[10px] uppercase font-extrabold text-red-700">⚠️ Water Added</div>
                <div className="text-sm font-extrabold text-red-900 mt-2">Yes</div>
              </div>
            )}
          </div>
        </section>
      )}

      {/* Storage & Shelf Life */}
      {dairyProfile?.requiresRefrigeration && (
        <section className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm p-5">
          <div className="flex items-center gap-3 mb-3">
            <div className="h-10 w-10 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-700 text-white flex items-center justify-center shadow-md">
              <Thermometer className="h-5 w-5" />
            </div>
            <div>
              <h3 className="font-extrabold text-slate-900 text-lg leading-tight">Storage Requirements</h3>
              <p className="text-xs text-slate-500 font-semibold">Cold chain info</p>
            </div>
          </div>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div className="rounded-xl bg-cyan-50 border-2 border-cyan-200 p-3 text-center">
              <div className="text-[10px] uppercase font-extrabold text-cyan-700">Temp Range</div>
              <div className="text-lg font-extrabold text-cyan-900 tabular-nums mt-1">
                {dairyProfile.storageTempMin || 2}°C – {dairyProfile.storageTempMax || 8}°C
              </div>
            </div>
            {dairyProfile.bestBeforeHours && (
              <div className="rounded-xl bg-emerald-50 border-2 border-emerald-200 p-3 text-center">
                <div className="text-[10px] uppercase font-extrabold text-emerald-700">Best Before</div>
                <div className="text-lg font-extrabold text-emerald-900 tabular-nums mt-1">{dairyProfile.bestBeforeHours}h</div>
              </div>
            )}
            {dairyProfile.shelfLifeHours && (
              <div className="rounded-xl bg-amber-50 border-2 border-amber-200 p-3 text-center">
                <div className="text-[10px] uppercase font-extrabold text-amber-700">Shelf Life</div>
                <div className="text-lg font-extrabold text-amber-900 tabular-nums mt-1">{dairyProfile.shelfLifeHours}h</div>
              </div>
            )}
            {dairyProfile.productionDate && (
              <div className="rounded-xl bg-violet-50 border-2 border-violet-200 p-3 text-center">
                <div className="text-[10px] uppercase font-extrabold text-violet-700">Produced</div>
                <div className="text-sm font-extrabold text-violet-900 mt-1">
                  {new Date(dairyProfile.productionDate).toLocaleDateString('en-PK', { day: '2-digit', month: 'short' })}
                </div>
              </div>
            )}
          </div>
        </section>
      )}

      {/* Availability & Pricing */}
      <section className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm p-5">
        <div className="flex items-center gap-3 mb-4">
          <div className="h-10 w-10 rounded-xl bg-gradient-to-br from-fuchsia-500 to-pink-700 text-white flex items-center justify-center shadow-md">
            <Truck className="h-5 w-5" />
          </div>
          <div>
            <h3 className="font-extrabold text-slate-900 text-lg leading-tight">Availability & Pricing</h3>
            <p className="text-xs text-slate-500 font-semibold">Slot-based & bulk rates</p>
          </div>
        </div>

        <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {dairyProfile?.availableMorning && (
            <div className="rounded-xl bg-amber-50 border-2 border-amber-200 p-4">
              <div className="flex items-center gap-2 mb-2">
                <Sunrise className="h-5 w-5 text-amber-600" />
                <div className="font-extrabold text-amber-900">🌅 Morning</div>
              </div>
              {dairyProfile.morningPrice ? (
                <div className="text-2xl font-extrabold text-amber-900 tabular-nums">{formatPKRFull(dairyProfile.morningPrice)}</div>
              ) : (
                <div className="text-sm text-amber-700 font-bold">Base rate: {formatPKRFull(product.price)}</div>
              )}
            </div>
          )}
          {dairyProfile?.availableEvening && (
            <div className="rounded-xl bg-indigo-50 border-2 border-indigo-200 p-4">
              <div className="flex items-center gap-2 mb-2">
                <Sunset className="h-5 w-5 text-indigo-600" />
                <div className="font-extrabold text-indigo-900">🌆 Evening</div>
              </div>
              {dairyProfile.eveningPrice ? (
                <div className="text-2xl font-extrabold text-indigo-900 tabular-nums">{formatPKRFull(dairyProfile.eveningPrice)}</div>
              ) : (
                <div className="text-sm text-indigo-700 font-bold">Base rate: {formatPKRFull(product.price)}</div>
              )}
            </div>
          )}
          {dairyProfile?.homeDeliveryAvailable && dairyProfile.homeDeliveryPrice && (
            <div className="rounded-xl bg-violet-50 border-2 border-violet-200 p-4">
              <div className="flex items-center gap-2 mb-2">
                <Home className="h-5 w-5 text-violet-600" />
                <div className="font-extrabold text-violet-900">🏠 Home Delivery</div>
              </div>
              <div className="text-2xl font-extrabold text-violet-900 tabular-nums">{formatPKRFull(dairyProfile.homeDeliveryPrice)}</div>
            </div>
          )}
          {dairyProfile?.bulkPrice && dairyProfile.minBulkQty && (
            <div className="rounded-xl bg-emerald-50 border-2 border-emerald-200 p-4 sm:col-span-2 lg:col-span-3">
              <div className="flex items-center gap-2 mb-2">
                <Warehouse className="h-5 w-5 text-emerald-600" />
                <div className="font-extrabold text-emerald-900">📦 Bulk Deal</div>
              </div>
              <div className="text-sm font-bold text-emerald-800">
                Order <strong>{dairyProfile.minBulkQty}+ {product.unit}</strong> @ <strong>{formatPKRFull(dairyProfile.bulkPrice)}</strong> each
                <span className="ml-2 text-xs text-emerald-600">
                  (save {formatPKRFull(product.price - dairyProfile.bulkPrice)}/unit)
                </span>
              </div>
            </div>
          )}
        </div>
      </section>

      {/* Sales History */}
      <section className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm overflow-hidden">
        <div className="px-5 py-4 border-b-2 border-slate-100 flex items-center gap-3">
          <div className="h-10 w-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex items-center justify-center shadow-md">
            <Receipt className="h-5 w-5" />
          </div>
          <div>
            <h3 className="font-extrabold text-slate-900 text-lg leading-tight">Sales History</h3>
            <p className="text-xs text-slate-500 font-semibold">
              {salesForProduct.length} recent • {stats.totalSold} {product.unit} sold
            </p>
          </div>
        </div>

        {salesForProduct.length === 0 ? (
          <div className="p-10 text-center">
            <Receipt className="h-12 w-12 text-slate-300 mx-auto mb-2" />
            <div className="font-extrabold text-slate-700">Abhi tak koi sale nahi</div>
          </div>
        ) : (
          <div className="divide-y divide-slate-100">
            {salesForProduct.map((s) => {
              const productLines = s.items.filter((it) => it.productId === id);
              const qty = productLines.reduce((a, it) => a + Number(it.quantity || 0), 0);
              const revenue = productLines.reduce((a, it) => a + Number(it.total || 0), 0);
              return (
                <Link key={s.id} to={`/sales/${s.id}/receipt`} className="block px-5 py-3 hover:bg-slate-50/50 transition">
                  <div className="flex items-center justify-between gap-3">
                    <div className="min-w-0 flex-1">
                      <div className="flex items-center gap-2">
                        <div className="font-mono font-extrabold text-sm text-slate-900">{s.saleNumber}</div>
                        <span className="text-[10px] text-slate-500 font-bold">
                          {new Date(s.soldAt).toLocaleDateString('en-PK', { day: '2-digit', month: 'short', year: 'numeric' })}
                        </span>
                      </div>
                      <div className="text-xs text-slate-600 font-semibold mt-0.5">
                        {s.customer?.name || 'Walk-in'} • {qty} {product.unit}
                      </div>
                    </div>
                    <div className="text-right shrink-0">
                      <div className="font-extrabold text-emerald-700 tabular-nums">{formatPKRFull(revenue)}</div>
                    </div>
                  </div>
                </Link>
              );
            })}
          </div>
        )}
      </section>
    </div>
  );
}

function HeroStat({ icon: Icon, label, value, sub, tone }: any) {
  const tones: Record<string, string> = {
    emerald: 'from-emerald-400/30 to-emerald-600/20 border-emerald-300/40',
    cyan: 'from-cyan-400/30 to-cyan-600/20 border-cyan-300/40',
    amber: 'from-amber-400/30 to-amber-600/20 border-amber-300/40',
    violet: 'from-violet-400/30 to-violet-600/20 border-violet-300/40',
  };
  return (
    <div className={`rounded-xl bg-gradient-to-br ${tones[tone]} backdrop-blur border p-3`}>
      <div className="flex items-center gap-1.5 mb-1">
        <Icon className="h-3 w-3 opacity-80" />
        <div className="text-[9px] uppercase tracking-wider font-extrabold opacity-90">{label}</div>
      </div>
      <div className="text-xl font-extrabold text-white tabular-nums leading-none">{value}</div>
      {sub && <div className="text-[10px] font-bold text-white/70 mt-0.5">{sub}</div>}
    </div>
  );
}
