import type { ComponentType, ReactNode } from 'react';
import { useCurrentIndustry } from '../registry/useCurrentIndustry';
import type { IndustryPack } from '../types/industry-pack';

type SlotPath = (pack: IndustryPack) => ComponentType<any> | undefined;

interface IndustrySlotProps {
  /**
   * Function that extracts a component from the industry pack.
   * Example: `(pack) => pack.pos?.modeBar`
   */
  slot: SlotPath;
  /** Props to pass to the slot component when rendered */
  slotProps?: Record<string, any>;
  /** Fallback rendered when no pack or no slot component */
  fallback?: ReactNode;
  /** Optional wrapper — receives the rendered slot (or fallback) as children */
  wrapper?: ComponentType<{ children: ReactNode }>;
}

/**
 * Renders a component contributed by the active industry pack.
 * If no pack is active or the pack doesn't contribute this slot,
 * renders `fallback` (or nothing).
 *
 * This keeps core pages clean — they declare where extensions can go,
 * and industry packs fill them in.
 *
 * Example:
 *   // In core POS page:
 *   <IndustrySlot
 *     slot={(pack) => pack.pos?.modeBar}
 *   />
 *
 *   // In product form:
 *   <IndustrySlot
 *     slot={(pack) => pack.productForm?.extraFields}
 *     slotProps={{ product, onChange: handleChange }}
 *     fallback={null}
 *   />
 */
export function IndustrySlot({
  slot,
  slotProps,
  fallback = null,
  wrapper: Wrapper,
}: IndustrySlotProps) {
  const industry = useCurrentIndustry();

  const Component = industry ? slot(industry) : undefined;
  const rendered = Component ? <Component {...(slotProps ?? {})} /> : fallback;

  if (Wrapper) return <Wrapper>{rendered}</Wrapper>;
  return <>{rendered}</>;
}

/**
 * Hook variant — returns the slot component itself (or undefined).
 * Useful when you need to conditionally render or pass extra props.
 *
 *   const ExtraFields = useIndustrySlot((p) => p.productForm?.extraFields);
 *   {ExtraFields && <ExtraFields product={p} onChange={onChange} />}
 */
export function useIndustrySlot<T = any>(
  slot: (pack: IndustryPack) => ComponentType<T> | undefined,
): ComponentType<T> | undefined {
  const industry = useCurrentIndustry();
  return industry ? slot(industry) : undefined;
}
