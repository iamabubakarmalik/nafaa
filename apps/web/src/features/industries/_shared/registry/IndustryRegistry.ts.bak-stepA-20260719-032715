import type { IndustryPack } from '../types/industry-pack';
import type { AuthTenant } from '@/store/auth.store';

/**
 * IndustryRegistry — central registry for all industry packs.
 *
 * Usage (in src/App.tsx or a bootstrap file):
 *
 *   import { IndustryRegistry } from '@/features/industries/_shared/registry/IndustryRegistry';
 *   import { HotelPack } from '@/features/industries/hotel';
 *   import { CarpetPack } from '@/features/industries/carpet';
 *
 *   IndustryRegistry.register([HotelPack, CarpetPack, ...]);
 *
 * Then anywhere in the app:
 *
 *   const industry = useCurrentIndustry();
 *   if (industry?.pos?.modeBar) {
 *     const ModeBar = industry.pos.modeBar;
 *     return <ModeBar />;
 *   }
 */
class IndustryRegistryImpl {
  private packs: IndustryPack[] = [];
  private byId = new Map<string, IndustryPack>();

  /**
   * Register one or more packs. Later registration of the same ID overrides.
   */
  register(pack: IndustryPack | IndustryPack[]): void {
    const list = Array.isArray(pack) ? pack : [pack];
    for (const p of list) {
      if (this.byId.has(p.id)) {
        // Replace existing
        this.packs = this.packs.filter((x) => x.id !== p.id);
      }
      this.packs.push(p);
      this.byId.set(p.id, p);
    }
  }

  /** All registered packs (in registration order) */
  all(): IndustryPack[] {
    return [...this.packs];
  }

  /** Get by ID */
  get(id: string): IndustryPack | undefined {
    return this.byId.get(id);
  }

  /**
   * Resolve the active pack for a tenant.
   * Iterates packs in registration order, returns the FIRST that matches.
   * If none match, returns undefined (core-only mode).
   */
  resolve(tenant: AuthTenant | null): IndustryPack | undefined {
    for (const pack of this.packs) {
      try {
        if (pack.matches(tenant)) return pack;
      } catch (err) {
        console.warn(`[IndustryRegistry] matches() threw for pack "${pack.id}"`, err);
      }
    }
    return undefined;
  }

  /** All packs that match a tenant (rare — usually only one) */
  resolveAll(tenant: AuthTenant | null): IndustryPack[] {
    return this.packs.filter((p) => {
      try {
        return p.matches(tenant);
      } catch {
        return false;
      }
    });
  }

  /** For testing / dev tools */
  clear(): void {
    this.packs = [];
    this.byId.clear();
  }
}

export const IndustryRegistry = new IndustryRegistryImpl();
