import { useMemo, useState } from 'react';
import {
  Layers, Plus, Copy, Trash2, ChevronDown, ChevronUp, AlertCircle,
  Ruler, DollarSign, MapPin, Sparkles, Info, TrendingUp,
} from 'lucide-react';
import { formatPKRFull } from '@/lib/format';
import type {
  CarpetWizardBasic,
  CarpetWizardRoll,
  CarpetWizardVariant,
} from '../../hooks/useCarpetWizard';

interface Props {
  basic: CarpetWizardBasic;
  hasVariants: boolean;
  variants: CarpetWizardVariant[];
  rolls: CarpetWizardRoll[];
  onAddRoll: (variantTempId: string | null, seed?: Partial<CarpetWizardRoll>) => void;
  onDuplicateRoll: (tempId: string) => void;
  onUpdateRoll: (tempId: string, patch: Partial<CarpetWizardRoll>) => void;
  onRemoveRoll: (tempId: string) => void;
  errors: string[];
}

interface VariantBucket {
  tempId: string | null;
  name: string;
  colorHex?: string;
  designCode?: string;
}

export function CarpetWizardStep3Rolls({
  basic, hasVariants, variants, rolls,
  onAddRoll, onDuplicateRoll, onUpdateRoll, onRemoveRoll, errors,
}: Props) {
  // Track which variant buckets are expanded (default: all open)
  const [collapsed, setCollapsed] = useState<Record<string, boolean>>({});

  const buckets: VariantBucket[] = useMemo(() => {
    if (!hasVariants || variants.length === 0) {
      return [{ tempId: null, name: basic.name || 'This product' }];
    }
    return variants.map((v) => ({
      tempId: v.tempId,
      name: v.name,
      colorHex: v.colorHex,
      designCode: v.designCode,
    }));
  }, [hasVariants, variants, basic.name]);

  const rollsByBucket = useMemo(() => {
    const map = new Map<string | null, CarpetWizardRoll[]>();
    for (const b of buckets) map.set(b.tempId, []);
    for (const r of rolls) {
      const key = r.variantTempId;
      if (!map.has(key)) map.set(key, []);
      map.get(key)!.push(r);
    }
    return map;
  }, [rolls, buckets]);

  const isCollapsed = (id: string | null) => collapsed[id ?? '__none__'] === true;
  const toggle = (id: string | null) =>
    setCollapsed((c) => ({ ...c, [id ?? '__none__']: !c[id ?? '__none__'] }));

  return (
    <div className="space-y-4">
      {/* Errors */}
      {errors.length > 0 && (
        <div className="rounded-2xl bg-rose-50 border-2 border-rose-200 p-3 flex items-start gap-2">
          <AlertCircle className="h-4 w-4 text-rose-600 shrink-0 mt-0.5" />
          <div className="text-xs text-rose-900">
            <div className="font-extrabold mb-0.5">Fix before saving:</div>
            <ul className="list-disc pl-4 space-y-0.5">
              {errors.slice(0, 6).map((e, i) => <li key={i}>{e}</li>)}
              {errors.length > 6 && <li>...and {errors.length - 6} more</li>}
            </ul>
          </div>
        </div>
      )}

      {/* Info banner */}
      <div className="rounded-2xl bg-gradient-to-br from-emerald-50 to-white border-2 border-emerald-200 p-4 flex items-start gap-3">
        <div className="h-10 w-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shadow-md shrink-0">
          <Layers className="h-5 w-5" />
        </div>
        <div className="flex-1">
          <h3 className="font-extrabold text-emerald-900 text-sm">
            Bulk Add Rolls
          </h3>
          <p className="text-xs text-emerald-800 font-semibold mt-0.5 leading-relaxed">
            Har physical roll ki entry — width, length aur price. Prices
            <strong> auto-fill</strong> ho ke aati hain Step 1 se, aap change kar sakte hain.
            <strong> Optional</strong> — rolls baad mein bhi add ho sakti hain.
          </p>
        </div>
      </div>

      {/* Variant buckets */}
      {buckets.map((b) => {
        const bucketRolls = rollsByBucket.get(b.tempId) ?? [];
        const collapsedNow = isCollapsed(b.tempId);
        const bucketSqft = bucketRolls.reduce((acc, r) => {
          const w = Number(r.widthFt) + Number(r.widthInch || 0) / 12;
          const l = Number(r.lengthFt) + Number(r.lengthInch || 0) / 12;
          return acc + w * l;
        }, 0);

        return (
          <section
            key={b.tempId ?? '__none__'}
            className="rounded-2xl border-2 border-slate-200 bg-white overflow-hidden"
          >
            {/* Bucket header */}
            <button
              type="button"
              onClick={() => toggle(b.tempId)}
              className="w-full flex items-center gap-3 px-4 py-3 bg-gradient-to-r from-slate-50 to-white hover:from-slate-100 transition"
            >
              {b.colorHex ? (
                <div
                  className="h-9 w-9 rounded-lg border-2 border-slate-200 shrink-0 shadow-inner"
                  style={{ backgroundColor: b.colorHex }}
                />
              ) : (
                <div className="h-9 w-9 rounded-lg bg-slate-200 text-slate-500 flex items-center justify-center shrink-0">
                  <Layers className="h-4 w-4" />
                </div>
              )}
              <div className="flex-1 text-left min-w-0">
                <div className="font-extrabold text-slate-900 text-sm truncate">
                  {b.name}
                  {b.designCode && (
                    <span className="ml-2 text-[10px] font-mono text-slate-500">
                      {b.designCode}
                    </span>
                  )}
                </div>
                <div className="text-[11px] text-slate-500 font-semibold">
                  {bucketRolls.length} roll{bucketRolls.length !== 1 ? 's' : ''}
                  {bucketSqft > 0 && ` • ${bucketSqft.toFixed(0)} sqft total`}
                </div>
              </div>
              <button
                type="button"
                onClick={(e) => {
                  e.stopPropagation();
                  onAddRoll(b.tempId);
                  setCollapsed((c) => ({ ...c, [b.tempId ?? '__none__']: false }));
                }}
                className="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold inline-flex items-center gap-1 shadow-sm"
              >
                <Plus className="h-3.5 w-3.5" /> Add Roll
              </button>
              {collapsedNow ? (
                <ChevronDown className="h-4 w-4 text-slate-500" />
              ) : (
                <ChevronUp className="h-4 w-4 text-slate-500" />
              )}
            </button>

            {/* Rolls table */}
            {!collapsedNow && (
              <>
                {bucketRolls.length === 0 ? (
                  <div className="p-6 text-center">
                    <div className="h-14 w-14 rounded-2xl bg-slate-100 mx-auto flex items-center justify-center mb-2">
                      <Layers className="h-7 w-7 text-slate-400" />
                    </div>
                    <div className="text-sm font-extrabold text-slate-700">
                      No rolls yet for {b.name}
                    </div>
                    <div className="text-xs text-slate-500 font-semibold mt-1">
                      Click <strong>Add Roll</strong> above to start
                    </div>
                  </div>
                ) : (
                  <div className="overflow-x-auto border-t border-slate-100">
                    <table className="w-full text-xs">
                      <thead className="bg-slate-50">
                        <tr>
                          <ColHead label="Roll #" hint="Auto or manual" />
                          <ColHead label="Width" hint="ft × in" icon={Ruler} />
                          <ColHead label="Length" hint="ft × in" icon={Ruler} />
                          <ColHead label="Sqft" hint="calculated" />
                          <ColHead label="Cost /sqft" icon={DollarSign} />
                          <ColHead label="Sale /sqft" icon={DollarSign} />
                          <ColHead label="Rack" icon={MapPin} />
                          <ColHead label="" />
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-100">
                        {bucketRolls.map((r) => {
                          const w =
                            Number(r.widthFt) + Number(r.widthInch || 0) / 12;
                          const l =
                            Number(r.lengthFt) + Number(r.lengthInch || 0) / 12;
                          const sqft = w * l;
                          return (
                            <tr key={r.tempId} className="hover:bg-slate-50/50">
                              <td className="px-2 py-1.5">
                                <input
                                  value={r.rollNumber}
                                  onChange={(e) =>
                                    onUpdateRoll(r.tempId, { rollNumber: e.target.value })
                                  }
                                  className="w-24 h-8 rounded-lg border-2 border-slate-200 px-2 text-xs font-mono font-bold focus:outline-none focus:border-emerald-500"
                                />
                              </td>
                              <td className="px-2 py-1.5">
                                <div className="flex gap-1 items-center">
                                  <NumberCell
                                    value={r.widthFt}
                                    onChange={(v) => onUpdateRoll(r.tempId, { widthFt: v })}
                                    suffix="ft"
                                    width="w-16"
                                  />
                                  <NumberCell
                                    value={r.widthInch}
                                    onChange={(v) => onUpdateRoll(r.tempId, { widthInch: v })}
                                    suffix="in"
                                    width="w-14"
                                    max={11}
                                  />
                                </div>
                              </td>
                              <td className="px-2 py-1.5">
                                <div className="flex gap-1 items-center">
                                  <NumberCell
                                    value={r.lengthFt}
                                    onChange={(v) => onUpdateRoll(r.tempId, { lengthFt: v })}
                                    suffix="ft"
                                    width="w-16"
                                  />
                                  <NumberCell
                                    value={r.lengthInch}
                                    onChange={(v) => onUpdateRoll(r.tempId, { lengthInch: v })}
                                    suffix="in"
                                    width="w-14"
                                    max={11}
                                  />
                                </div>
                              </td>
                              <td className="px-2 py-1.5">
                                <div
                                  className={[
                                    'text-xs font-extrabold tabular-nums',
                                    sqft > 0 ? 'text-emerald-700' : 'text-slate-400',
                                  ].join(' ')}
                                >
                                  {sqft.toFixed(1)}
                                </div>
                              </td>
                              <td className="px-2 py-1.5">
                                <NumberCell
                                  value={r.costPerSqft}
                                  onChange={(v) => onUpdateRoll(r.tempId, { costPerSqft: v })}
                                  width="w-20"
                                />
                              </td>
                              <td className="px-2 py-1.5">
                                <NumberCell
                                  value={r.salePricePerSqft}
                                  onChange={(v) =>
                                    onUpdateRoll(r.tempId, { salePricePerSqft: v })
                                  }
                                  width="w-20"
                                  accent="emerald"
                                />
                              </td>
                              <td className="px-2 py-1.5">
                                <input
                                  value={r.rackNumber}
                                  onChange={(e) =>
                                    onUpdateRoll(r.tempId, { rackNumber: e.target.value })
                                  }
                                  placeholder="Wall-1"
                                  className="w-20 h-8 rounded-lg border-2 border-slate-200 px-2 text-xs font-bold focus:outline-none focus:border-emerald-500"
                                />
                              </td>
                              <td className="px-2 py-1.5">
                                <div className="flex items-center gap-1">
                                  <button
                                    type="button"
                                    onClick={() => onDuplicateRoll(r.tempId)}
                                    className="h-7 w-7 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-600 flex items-center justify-center"
                                    title="Duplicate row"
                                  >
                                    <Copy className="h-3 w-3" />
                                  </button>
                                  <button
                                    type="button"
                                    onClick={() => onRemoveRoll(r.tempId)}
                                    className="h-7 w-7 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 flex items-center justify-center"
                                    title="Delete row"
                                  >
                                    <Trash2 className="h-3 w-3" />
                                  </button>
                                </div>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                )}

                {/* Quick add row footer */}
                {bucketRolls.length > 0 && (
                  <div className="border-t border-slate-100 bg-slate-50/70 p-2 flex items-center justify-between gap-2 flex-wrap">
                    <div className="text-[10px] font-extrabold text-slate-600 flex items-center gap-1 pl-1">
                      <Sparkles className="h-3 w-3 text-amber-500" />
                      Prices Step 1 se auto-fill hain — change kar sakte hain
                    </div>
                    <button
                      type="button"
                      onClick={() => onAddRoll(b.tempId)}
                      className="px-2.5 py-1 rounded-lg bg-white border-2 border-dashed border-emerald-300 hover:border-emerald-500 hover:bg-emerald-50 text-emerald-700 text-[11px] font-extrabold inline-flex items-center gap-1 transition"
                    >
                      <Plus className="h-3 w-3" /> Add Another Roll
                    </button>
                  </div>
                )}
              </>
            )}
          </section>
        );
      })}

      {/* No rolls anywhere hint */}
      {rolls.length === 0 && (
        <div className="rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-8 text-center">
          <Info className="h-10 w-10 text-slate-400 mx-auto mb-2" />
          <div className="font-extrabold text-slate-700 text-sm">
            Rolls optional hain
          </div>
          <div className="text-xs text-slate-500 font-semibold mt-1">
            Sirf product create karna hai to <strong>Save</strong> kar dein — rolls baad mein add ho sakti hain
          </div>
        </div>
      )}
    </div>
  );
}

// ─── Helpers ─────────────────────────────────────────────

function ColHead({
  label, hint, icon: Icon,
}: { label: string; hint?: string; icon?: any }) {
  return (
    <th className="px-2 py-2 text-left font-extrabold uppercase tracking-wider text-slate-700 text-[9px]">
      <div className="flex items-center gap-0.5">
        {Icon && <Icon className="h-2.5 w-2.5" />}
        {label}
      </div>
      {hint && <div className="text-[9px] font-bold text-slate-400 normal-case">{hint}</div>}
    </th>
  );
}

function NumberCell({
  value, onChange, suffix, width = 'w-20', accent, max,
}: {
  value: number;
  onChange: (v: number) => void;
  suffix?: string;
  width?: string;
  accent?: 'emerald';
  max?: number;
}) {
  return (
    <div className="relative">
      <input
        type="number"
        step="0.01"
        value={value === 0 ? '' : value}
        onChange={(e) => {
          const v = e.target.value === '' ? 0 : Number(e.target.value);
          if (max !== undefined && v > max) return;
          onChange(v);
        }}
        placeholder="0"
        className={[
          'h-8 rounded-lg border-2 px-2 text-xs font-bold tabular-nums text-right focus:outline-none',
          width,
          accent === 'emerald'
            ? 'border-emerald-200 bg-emerald-50/50 focus:border-emerald-500 text-emerald-800'
            : 'border-slate-200 focus:border-emerald-500',
          suffix ? 'pr-6' : '',
        ].join(' ')}
      />
      {suffix && (
        <span className="absolute right-1.5 top-1/2 -translate-y-1/2 text-[9px] font-extrabold text-slate-400 pointer-events-none">
          {suffix}
        </span>
      )}
    </div>
  );
}
