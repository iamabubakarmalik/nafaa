import { Layers, Scissors, BarChart3, Download } from 'lucide-react';
import type { IndustryPack } from '@/features/industries/_shared/types/industry-pack';

// Existing pages (already in your project)
import CarpetRollsPage from './pages/CarpetRollsPage';
import CarpetCutPiecesPage from './pages/CarpetCutPiecesPage';
import CarpetRollDetailPage from './pages/CarpetRollDetailPage';
import CarpetReportsPage from './pages/CarpetReportsPage';
import CarpetBulkImportPage from './pages/CarpetBulkImportPage';

// POS extensions
import { CarpetPosHeaderActions } from './pos-extensions/CarpetPosHeaderActions';
import { CarpetPosSearchExtension } from './pos-extensions/CarpetPosSearchExtension';
