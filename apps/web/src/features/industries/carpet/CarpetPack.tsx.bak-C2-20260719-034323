      { value: 'ft', label: 'Running Feet', hint: '📏', group: 'Length' },
      { value: 'm', label: 'Running Meter', hint: '📏', group: 'Length' },
      { value: 'pcs', label: 'Pieces', hint: '🔢', group: 'Count' },
      { value: 'roll', label: 'Full Roll', hint: '🧻', group: 'Count' },
