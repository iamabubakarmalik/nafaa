import { useState } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import {
  Timer, Plus, X, RefreshCw, Sparkles, Package, AlertCircle,
  CheckCircle2, TrendingDown, Zap,
} from 'lucide-react';
import { freshnessApi, type FreshnessStatus } from '../api/freshness.api';
import { formatPKR } from '@/lib/format';
import { Button } from '@/components/ui/Button';
import { toast } from 'sonner';
import { format, differenceInHours } from 'date-fns';

const STATUS_CONFIG: Record<FreshnessStatus, { label: string; color: string; emoji: string }> = {
  FRESH: { label: 'Fresh', color: 'bg-emerald-500', emoji: '✨' },
  DAY_OLD: { label: 'Day Old', color: 'bg-amber-500', emoji: '📅' },
  NEAR_EXPIRY: { label: 'Near Expiry', color: 'bg-orange-500', emoji: '⚠️' },
  EXPIRED: { label: 'Expired', color: 'bg-rose-500', emoji: '🚫' },
  DISCARDED: { label: 'Discarded', color: 'bg-slate-500', emoji: '🗑️' },
};

export default function FreshnessPage() {
  const queryClient = useQueryClient();
  const [statusFilter, setStatusFilter] = useState<string>('active');

  const { data: logs = [], isLoading, refetch, isRefetching } = useQuery({
    queryKey: ['freshness-logs', statusFilter],
    queryFn: () => freshnessApi.list({ status: statusFilter === 'all' || statusFilter === 'active' ? undefined : statusFilter }),
    refetchInterval: 60_000,
  });

  const { data: summary } = useQuery({
    queryKey: ['freshness-summary'],
    queryFn: () => freshnessApi.summary(),
    refetchInterval: 60_000,
  });

  const filtered = statusFilter === 'active'
    ? logs.filter((l) => ['FRESH', 'DAY_OLD', 'NEAR_EXPIRY'].includes(l.status))
    : logs;

  const runCheckMutation = useMutation({
    mutationFn: () => freshnessApi.runCheck(),
    onSuccess: (res: any) => {
      toast.success(`Checked ${res.checked} items — ${res.expired} expired, ${res.nearExpiry} near expiry`);
      queryClient.invalidateQueries({ queryKey: ['freshness-logs'] });
      queryClient.invalidateQueries({ queryKey: ['freshness-summary'] });
    },
  });

  return (
    <div className="space-y-6">
      <section className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-emerald-900 to-teal-800 text-white p-6 sm:p-8 shadow-2xl">
        <div className="absolute -top-20 -right-20 h-72 w-72 rounded-full bg-emerald-400/20 blur-3xl" />
        <div className="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
          <div>
            <div className="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur px-3 py-1 text-xs font-extrabold border border-white/20">
              <Timer className="h-3.5 w-3.5 text-amber-300" />
              Freshness Tracking
            </div>
            <h1 className="mt-3 text-3xl sm:text-4xl font-extrabold leading-tight">⏰ Freshness & Expiry</h1>
            <p className="mt-2 text-sm text-white/80 font-semibold">Same-day, day-old, near-expiry alerts</p>
          </div>
          <div className="flex items-center gap-2 flex-wrap">
            <Button onClick={() => runCheckMutation.mutate()} loading={runCheckMutation.isPending} className="bg-white/15 hover:bg-white/25 text-white border border-white/20">
              <Zap className="h-4 w-4" />
              Run Expiry Check
            </Button>
            <button onClick={() => refetch()} disabled={isRefetching} className="inline-flex items-center gap-2 rounded-xl bg-white/15 hover:bg-white/25 px-4 py-2.5 text-sm font-bold backdrop-blur border border-white/20">
              <RefreshCw className={'h-4 w-4 ' + (isRefetching ? 'animate-spin' : '')} />
              Refresh
            </button>
          </div>
        </div>
      </section>

      {summary && (
        <section className="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <StatCard label="Fresh" value={summary.fresh} icon={CheckCircle2} color="emerald" />
          <StatCard label="Day Old" value={summary.dayOld} icon={Timer} color="amber" />
          <StatCard label="Near Expiry" value={summary.nearExpiry} icon={AlertCircle} color="orange" highlight={summary.nearExpiry > 0} />
          <StatCard label="Expired" value={summary.expired} icon={X} color="rose" highlight={summary.expired > 0} />
        </section>
      )}

      <div className="flex gap-1.5 overflow-x-auto pb-1">
        {['active', 'all', 'FRESH', 'DAY_OLD', 'NEAR_EXPIRY', 'EXPIRED', 'DISCARDED'].map((s) => (
          <button key={s} onClick={() => setStatusFilter(s)} className={
            'shrink-0 px-3 py-1.5 rounded-lg text-xs font-extrabold ' +
            (statusFilter === s ? 'bg-emerald-600 text-white shadow' : 'bg-slate-100 dark:bg-neutral-800 text-slate-700')
          }>{s === 'active' ? '🔥 Active' : s === 'all' ? 'All' : STATUS_CONFIG[s as FreshnessStatus]?.label ?? s}</button>
        ))}
      </div>

      {isLoading ? (
        <div className="grid gap-3">{[1, 2, 3].map((i) => <div key={i} className="h-24 rounded-2xl bg-slate-100 dark:bg-neutral-800 animate-pulse" />)}</div>
      ) : filtered.length === 0 ? (
        <div className="rounded-3xl bg-white dark:bg-neutral-900 border-2 border-dashed border-slate-200 dark:border-neutral-800 p-12 text-center">
          <Timer className="h-16 w-16 text-slate-400 mx-auto mb-3" />
          <p className="font-extrabold text-slate-700">No freshness logs</p>
        </div>
      ) : (
        <section className="grid gap-3">
          {filtered.map((log) => <FreshnessCard key={log.id} log={log} onRefresh={() => queryClient.invalidateQueries({ queryKey: ['freshness-logs'] })} />)}
        </section>
      )}
    </div>
  );
}

function StatCard({ label, value, icon: Icon, color, highlight }: any) {
  const colors: Record<string, string> = {
    emerald: 'from-emerald-500 to-green-600', amber: 'from-amber-500 to-orange-600',
    orange: 'from-orange-500 to-red-600', rose: 'from-rose-500 to-red-600',
  };
  return (
    <div className={
      'rounded-2xl border-2 p-5 shadow-sm ' +
      (highlight ? 'bg-gradient-to-br from-rose-50 to-red-50 dark:from-rose-950/40 dark:to-red-950/40 border-rose-300 animate-pulse' : 'bg-white dark:bg-neutral-900 border-slate-200 dark:border-neutral-800')
    }>
      <div className="flex items-center justify-between">
        <div>
          <div className="text-xs uppercase tracking-wider text-slate-500 font-bold">{label}</div>
          <div className="mt-2 text-2xl font-extrabold text-slate-900 dark:text-white tabular-nums">{value}</div>
        </div>
        <div className={'h-12 w-12 rounded-2xl bg-gradient-to-br ' + colors[color] + ' text-white flex items-center justify-center shadow-lg'}>
          <Icon className="h-6 w-6" />
        </div>
      </div>
    </div>
  );
}

function FreshnessCard({ log, onRefresh }: any) {
  const cfg = STATUS_CONFIG[log.status];
  const hoursLeft = differenceInHours(new Date(log.bestBefore), new Date());
  const isExpired = hoursLeft < 0;

  const discardMutation = useMutation({
    mutationFn: () => {
      const reason = prompt('Discard reason?');
      if (!reason) throw new Error('Cancelled');
      return freshnessApi.discard(log.id, log.currentQty, reason);
    },
    onSuccess: () => { toast.success('Discarded'); onRefresh(); },
  });

  return (
    <div className={
      'rounded-2xl bg-white dark:bg-neutral-900 border-2 shadow-sm p-4 ' +
      (log.status === 'NEAR_EXPIRY' || log.status === 'EXPIRED' ? 'border-rose-300 dark:border-rose-800 ring-2 ring-rose-100 dark:ring-rose-950/40' :
       log.status === 'DAY_OLD' ? 'border-amber-300' :
       'border-slate-200 dark:border-neutral-800')
    }>
      <div className="flex items-start justify-between gap-3 flex-wrap">
        <div className="flex items-start gap-3 min-w-0 flex-1">
          <div className={'h-12 w-12 rounded-2xl text-white flex items-center justify-center shadow shrink-0 text-2xl ' + cfg.color}>
            {cfg.emoji}
          </div>
          <div className="min-w-0 flex-1">
            <div className="flex items-center gap-2 flex-wrap">
              <span className="font-extrabold text-slate-900 dark:text-white">{log.productName}</span>
              <span className={'px-2 py-0.5 rounded-full text-[9px] font-extrabold uppercase text-white ' + cfg.color}>{cfg.label}</span>
              {log.batchNumber && <span className="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[9px] font-mono font-bold">#{log.batchNumber}</span>}
            </div>
            <div className="mt-1 text-xs font-bold text-slate-600">
              Produced: {format(new Date(log.productionDate), 'dd MMM HH:mm')}
            </div>
            <div className={
              'text-xs font-extrabold ' +
              (isExpired ? 'text-rose-700' : hoursLeft < 6 ? 'text-orange-700' : 'text-slate-600')
            }>
              Best before: {format(new Date(log.bestBefore), 'dd MMM HH:mm')}
              {' '}({isExpired ? 'EXPIRED' : hoursLeft + 'h left'})
            </div>
          </div>
        </div>
        <div className="text-right shrink-0">
          <div className="text-[10px] uppercase font-extrabold text-slate-500">Stock</div>
          <div className="text-2xl font-extrabold tabular-nums">{log.currentQty}</div>
          <div className="text-[10px] font-bold text-slate-500">of {log.initialQty}</div>
        </div>
      </div>

      <div className="mt-3 grid grid-cols-4 gap-1.5 text-xs">
        <div className="rounded-lg bg-emerald-50 dark:bg-emerald-950/30 p-2 text-center">
          <div className="text-[9px] uppercase font-extrabold text-emerald-700">Sold</div>
          <div className="text-sm font-extrabold text-emerald-800 tabular-nums">{log.soldQty}</div>
        </div>
        <div className="rounded-lg bg-amber-50 dark:bg-amber-950/30 p-2 text-center">
          <div className="text-[9px] uppercase font-extrabold text-amber-700">Discounted</div>
          <div className="text-sm font-extrabold text-amber-800 tabular-nums">{log.discountedQty}</div>
        </div>
        <div className="rounded-lg bg-rose-50 dark:bg-rose-950/30 p-2 text-center">
          <div className="text-[9px] uppercase font-extrabold text-rose-700">Wasted</div>
          <div className="text-sm font-extrabold text-rose-800 tabular-nums">{log.wastedQty}</div>
        </div>
        <div className="rounded-lg bg-slate-50 dark:bg-neutral-800/50 p-2 text-center">
          <div className="text-[9px] uppercase font-extrabold text-slate-500">Current</div>
          <div className="text-sm font-extrabold text-slate-900 dark:text-white tabular-nums">{log.currentQty}</div>
        </div>
      </div>

      {log.currentQty > 0 && log.status !== 'DISCARDED' && (
        <div className="mt-3 pt-3 border-t border-slate-100 dark:border-neutral-800">
          <Button size="sm" variant="secondary" onClick={() => discardMutation.mutate()} className="bg-rose-50 text-rose-700 border-rose-300 hover:bg-rose-100 w-full">
            <TrendingDown className="h-3.5 w-3.5" />
            Discard All ({log.currentQty})
          </Button>
        </div>
      )}
    </div>
  );
}
