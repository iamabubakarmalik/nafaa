import { useMemo } from 'react';
import { Link, useNavigate, useParams } from 'react-router-dom';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import {
  ArrowLeft, Edit3, Pill, Beaker, Package, TrendingUp, Star,
  ShieldAlert, Snowflake, Award, ChevronRight, ExternalLink,
  Trash2, Eye, Image as ImageIcon, Hash, Tag, DollarSign,
  Receipt, ShoppingCart, AlertTriangle, Calendar, Repeat,
  Thermometer, Building, FileText,
} from 'lucide-react';
import { toast } from 'sonner';
import { Button } from '@/components/ui/Button';
import { formatPKR, formatPKRFull } from '@/lib/format';
import { productsApi } from '@/api/products.api';
import { productImagesApi } from '@/api/product-images.api';
import { salesApi } from '@/api/sales.api';
import { medicinesApi } from '../api/medicines.api';
import { saltsApi } from '../api/salts.api';
import { batchesApi } from '../api/batches.api';
import { substitutesApi } from '../api/substitutes.api';

const SCHEDULE_LABELS: Record<string, { label: string; color: string }> = {
  OTC: { label: 'OTC', color: 'bg-emerald-100 text-emerald-700 border-emerald-300' },
  SCHEDULE_G: { label: 'Schedule G', color: 'bg-blue-100 text-blue-700 border-blue-300' },
  SCHEDULE_H: { label: 'Schedule H', color: 'bg-amber-100 text-amber-700 border-amber-300' },
  SCHEDULE_X: { label: 'Schedule X', color: 'bg-rose-100 text-rose-700 border-rose-300' },
  CONTROLLED: { label: 'Controlled', color: 'bg-red-100 text-red-700 border-red-300' },
  NARCOTIC: { label: 'Narcotic', color: 'bg-red-200 text-red-800 border-red-400' },
  PSYCHOTROPIC: { label: 'Psychotropic', color: 'bg-purple-100 text-purple-700 border-purple-300' },
};

export default function PharmacyMedicineDetailPage() {
  const { id } = useParams();
  const navigate = useNavigate();
  const queryClient = useQueryClient();

  const { data: product, isLoading } = useQuery({
    queryKey: ['product', id],
    queryFn: () => productsApi.getOne(id!),
    enabled: !!id,
  });

  const { data: medicine } = useQuery({
    queryKey: ['medicine-by-product', id],
    queryFn: () => medicinesApi.byProduct(id!),
    enabled: !!id,
  });

  const { data: images = [] } = useQuery({
    queryKey: ['product-images', id],
    queryFn: () => productImagesApi.list(id!),
    enabled: !!id,
  });

  const { data: productSalts = [] } = useQuery({
    queryKey: ['product-salts', id],
    queryFn: () => saltsApi.byProduct(id!),
    enabled: !!id,
  });

  const { data: batches = [] } = useQuery({
    queryKey: ['product-batches', id],
    queryFn: () => batchesApi.listByProduct(id!),
    enabled: !!id,
  });

  const { data: substitutes = [] } = useQuery({
    queryKey: ['product-substitutes', id],
    queryFn: () => substitutesApi.byProduct(id!),
    enabled: !!id,
  });

  const { data: allSales = [] } = useQuery({
    queryKey: ['sales-list-for-product'],
    queryFn: () => salesApi.list(),
    enabled: !!id,
  });

  const salesForProduct = useMemo(() => {
    if (!id) return [];
    return allSales.filter((s) => s.items.some((it) => it.productId === id)).slice(0, 20);
  }, [allSales, id]);

  const removeMutation = useMutation({
    mutationFn: () => productsApi.remove(id!),
    onSuccess: (data: any) => {
      toast.success(data?.softDeleted ? 'Medicine deactivated' : 'Medicine deleted');
      queryClient.invalidateQueries({ queryKey: ['products'] });
      navigate('/pharmacy/medicines');
    },
    onError: (e: any) => toast.error(e?.response?.data?.message || 'Delete failed'),
  });

  const stats = useMemo(() => {
    const soldItems = allSales.flatMap((s) =>
      s.items.filter((it) => it.productId === id).map((it) => ({ ...it, sale: s })),
    );
    const totalSold = soldItems.reduce((a, it) => a + Number(it.quantity || 0), 0);
    const totalRevenue = soldItems.reduce((a, it) => a + Number(it.total || 0), 0);
    const totalOrders = new Set(soldItems.map((it) => it.sale.id)).size;

    const now = Date.now();
    const batchStock = batches.reduce((a, b) => a + Number(b.quantity || 0), 0);
    const expiringSoon = batches.filter((b) => {
      if (!b.expiryDate) return false;
      const days = (new Date(b.expiryDate).getTime() - now) / (1000 * 60 * 60 * 24);
      return days > 0 && days <= 90;
    }).length;
    const expired = batches.filter((b) => {
      if (!b.expiryDate) return false;
      return new Date(b.expiryDate).getTime() < now;
    }).length;

    return {
      totalSold, totalRevenue, totalOrders,
      batchStock,
      expiringSoon, expired,
      saltCount: productSalts.length,
      batchCount: batches.length,
      substituteCount: substitutes.length,
    };
  }, [allSales, id, batches, productSalts, substitutes]);

  if (isLoading || !product) {
    return (
      <div className="flex items-center justify-center py-24">
        <div className="h-12 w-12 rounded-full border-4 border-teal-200 border-t-teal-600 animate-spin" />
      </div>
    );
  }

  const scheduleCfg = medicine ? SCHEDULE_LABELS[medicine.scheduleClass] : null;

  return (
    <div className="space-y-5 pb-8">
      <div className="flex items-center justify-between gap-3 flex-wrap">
        <button
          onClick={() => navigate('/pharmacy/medicines')}
          className="inline-flex items-center gap-2 text-sm text-slate-600 hover:text-teal-600 font-bold transition"
        >
          <ArrowLeft className="h-4 w-4" /> Back to Medicines
        </button>
        <div className="flex items-center gap-2 flex-wrap">
          <Link
            to={`/pharmacy-medicines/${id}/edit`}
            className="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-teal-50 border-2 border-teal-200 hover:bg-teal-100 text-teal-700 text-sm font-extrabold transition"
          >
            <Edit3 className="h-4 w-4" /> Edit Medicine
          </Link>
          <Link
            to="/catalog"
            target="_blank"
            className="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-emerald-50 border-2 border-emerald-200 hover:bg-emerald-100 text-emerald-700 text-sm font-extrabold transition"
          >
            <ExternalLink className="h-4 w-4" /> View in Catalog
          </Link>
          <button
            onClick={() => {
              if (confirm(`Delete "${product.name}"?`)) removeMutation.mutate();
            }}
            className="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-rose-50 border-2 border-rose-200 hover:bg-rose-100 text-rose-700 text-sm font-extrabold transition"
          >
            <Trash2 className="h-4 w-4" /> Delete
          </button>
        </div>
      </div>

      {/* HERO */}
      <section className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-teal-900 to-cyan-700 text-white shadow-2xl">
        <div className="absolute -top-20 -right-20 h-64 w-64 rounded-full bg-teal-400/20 blur-3xl" />
        <div className="absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-cyan-400/15 blur-3xl" />

        <div className="relative grid lg:grid-cols-[280px_1fr] gap-6 p-6">
          <div className="relative aspect-square rounded-2xl overflow-hidden bg-white/10 backdrop-blur border-2 border-white/20 shrink-0">
            {images[0]?.url ? (
              <img src={images[0].url} alt={product.name} className="w-full h-full object-cover" />
            ) : (
              <div className="w-full h-full flex items-center justify-center text-white/50">
                <Pill className="h-16 w-16" />
              </div>
            )}
            {product.isFeatured && (
              <div className="absolute top-3 right-3 px-2 py-1 rounded-lg bg-amber-500 text-white text-[10px] font-extrabold shadow-lg inline-flex items-center gap-1">
                <Star className="h-3 w-3 fill-white" /> FEATURED
              </div>
            )}
            {!product.isActive && (
              <div className="absolute inset-x-0 bottom-0 py-1.5 bg-rose-600 text-white text-center text-xs font-extrabold">
                INACTIVE
              </div>
            )}
          </div>

          <div className="min-w-0">
            <div className="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur px-3 py-1 text-xs font-extrabold border border-white/20">
              <Pill className="h-3.5 w-3.5 text-amber-300" />
              Medicine
              {product.category && (
                <>
                  <span className="text-white/40">•</span>
                  <span>{product.category.name}</span>
                </>
              )}
            </div>
            <h1 className="mt-3 text-3xl sm:text-4xl font-extrabold leading-tight">{product.name}</h1>
            {productSalts.length > 0 && (
              <p className="mt-2 text-sm text-amber-300 font-extrabold">
                🧪 {productSalts.map((ps: any) => `${ps.salt?.name} ${ps.strength}`).join(' + ')}
              </p>
            )}
            {medicine?.indication && (
              <p className="mt-1 text-sm text-white/85">For: {medicine.indication}</p>
            )}

            <div className="mt-3 flex items-center gap-2 flex-wrap text-xs">
              {product.sku && (
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white/10 backdrop-blur font-mono">
                  <Hash className="h-3 w-3" /> {product.sku}
                </span>
              )}
              {medicine?.registrationNumber && (
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white/10 backdrop-blur font-mono">
                  <Award className="h-3 w-3" /> DRAP: {medicine.registrationNumber}
                </span>
              )}
              {medicine?.manufacturer && (
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white/10 backdrop-blur">
                  <Building className="h-3 w-3" /> {medicine.manufacturer}
                </span>
              )}
              {scheduleCfg && (
                <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-md ${scheduleCfg.color.replace('bg-', 'bg-').replace('text-', 'text-')} font-extrabold border`}>
                  <ShieldAlert className="h-3 w-3" /> {scheduleCfg.label}
                </span>
              )}
              {medicine?.requiresPrescription && (
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-500/30 border border-amber-300/40 font-bold">
                  Rx Only
                </span>
              )}
              {medicine?.requiresColdChain && (
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-500/30 border border-blue-300/40 font-bold">
                  <Snowflake className="h-3 w-3" /> Cold Chain
                </span>
              )}
              {medicine?.isNarcotic && (
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-red-500/30 border border-red-300/40 font-bold">
                  <ShieldAlert className="h-3 w-3" /> Narcotic
                </span>
              )}
              {medicine?.isGeneric && (
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-500/30 border border-emerald-300/40 font-bold">
                  Generic
                </span>
              )}
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-5">
              <HeroStat icon={Package} label="Stock" value={product.stock ?? 0} sub={product.unit} tone="teal" />
              <HeroStat icon={Beaker} label="Salts" value={stats.saltCount} tone="cyan" />
              <HeroStat icon={Repeat} label="Substitutes" value={stats.substituteCount} tone="violet" />
              <HeroStat icon={TrendingUp} label="Revenue" value={formatPKR(stats.totalRevenue)} sub={`${stats.totalOrders} orders`} tone="emerald" />
            </div>

            <div className="mt-5 flex items-center gap-4 flex-wrap">
              <div>
                <div className="text-[10px] uppercase font-extrabold text-white/70 tracking-wider">Sale price</div>
                <div className="text-3xl font-extrabold tabular-nums leading-none mt-1">
                  {formatPKRFull(product.price)}
                  <span className="text-sm font-bold text-white/70 ml-1">/ {product.unit}</span>
                </div>
              </div>
              {product.costPrice > 0 && (
                <div>
                  <div className="text-[10px] uppercase font-extrabold text-white/70 tracking-wider">Cost</div>
                  <div className="text-xl font-extrabold tabular-nums text-white/80 leading-none mt-1">
                    {formatPKRFull(product.costPrice)}
                  </div>
                </div>
              )}
              {product.wholesalePrice && (
                <div>
                  <div className="text-[10px] uppercase font-extrabold text-white/70 tracking-wider">Wholesale</div>
                  <div className="text-xl font-extrabold tabular-nums text-amber-300 leading-none mt-1">
                    {formatPKRFull(product.wholesalePrice)}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>

      {/* EXPIRY ALERT */}
      {(stats.expiringSoon > 0 || stats.expired > 0) && (
        <section className="rounded-3xl bg-gradient-to-r from-amber-50 to-rose-50 border-2 border-amber-300 p-5 flex items-center gap-4 flex-wrap">
          <AlertTriangle className="h-8 w-8 text-amber-600 shrink-0" />
          <div className="flex-1">
            <h3 className="font-extrabold text-slate-900 text-lg">⚠️ Expiry Alert</h3>
            <div className="mt-1 flex flex-wrap gap-3 text-sm">
              {stats.expiringSoon > 0 && (
                <span className="font-extrabold text-amber-700">
                  {stats.expiringSoon} batch(es) expiring within 90 days
                </span>
              )}
              {stats.expired > 0 && (
                <span className="font-extrabold text-rose-700">
                  {stats.expired} batch(es) already expired
                </span>
              )}
            </div>
          </div>
        </section>
      )}

      {/* QUICK ACTIONS */}
      <section className="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <Link to="/pharmacy/prescriptions/new" className="rounded-2xl bg-white border-2 border-slate-200 hover:border-teal-400 hover:shadow-md p-4 flex items-center gap-3 transition group">
          <div className="h-11 w-11 rounded-xl bg-violet-100 group-hover:bg-violet-600 group-hover:text-white text-violet-700 flex items-center justify-center transition">
            <FileText className="h-5 w-5" />
          </div>
          <div className="flex-1 min-w-0">
            <div className="font-extrabold text-slate-900 text-sm">New Prescription</div>
            <div className="text-[10px] text-slate-500 font-semibold">Rx dispense</div>
          </div>
          <ChevronRight className="h-4 w-4 text-slate-400" />
        </Link>
        <Link to="/pharmacy/expiring" className="rounded-2xl bg-white border-2 border-slate-200 hover:border-amber-400 hover:shadow-md p-4 flex items-center gap-3 transition group">
          <div className="h-11 w-11 rounded-xl bg-amber-100 group-hover:bg-amber-600 group-hover:text-white text-amber-700 flex items-center justify-center transition">
            <Calendar className="h-5 w-5" />
          </div>
          <div className="flex-1 min-w-0">
            <div className="font-extrabold text-slate-900 text-sm">Expiring Report</div>
            <div className="text-[10px] text-slate-500 font-semibold">All expiring meds</div>
          </div>
          <ChevronRight className="h-4 w-4 text-slate-400" />
        </Link>
        <Link to="/pharmacy/temperature" className="rounded-2xl bg-white border-2 border-slate-200 hover:border-blue-400 hover:shadow-md p-4 flex items-center gap-3 transition group">
          <div className="h-11 w-11 rounded-xl bg-blue-100 group-hover:bg-blue-600 group-hover:text-white text-blue-700 flex items-center justify-center transition">
            <Thermometer className="h-5 w-5" />
          </div>
          <div className="flex-1 min-w-0">
            <div className="font-extrabold text-slate-900 text-sm">Temperature Log</div>
            <div className="text-[10px] text-slate-500 font-semibold">Cold chain</div>
          </div>
          <ChevronRight className="h-4 w-4 text-slate-400" />
        </Link>
        <Link to="/pos" className="rounded-2xl bg-white border-2 border-slate-200 hover:border-emerald-400 hover:shadow-md p-4 flex items-center gap-3 transition group">
          <div className="h-11 w-11 rounded-xl bg-emerald-100 group-hover:bg-emerald-600 group-hover:text-white text-emerald-700 flex items-center justify-center transition">
            <ShoppingCart className="h-5 w-5" />
          </div>
          <div className="flex-1 min-w-0">
            <div className="font-extrabold text-slate-900 text-sm">Go to POS</div>
            <div className="text-[10px] text-slate-500 font-semibold">Sell this medicine</div>
          </div>
          <ChevronRight className="h-4 w-4 text-slate-400" />
        </Link>
      </section>

      {/* SALTS */}
      {productSalts.length > 0 && (
        <section className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm p-5">
          <div className="flex items-center gap-3 mb-3">
            <div className="h-10 w-10 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-700 text-white flex items-center justify-center shadow-md">
              <Beaker className="h-5 w-5" />
            </div>
            <div>
              <h3 className="font-extrabold text-slate-900 text-lg leading-tight">Active Salts</h3>
              <p className="text-xs text-slate-500 font-semibold">{productSalts.length} composition{productSalts.length !== 1 ? 's' : ''}</p>
            </div>
          </div>
          <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {productSalts.map((ps: any) => (
              <div key={ps.id} className={[
                'rounded-2xl border-2 p-3',
                ps.isMainSalt ? 'border-emerald-300 bg-emerald-50/50' : 'border-slate-200 bg-slate-50/30',
              ].join(' ')}>
                <div className="flex items-center gap-2 mb-1">
                  {ps.isMainSalt && <Star className="h-3.5 w-3.5 text-emerald-600 fill-emerald-600" />}
                  <div className="font-extrabold text-slate-900">{ps.salt?.name}</div>
                  {ps.isMainSalt && (
                    <span className="px-1.5 py-0.5 rounded bg-emerald-500 text-white text-[9px] font-extrabold">MAIN</span>
                  )}
                </div>
                <div className="text-sm font-bold text-cyan-700">{ps.strength}</div>
                {ps.salt?.category && (
                  <div className="text-[10px] text-slate-500 font-semibold mt-1">{ps.salt.category}</div>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      {/* MEDICINE DETAILS */}
      {medicine && (
        <section className="grid sm:grid-cols-2 gap-4">
          <div className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm p-5">
            <h3 className="font-extrabold text-slate-900 text-base mb-3">📦 Product Details</h3>
            <dl className="space-y-2 text-sm">
              {medicine.dosageForm && <Row label="Dosage Form" value={medicine.dosageForm} />}
              {medicine.packSize && <Row label="Pack Size" value={`${medicine.packSize} ${medicine.packUnit ?? ''}`} />}
              {medicine.countryOfOrigin && <Row label="Country" value={medicine.countryOfOrigin} />}
              {medicine.importedBy && <Row label="Imported By" value={medicine.importedBy} />}
              {medicine.color && <Row label="Color" value={medicine.color} />}
              {medicine.shape && <Row label="Shape" value={medicine.shape} />}
              {medicine.markings && <Row label="Markings" value={medicine.markings} />}
              {medicine.brandTier && <Row label="Tier" value={medicine.brandTier} />}
            </dl>
          </div>
          <div className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm p-5">
            <h3 className="font-extrabold text-slate-900 text-base mb-3">🌡️ Storage & Clinical</h3>
            <dl className="space-y-2 text-sm">
              <Row label="Storage Condition" value={medicine.storageCondition?.replace(/_/g, ' ')} />
              {medicine.requiresColdChain && (
                <Row label="Cold Chain Range" value={`${medicine.minTemperature}°C – ${medicine.maxTemperature}°C`} />
              )}
              {medicine.storageInstructions && <Row label="Instructions" value={medicine.storageInstructions} />}
              {medicine.mechanismOfAction && <Row label="MoA" value={medicine.mechanismOfAction} />}
              {medicine.pharmacokinetics && <Row label="Pharmacokinetics" value={medicine.pharmacokinetics} />}
            </dl>
          </div>
        </section>
      )}

      {/* BATCHES */}
      {batches.length > 0 && (
        <section className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm overflow-hidden">
          <div className="px-5 py-4 border-b-2 border-slate-100 bg-amber-50/50 flex items-center gap-3">
            <div className="h-10 w-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-700 text-white flex items-center justify-center shadow-md">
              <Package className="h-5 w-5" />
            </div>
            <div>
              <h3 className="font-extrabold text-slate-900 text-lg leading-tight">Batches</h3>
              <p className="text-xs text-slate-500 font-semibold">
                {batches.length} batches • Total: {stats.batchStock} {product.unit}
              </p>
            </div>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead className="bg-slate-50 border-b border-slate-100">
                <tr>
                  <th className="px-3 py-2 text-left text-[10px] font-extrabold uppercase tracking-wider text-slate-700">Batch #</th>
                  <th className="px-3 py-2 text-left text-[10px] font-extrabold uppercase tracking-wider text-slate-700">Mfg</th>
                  <th className="px-3 py-2 text-left text-[10px] font-extrabold uppercase tracking-wider text-slate-700">Expiry</th>
                  <th className="px-3 py-2 text-right text-[10px] font-extrabold uppercase tracking-wider text-slate-700">Qty</th>
                  <th className="px-3 py-2 text-right text-[10px] font-extrabold uppercase tracking-wider text-slate-700">Cost</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100">
                {batches.map((b: any) => {
                  const now = Date.now();
                  const isExpired = b.expiryDate && new Date(b.expiryDate).getTime() < now;
                  const days = b.expiryDate ? (new Date(b.expiryDate).getTime() - now) / (1000 * 60 * 60 * 24) : Infinity;
                  const isExpiringSoon = !isExpired && days <= 90;
                  return (
                    <tr key={b.id} className={[
                      'hover:bg-slate-50/50',
                      isExpired ? 'bg-rose-50' : isExpiringSoon ? 'bg-amber-50' : '',
                    ].join(' ')}>
                      <td className="px-3 py-2 font-mono font-extrabold text-slate-900 text-xs">{b.batchNumber}</td>
                      <td className="px-3 py-2 text-xs font-semibold">
                        {b.manufactureDate ? new Date(b.manufactureDate).toLocaleDateString('en-PK') : '—'}
                      </td>
                      <td className="px-3 py-2 text-xs">
                        {b.expiryDate ? (
                          <span className={['font-extrabold', isExpired ? 'text-rose-700' : isExpiringSoon ? 'text-amber-700' : 'text-slate-700'].join(' ')}>
                            {new Date(b.expiryDate).toLocaleDateString('en-PK')}
                            {(isExpired || isExpiringSoon) && <AlertTriangle className="inline h-3 w-3 ml-1" />}
                          </span>
                        ) : '—'}
                      </td>
                      <td className="px-3 py-2 text-right font-extrabold tabular-nums">{b.quantity}</td>
                      <td className="px-3 py-2 text-right text-xs font-bold text-slate-700">{formatPKR(b.costPrice)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {/* SUBSTITUTES */}
      {substitutes.length > 0 && (
        <section className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm p-5">
          <div className="flex items-center gap-3 mb-3">
            <div className="h-10 w-10 rounded-xl bg-gradient-to-br from-violet-500 to-purple-700 text-white flex items-center justify-center shadow-md">
              <Repeat className="h-5 w-5" />
            </div>
            <div>
              <h3 className="font-extrabold text-slate-900 text-lg leading-tight">Substitute Medicines</h3>
              <p className="text-xs text-slate-500 font-semibold">{substitutes.length} alternatives</p>
            </div>
          </div>
          <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {substitutes.map((sub: any) => (
              <div key={sub.id} className="rounded-2xl border-2 border-slate-200 bg-white p-3 flex items-center gap-3">
                <Repeat className="h-5 w-5 text-violet-600 shrink-0" />
                <div className="flex-1 min-w-0">
                  <div className="font-extrabold text-sm text-slate-900 truncate">
                    {sub.substitute?.product?.name || sub.main?.product?.name}
                  </div>
                  {sub.similarity && (
                    <div className="text-[10px] text-emerald-700 font-bold">{sub.similarity}% match</div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* SALES HISTORY */}
      <section className="rounded-3xl bg-white border-2 border-slate-200 shadow-sm overflow-hidden">
        <div className="px-5 py-4 border-b-2 border-slate-100 flex items-center gap-3">
          <div className="h-10 w-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex items-center justify-center shadow-md">
            <Receipt className="h-5 w-5" />
          </div>
          <div>
            <h3 className="font-extrabold text-slate-900 text-lg leading-tight">Sales History</h3>
            <p className="text-xs text-slate-500 font-semibold">
              {salesForProduct.length} recent • {stats.totalSold} units sold
            </p>
          </div>
        </div>

        {salesForProduct.length === 0 ? (
          <div className="p-10 text-center">
            <Receipt className="h-12 w-12 text-slate-300 mx-auto mb-2" />
            <div className="font-extrabold text-slate-700">Abhi tak koi sale nahi</div>
          </div>
        ) : (
          <div className="divide-y divide-slate-100">
            {salesForProduct.map((s) => {
              const productLines = s.items.filter((it) => it.productId === id);
              const qty = productLines.reduce((a, it) => a + Number(it.quantity || 0), 0);
              const revenue = productLines.reduce((a, it) => a + Number(it.total || 0), 0);
              return (
                <Link
                  key={s.id}
                  to={`/sales/${s.id}/receipt`}
                  className="block px-5 py-3 hover:bg-slate-50/50 transition"
                >
                  <div className="flex items-center justify-between gap-3">
                    <div className="min-w-0 flex-1">
                      <div className="flex items-center gap-2">
                        <div className="font-mono font-extrabold text-sm text-slate-900">{s.saleNumber}</div>
                        <span className="text-[10px] text-slate-500 font-bold">
                          {new Date(s.soldAt).toLocaleDateString('en-PK', { day: '2-digit', month: 'short', year: 'numeric' })}
                        </span>
                      </div>
                      <div className="text-xs text-slate-600 font-semibold mt-0.5">
                        {s.customer?.name || 'Walk-in'} • {qty} {product.unit}
                      </div>
                    </div>
                    <div className="text-right shrink-0">
                      <div className="font-extrabold text-emerald-700 tabular-nums">{formatPKRFull(revenue)}</div>
                    </div>
                  </div>
                </Link>
              );
            })}
          </div>
        )}
      </section>
    </div>
  );
}

function HeroStat({ icon: Icon, label, value, sub, tone }: any) {
  const tones: Record<string, string> = {
    emerald: 'from-emerald-400/30 to-emerald-600/20 border-emerald-300/40',
    teal: 'from-teal-400/30 to-teal-600/20 border-teal-300/40',
    cyan: 'from-cyan-400/30 to-cyan-600/20 border-cyan-300/40',
    violet: 'from-violet-400/30 to-violet-600/20 border-violet-300/40',
  };
  return (
    <div className={`rounded-xl bg-gradient-to-br ${tones[tone]} backdrop-blur border p-3`}>
      <div className="flex items-center gap-1.5 mb-1">
        <Icon className="h-3 w-3 opacity-80" />
        <div className="text-[9px] uppercase tracking-wider font-extrabold opacity-90">{label}</div>
      </div>
      <div className="text-xl font-extrabold text-white tabular-nums leading-none">{value}</div>
      {sub && <div className="text-[10px] font-bold text-white/70 mt-0.5">{sub}</div>}
    </div>
  );
}

function Row({ label, value }: { label: string; value: string }) {
  return (
    <div className="flex items-center justify-between gap-2 py-1 border-b border-slate-100 last:border-0">
      <dt className="text-xs font-semibold text-slate-500">{label}</dt>
      <dd className="text-xs font-extrabold text-slate-900 text-right">{value}</dd>
    </div>
  );
}
