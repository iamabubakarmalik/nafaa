import { useState, useMemo } from 'react';
import { useQuery } from '@tanstack/react-query';
import {
  BarChart3, Wrench, Users, Briefcase, Shield, TrendingUp, Target,
  Award, DollarSign, Crown, Activity, Star,
} from 'lucide-react';
import {
  ResponsiveContainer, BarChart, Bar, PieChart, Pie, Cell, XAxis, YAxis,
  Tooltip, CartesianGrid, Legend, ComposedChart, Line, Area,
} from 'recharts';
import { formatPKR } from '@/lib/format';
import { useReportsData } from '@/features/reports/hooks/useReportsData';
import {
  ReportsHero, TabSwitcher, KpiCard, ChartCard, EmptyChart,
  PnLLine, MiniStat, dayLabel, PIE_COLORS,
} from '@/features/reports/components/ReportsShared';
import { jobsApi } from '../api/jobs.api';
import { techniciansApi } from '../api/technicians.api';

const TABS = [
  { id: 'overview', label: 'Overview', icon: BarChart3 },
  { id: 'services', label: 'Top Services', icon: Wrench },
  { id: 'jobs', label: 'Jobs', icon: Briefcase },
  { id: 'technicians', label: 'Technicians', icon: Users },
];

export default function ServicesBizReportsV2() {
  const [days, setDays] = useState(14);
  const [tab, setTab] = useState('overview');
  const reports = useReportsData(days);

  const { data: allJobs = [] } = useQuery({
    queryKey: ['jobs-for-reports'], queryFn: () => jobsApi.list({}),
  });
  const { data: technicians = [] } = useQuery({
    queryKey: ['technicians-for-reports'], queryFn: () => techniciansApi.list({}),
  });

  const trendData = reports.trend.map((p) => ({ ...p, label: dayLabel(p.date) }));

  const totalRevenue = reports.trend.reduce((s, p) => s + p.sales, 0);
  const totalProfit = reports.trend.reduce((s, p) => s + p.profit, 0);
  const totalOrders = reports.trend.reduce((s, p) => s + p.orders, 0);
  const aov = totalOrders > 0 ? totalRevenue / totalOrders : 0;

  const jobStats = useMemo(() => {
    const total = allJobs.length;
    const completed = allJobs.filter((j: any) => j.status === 'COMPLETED').length;
    const emergency = allJobs.filter((j: any) => ['EMERGENCY', 'URGENT'].includes(j.priority)).length;
    const revenue = allJobs.filter((j: any) => j.status === 'COMPLETED').reduce((s: number, j: any) => s + Number(j.totalCharge || 0), 0);
    return { total, completed, emergency, revenue };
  }, [allJobs]);

  const jobsByPriority = useMemo(() => {
    const g: Record<string, number> = {};
    allJobs.forEach((j: any) => { g[j.priority] = (g[j.priority] || 0) + 1; });
    return Object.entries(g).map(([priority, count]) => ({ priority, count }));
  }, [allJobs]);

  const jobsByStatus = useMemo(() => {
    const g: Record<string, number> = {};
    allJobs.forEach((j: any) => { g[j.status] = (g[j.status] || 0) + 1; });
    return Object.entries(g)
      .map(([status, count]) => ({ status: status.replace(/_/g, ' '), count }))
      .sort((a, b) => b.count - a.count)
      .slice(0, 10);
  }, [allJobs]);

  return (
    <div className="space-y-6">
      <ReportsHero
        gradient="from-slate-950 via-cyan-900 to-blue-700"
        emoji="🛠️"
        industryLabel="Services"
        title="Services Business Reports"
        subtitle="Jobs, technicians, service performance, AMC analytics"
        days={days}
        setDays={setDays}
      />

      <TabSwitcher tabs={TABS} active={tab} onChange={setTab} color="cyan" />

      {tab === 'overview' && (
        <>
          <section className="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <KpiCard label="Total Revenue" value={formatPKR(totalRevenue)} icon={TrendingUp} color="cyan" isHighlight />
            <KpiCard label="Total Profit" value={formatPKR(totalProfit)} icon={Target} color="emerald" />
            <KpiCard label="Total Jobs" value={String(totalOrders)} icon={Briefcase} color="violet" />
            <KpiCard label="Avg Job Value" value={formatPKR(aov)} icon={DollarSign} color="amber" />
          </section>

          {reports.profitLoss && (
            <section className="rounded-3xl bg-white border border-slate-200 shadow-sm p-6">
              <div className="flex items-center justify-between mb-5 flex-wrap gap-2">
                <div>
                  <h3 className="text-xl font-bold text-slate-900">Services P&L</h3>
                  <p className="text-sm text-slate-500">{days} days breakdown</p>
                </div>
                <div className={`px-3 py-1.5 rounded-xl text-sm font-extrabold ${reports.profitLoss.netProfit >= 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}`}>
                  Net Margin: {reports.profitLoss.netMargin.toFixed(1)}%
                </div>
              </div>
              <div className="grid lg:grid-cols-2 gap-6">
                <div className="space-y-2">
                  <PnLLine label="Revenue" value={reports.profitLoss.revenue} type="positive" />
                  {reports.profitLoss.discount > 0 && <PnLLine label="Discounts" value={-reports.profitLoss.discount} type="negative" />}
                  <PnLLine label="Net Revenue" value={reports.profitLoss.netRevenue} type="bold" />
                  <PnLLine label="Parts / COGS" value={-reports.profitLoss.cogs} type="negative" />
                  <PnLLine label="Gross Profit" value={reports.profitLoss.grossProfit} type="bold" sub={`${reports.profitLoss.grossMargin.toFixed(1)}% margin`} />
                  <PnLLine label="Expenses" value={-reports.profitLoss.expenses} type="negative" />
                  <PnLLine label="Net Profit" value={reports.profitLoss.netProfit} type="highlight" sub={`${reports.profitLoss.netMargin.toFixed(1)}% margin`} />
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <MiniStat label="Total Jobs" value={jobStats.total} color="cyan" icon={Briefcase} />
                  <MiniStat label="Completed" value={jobStats.completed} color="emerald" icon={Award} />
                  <MiniStat label="Emergency" value={jobStats.emergency} color="red" icon={Activity} />
                  <MiniStat label="Technicians" value={technicians.length} color="violet" icon={Users} />
                  <MiniStat label="Job Revenue" value={formatPKR(jobStats.revenue)} color="green" icon={DollarSign} />
                  <MiniStat label="Avg Rating" value={reports.profitLoss.avgRating ? reports.profitLoss.avgRating.toFixed(1) + ' ⭐' : '—'} color="amber" icon={Star} />
                </div>
              </div>
            </section>
          )}

          <ChartCard title="Service Revenue Trend" subtitle={`${days}-day analysis`} icon={TrendingUp} color="cyan">
            <ResponsiveContainer width="100%" height="100%">
              <ComposedChart data={trendData}>
                <defs>
                  <linearGradient id="svcGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stopColor="#0891b2" stopOpacity={0.5} />
                    <stop offset="100%" stopColor="#0891b2" stopOpacity={0} />
                  </linearGradient>
                </defs>
                <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
                <XAxis dataKey="label" stroke="#64748b" fontSize={11} />
                <YAxis yAxisId="left" stroke="#64748b" fontSize={11} tickFormatter={(v) => `${(v / 1000).toFixed(0)}k`} />
                <YAxis yAxisId="right" orientation="right" stroke="#64748b" fontSize={11} />
                <Tooltip formatter={(value: any, name: any) => name === 'Orders' ? value : formatPKR(Number(value))} contentStyle={{ borderRadius: 12 }} />
                <Legend wrapperStyle={{ fontSize: 12 }} />
                <Area yAxisId="left" type="monotone" dataKey="sales" name="Revenue" fill="url(#svcGrad)" stroke="#0891b2" strokeWidth={2.5} />
                <Bar yAxisId="left" dataKey="profit" name="Profit" fill="#10b981" radius={[4, 4, 0, 0]} barSize={20} />
                <Line yAxisId="right" type="monotone" dataKey="orders" name="Orders" stroke="#f59e0b" strokeWidth={2.5} dot={{ r: 4 }} />
              </ComposedChart>
            </ResponsiveContainer>
          </ChartCard>
        </>
      )}

      {tab === 'services' && (
        <section className="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
          <div className="px-6 py-5 border-b border-slate-100">
            <h3 className="text-xl font-bold text-slate-900">Top Services</h3>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead className="bg-slate-50">
                <tr>
                  <th className="text-center px-3 py-3 font-bold text-[10px] uppercase w-12">#</th>
                  <th className="text-left px-3 py-3 font-bold text-[10px] uppercase">Service</th>
                  <th className="text-right px-3 py-3 font-bold text-[10px] uppercase">Sold</th>
                  <th className="text-right px-3 py-3 font-bold text-[10px] uppercase">Orders</th>
                  <th className="text-right px-3 py-3 font-bold text-[10px] uppercase">Revenue</th>
                  <th className="text-right px-3 py-3 font-bold text-[10px] uppercase">Profit</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100">
                {reports.topProducts.map((p, idx) => (
                  <tr key={p.productId} className="hover:bg-slate-50">
                    <td className="px-3 py-3 text-center">
                      <span className={`inline-flex h-7 w-7 rounded-lg items-center justify-center font-extrabold text-xs ${idx === 0 ? 'bg-amber-100 text-amber-700' : idx === 1 ? 'bg-slate-200 text-slate-700' : 'bg-slate-100 text-slate-500'}`}>
                        {idx < 3 ? <Crown className="h-3.5 w-3.5" /> : idx + 1}
                      </span>
                    </td>
                    <td className="px-3 py-3">
                      <div className="flex items-center gap-3">
                        <div className="h-10 w-10 rounded-lg bg-cyan-100 flex items-center justify-center">
                          <Wrench className="h-4 w-4 text-cyan-600" />
                        </div>
                        <div className="font-bold">🛠️ {p.product?.name}</div>
                      </div>
                    </td>
                    <td className="px-3 py-3 text-right font-bold">{p.quantitySold}</td>
                    <td className="px-3 py-3 text-right">{p.orderCount}</td>
                    <td className="px-3 py-3 text-right font-extrabold text-emerald-700 tabular-nums">{formatPKR(p.revenue)}</td>
                    <td className="px-3 py-3 text-right font-extrabold text-violet-700 tabular-nums">{formatPKR(p.profit)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {tab === 'jobs' && (
        <>
          <section className="grid sm:grid-cols-4 gap-4">
            <KpiCard label="Total Jobs" value={jobStats.total} icon={Briefcase} color="cyan" isHighlight />
            <KpiCard label="Completed" value={jobStats.completed} icon={Award} color="emerald" />
            <KpiCard label="Emergency" value={jobStats.emergency} icon={Activity} color="red" />
            <KpiCard label="Revenue" value={formatPKR(jobStats.revenue)} icon={DollarSign} color="violet" />
          </section>

          <section className="grid lg:grid-cols-2 gap-6">
            <ChartCard title="Jobs by Priority" subtitle="Distribution" icon={Activity} color="red">
              {jobsByPriority.length > 0 ? (
                <ResponsiveContainer width="100%" height="100%">
                  <PieChart>
                    <Pie data={jobsByPriority} dataKey="count" nameKey="priority" cx="50%" cy="50%" outerRadius={100} innerRadius={50} paddingAngle={2} label={(entry: any) => entry.count}>
                      {jobsByPriority.map((_: any, idx: number) => <Cell key={idx} fill={PIE_COLORS[idx % PIE_COLORS.length]} />)}
                    </Pie>
                    <Tooltip contentStyle={{ borderRadius: 12 }} />
                    <Legend wrapperStyle={{ fontSize: 11 }} iconType="circle" />
                  </PieChart>
                </ResponsiveContainer>
              ) : <EmptyChart message="No job data" />}
            </ChartCard>

            <ChartCard title="Jobs by Status" subtitle="Current pipeline" icon={Briefcase} color="cyan">
              {jobsByStatus.length > 0 ? (
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={jobsByStatus} layout="vertical">
                    <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
                    <XAxis type="number" stroke="#64748b" fontSize={11} />
                    <YAxis dataKey="status" type="category" stroke="#64748b" fontSize={10} width={100} />
                    <Tooltip contentStyle={{ borderRadius: 12 }} />
                    <Bar dataKey="count" fill="#0891b2" radius={[0, 8, 8, 0]} />
                  </BarChart>
                </ResponsiveContainer>
              ) : <EmptyChart message="No status data" />}
            </ChartCard>
          </section>
        </>
      )}

      {tab === 'technicians' && (
        <section className="rounded-3xl bg-white border border-slate-200 shadow-sm overflow-hidden">
          <div className="px-6 py-5 border-b border-slate-100">
            <h3 className="text-xl font-bold text-slate-900">Technician Performance</h3>
          </div>
          <table className="w-full text-sm">
            <thead className="bg-slate-50">
              <tr>
                <th className="text-center px-6 py-3 font-bold text-xs uppercase w-16">Rank</th>
                <th className="text-left px-6 py-3 font-bold text-xs uppercase">Technician</th>
                <th className="text-center px-6 py-3 font-bold text-xs uppercase">Level</th>
                <th className="text-right px-6 py-3 font-bold text-xs uppercase">Jobs</th>
                <th className="text-right px-6 py-3 font-bold text-xs uppercase">Revenue</th>
                <th className="text-right px-6 py-3 font-bold text-xs uppercase">Rating</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100">
              {technicians.sort((a, b) => (b.totalRevenue || 0) - (a.totalRevenue || 0)).slice(0, 20).map((t, idx) => {
                const name = t.staff ? ((t.staff.firstName || '') + ' ' + (t.staff.lastName || '')).trim() : 'Technician';
                return (
                  <tr key={t.id} className="hover:bg-slate-50">
                    <td className="px-6 py-3 text-center">
                      <span className={`inline-flex h-8 w-8 rounded-lg items-center justify-center font-extrabold text-xs ${idx === 0 ? 'bg-amber-500 text-white' : idx === 1 ? 'bg-slate-400 text-white' : idx === 2 ? 'bg-orange-600 text-white' : 'bg-slate-100 text-slate-500'}`}>
                        {idx < 3 ? <Crown className="h-4 w-4" /> : idx + 1}
                      </span>
                    </td>
                    <td className="px-6 py-3">
                      <div className="flex items-center gap-3">
                        <div className="h-9 w-9 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold">{name.charAt(0)}</div>
                        <div>
                          <div className="font-bold">{name}</div>
                          <div className="text-xs text-slate-500">{t.primarySkill || 'General'}</div>
                        </div>
                      </div>
                    </td>
                    <td className="px-6 py-3 text-center">
                      <span className="px-2 py-0.5 rounded-full bg-violet-100 text-violet-700 text-[10px] font-extrabold uppercase">{t.level}</span>
                    </td>
                    <td className="px-6 py-3 text-right font-bold">{t.totalJobs || 0}</td>
                    <td className="px-6 py-3 text-right font-extrabold text-emerald-700 tabular-nums">{formatPKR(t.totalRevenue || 0)}</td>
                    <td className="px-6 py-3 text-right">
                      {t.avgRating ? (
                        <span className="inline-flex items-center gap-1 font-extrabold text-amber-700">
                          <Star className="h-3 w-3 fill-current" />{t.avgRating.toFixed(1)}
                        </span>
                      ) : <span className="text-slate-400">—</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>
      )}
    </div>
  );
}
